ArchiveEntry "Asymptotic via Box with Domain Constraint"

ProgramVariables
  Real d;
  Real w;
  Real t;
  Real v0;
End.

/* 
 * V = 3/2*d^2 + d*w + w^2 (strict Lyapunov function)
 * V' = -(d^2+w^2)
 * V >= lambda_min*(d^2+w^2) where lambda_min = (5-sqrt(5))/4 > 1/2
 * So d^2+w^2 >= V/lambda_max <= 2*V
 * Actually more precisely: d^2+w^2 >= V/lambda_max
 * lambda_max = (5+sqrt(5))/4 < 2
 * So d^2+w^2 >= V/2
 * Thus V' = -(d^2+w^2) <= -V/2
 *
 * In domain {V >= eps}: V' <= -V/2 <= -eps/2
 * So V decreases by at least eps/2 per unit time.
 * After time T = 2*v0/eps, V has decreased by at least v0 -> V <= 0.
 * Since V >= 0, this means V must have exited {V >= eps} before T.
 *
 * Express as box: the ODE with domain {V >= eps} can run for
 * at most T = 2*v0/eps time units.
 *
 * Proof: V <= v0 - eps/2 * t is invariant in domain {V >= eps}.
 * When t = 2*v0/eps: V <= v0 - v0 = 0, contradicting V >= eps.
 * So the ODE must exit the domain before t = 2*v0/eps.
 */

Problem
  v0 > 0 & v0 < 1 & t = 0 & 
  v0 = 3*d^2/2 + d*w + w^2
  ->
  [{d' = w, w' = -d - w, t' = 1, v0' = 0
    & 3*d^2/2 + d*w + w^2 >= 1/100}]
  t < 200*v0
End.

Tactic "Proof"
  implyR(1);
  /* In domain V >= 1/100:
     V' = -(d^2+w^2) <= -V/2 <= -1/200
     So V <= v0 - t/200
     V >= 1/100 requires v0 - t/200 >= 1/100
     i.e., t <= 200*(v0 - 1/100) < 200*v0 */
  dC("3*d^2/2 + d*w + w^2 <= v0 - t/200", 1);
  <(
    dW(1); QE,
    dI(1)
  )
End.

End.
