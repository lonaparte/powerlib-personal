"  ==>  (((((s)^((2)))+((c)^((2)))) = ((1)))&(((c) = (-((1))))&(((((w1)^((2)))+((w2)^((2))))+((((2))*((1)))*(((1))-(c)))) > (((4))*((1))))))->((((w1)^((2)))+((w2)^((2)))) > ((0)))
