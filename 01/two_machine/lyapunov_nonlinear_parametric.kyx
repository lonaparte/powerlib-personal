ArchiveEntry "Lyapunov H-Stability Nonlinear Two Machine (parametric in D1, D2, K)"

/*
 * Parametric companion to lyapunov_nonlinear.kyx (which fixed D1=D2=K=1).
 * Full epsilon-delta Lyapunov stability of the equilibrium for the nonlinear
 * two-machine pH system, for ALL D1>0, D2>0, K>0, using the Hamiltonian
 * H = w1^2 + w2^2 + 2K(1-c) as the metric.
 *
 * The delta witness is delta = eps, INDEPENDENT of the parameters: since
 * dH/dt = -2*D1*w1^2 - 2*D2*w2^2 <= 0, H is non-increasing, so H(0) < eps
 * implies H(t) < eps for all t. This is why H-stability parametrizes cleanly
 * whereas the component-wise form (lyapunov_complete) has a K-dependent delta.
 * Cross-validated (sympy): H' + 2*D1*w1^2 + 2*D2*w2^2 = 0 exactly.
 */

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

Problem
  \forall D1 \forall D2 \forall K (
    D1 > 0 & D2 > 0 & K > 0 ->
    \forall eps (eps > 0 ->
      \exists delta (delta > 0 &
        \forall d1 \forall d2 \forall w1 \forall w2 \forall s \forall c (
          s^2 + c^2 = 1 &
          w1^2 + w2^2 + 2*K*(1 - c) < delta
          ->
          [{d1' = w1,
            d2' = w2,
            w1' = -D1*w1 - K*s,
            w2' = -D2*w2 + K*s,
            s'  = c*(w1 - w2),
            c'  = -s*(w1 - w2)}]
          w1^2 + w2^2 + 2*K*(1 - c) < eps
        )
      )
    )
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1);
  implyR(1);
  allR(1);
  implyR(1);
  existsR("eps", 1);
  andR(1);
  <(
    id,
    allR(1); allR(1); allR(1); allR(1); allR(1); allR(1);
    implyR(1);
    dI(1)
  )
End.

End.
