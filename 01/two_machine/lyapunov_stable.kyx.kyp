Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "pH Lyapunov Stability Full"

/* 
 * Full Lyapunov stability statement:
 * For all eps > 0, there exists delta > 0 such that
 * if H(x0) < delta, then H(x(t)) < eps for all t >= 0.
 *
 * Since H is a Lyapunov function with dH/dt <= 0,
 * we can simply take delta = eps.
 *
 * This is the strongest property dI can give without LaSalle.
 */

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

Problem
  \forall J1 \forall J2 \forall D1 \forall D2 \forall K \forall eps (
    J1 > 0 & J2 > 0 & D1 > 0 & D2 > 0 & K > 0 & eps > 0 &
    s^2 + c^2 = 1 &
    J1*w1^2 + J2*w2^2 + 2*K*(1 - c) < eps
    ->
    [{d1' = w1,
      d2' = w2,
      w1' = -D1/J1*w1 - K/J1*s,
      w2' = -D2/J2*w2 + K/J2*s,
      s'  = c*(w1 - w2),
      c'  = -s*(w1 - w2)}]
    J1*w1^2 + J2*w2^2 + 2*K*(1 - c) < eps
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1); allR(1); allR(1); allR(1);
  implyR(1);
  dI(1)
End.

End. """"
  tactic """" (allR(1);allR(1);allR(1);allR(1);allR(1);allR(1);implyR(1);dI(1)) """"
  proof """"  """"
End.
