ArchiveEntry "Complete Lyapunov Stability Nonlinear pH (parametric in D1, D2, K)"

/*
 * Parametric companion to lyapunov_complete.kyx (which fixed K=D1=D2=1).
 * Full epsilon-delta, COMPONENT-WISE Lyapunov stability of the equilibrium for
 * the nonlinear two-machine pH system, for ALL D1>0, D2>0, K>0.
 *
 * Unlike the H-metric form (lyapunov_nonlinear_parametric, witness delta=eps),
 * the component form needs a K-DEPENDENT witness:
 *     delta = eps / (2K + 2).
 * From the box {w1^2<delta, w2^2<delta, 1-c<delta} the energy is
 *     H = w1^2 + w2^2 + 2K(1-c) < delta + delta + 2K*delta = (2K+2)*delta = eps,
 * and H is invariant (dH/dt = -2 D1 w1^2 - 2 D2 w2^2 <= 0), so each nonnegative
 * energy component stays below eps. Witness arithmetic checked exactly (sympy).
 *
 * Conclusion uses the parameter-correct ENERGY component 2K(1-c) < eps (the
 * original "1-c < eps" is only valid for K >= 1/2; see component_stability_parametric).
 */

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

Problem
  \forall D1 \forall D2 \forall K (
    D1 > 0 & D2 > 0 & K > 0 ->
    \forall eps (eps > 0 ->
      \exists delta (delta > 0 &
        \forall d1 \forall d2 \forall w1 \forall w2 \forall s \forall c (
          s^2 + c^2 = 1 &
          w1^2 < delta & w2^2 < delta & 1 - c < delta
          ->
          [{d1' = w1,
            d2' = w2,
            w1' = -D1*w1 - K*s,
            w2' = -D2*w2 + K*s,
            s'  = c*(w1 - w2),
            c'  = -s*(w1 - w2)
            & s^2 + c^2 = 1}]
          (w1^2 < eps & w2^2 < eps & 2*K*(1 - c) < eps)
        )
      )
    )
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1);
  implyR(1);
  allR(1);
  implyR(1);
  existsR("eps/(2*K+2)", 1);
  andR(1);
  <(
    QE,
    allR(1); allR(1); allR(1); allR(1); allR(1); allR(1);
    implyR(1);
    dC("w1^2 + w2^2 + 2*K*(1 - c) < eps", 1);
    <(
      dW(1); QE,
      dI(1)
    )
  )
End.

End.
