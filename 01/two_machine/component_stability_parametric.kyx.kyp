Lemma "user/Component-wise Stability Nonlinear (parametric in D1, D2, K)".
"  ==>  \forall D1 (\forall D2 (\forall K ((((D1) > ((0)))&(((D2) > ((0)))&((K) > ((0)))))->(\forall eps ((((eps) > ((0)))&(((((s)^((2)))+((c)^((2)))) = ((1)))&(((((w1)^((2)))+((w2)^((2))))+((((2))*(K))*(((1))-(c)))) < (eps))))->([{d1'=w1,d2'=w2,w1'=(-((D1)*(w1)))-((K)*(s)),w2'=(-((D2)*(w2)))+((K)*(s)),s'=(c)*((w1)-(w2)),c'=-((s)*((w1)-(w2)))&(((s)^((2)))+((c)^((2)))) = ((1))}]((((w1)^((2))) < (eps))&((((w2)^((2))) < (eps))&(((((2))*(K))*(((1))-(c))) < (eps))))))))))
\qed::bb8d6b2b15897f31b359b98db20f1e40"
End.
Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "Component-wise Stability Nonlinear (parametric in D1, D2, K)"

/*
 * Parametric companion to component_stability.kyx (which fixed K=D1=D2=1).
 *
 * For ALL D1>0, D2>0, K>0: if the initial energy H = w1^2+w2^2+2K(1-c) < eps,
 * then along the flow each energy component stays below eps:
 *   w1^2 < eps,  w2^2 < eps,  2K(1-c) < eps.
 * Mechanism: H is invariant (dH/dt = -2 D1 w1^2 - 2 D2 w2^2 <= 0), and each
 * nonnegative summand is bounded by H (uses K>0, c<=1 from s^2+c^2=1).
 *
 * NOTE on the conclusion: the original fixed-K file concluded "1 - c < eps".
 * That is NOT valid for all K: from H<eps one only gets 2K(1-c) < eps, i.e.
 * 1-c < eps/(2K), which exceeds eps when K < 1/2. The parameter-correct
 * component bound is therefore on the ENERGY term 2K(1-c), stated below.
 * (For K >= 1/2 the original 1-c < eps is recovered as a corollary.)
 */

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

Problem
  \forall D1 \forall D2 \forall K (
    D1 > 0 & D2 > 0 & K > 0 ->
    \forall eps (eps > 0 &
      s^2 + c^2 = 1 &
      w1^2 + w2^2 + 2*K*(1 - c) < eps
      ->
      [{d1' = w1,
        d2' = w2,
        w1' = -D1*w1 - K*s,
        w2' = -D2*w2 + K*s,
        s'  = c*(w1 - w2),
        c'  = -s*(w1 - w2)
        & s^2 + c^2 = 1}]
      (w1^2 < eps & w2^2 < eps & 2*K*(1 - c) < eps)
    )
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1);
  implyR(1);
  allR(1);
  implyR(1);
  dC("w1^2 + w2^2 + 2*K*(1 - c) < eps", 1);
  <(
    dW(1); QE,
    dI(1)
  )
End.

End. """"
  tactic """" (allR(1);allR(1);allR(1);implyR(1);allR(1);implyR(1);dC("w1^2+w2^2+2*K*(1-c) < eps", 1);<( (dW(1);QE), dI(1) )) """"
  proof """"  """"
End.
