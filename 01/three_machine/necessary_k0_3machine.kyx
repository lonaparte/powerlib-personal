ArchiveEntry "3-Machine necessity of coupling: K=0 (damped) => never reaches equilibrium"

/*
 * 3-machine analog of necessary_k0 (now the STRONG, damping-on form matching the
 * 2-machine original). With zero coupling (K=0) but POSITIVE damping D1,D2,D3>0,
 * the conserved quantity u = D1*D2*(d1-d2) + D2*w1 - D1*w2 has u'=0, so if u(0)!=0
 * the state (d1-d2, w1, w2) can never all be zero simultaneously -- machines 1,2
 * never reach the common-equilibrium even though their frequencies decay. (w1,w2
 * -> 0 individually but the angle difference drifts to u0/(D1 D2) != 0.) Certifies
 * K>0 is necessary for synchronization. This is STRONGER than a K=0,D=0 "relative
 * frequency conserved" statement: it uses the SAME conserved-quantity instability
 * certificate as the 2-machine necessary_k0, with damping ON.
 *
 * (Machine 3 carries its own decaying frequency w3'=-D3*w3; the 1-2 non-sync
 * certificate already establishes the whole system never reaches equilibrium.)
 */

ProgramVariables
  Real d1; Real d2; Real d3;
  Real w1; Real w2; Real w3;
  Real u0;
End.

Problem
  \forall D1 \forall D2 \forall D3 (D1 > 0 & D2 > 0 & D3 > 0 ->
    (u0 = D1*D2*(d1-d2) + D2*w1 - D1*w2 & u0 != 0
     ->
     [{d1' = w1, d2' = w2, d3' = w3,
       w1' = -D1*w1, w2' = -D2*w2, w3' = -D3*w3, u0' = 0}]
     (d1 - d2 != 0 | w1 != 0 | w2 != 0)))
End.

Tactic "Proof"
  allR(1); allR(1); allR(1); implyR(1); implyR(1);
  dC("D1*D2*(d1-d2) + D2*w1 - D1*w2 != 0", 1);
  <( dW(1); QE, dI(1) )
End.

End.
