/*
 * 3-machine analog of theorem_ph_bridge_parametric. Line 1-2-3, D1=D3=K=1,
 * MIDDLE machine non-passive D2=-d. pH-structured V (theorem_3machine_linear's,
 * constant h=1/5). KEY: V' is MULTILINEAR in (c1,c2) (degree<=1 in each), so on
 * the large-signal box c1,c2 in [4/5,1] its maximum over (c1,c2) is at a VERTEX.
 * Hence V'<=0 on the whole box  <=>  V'<=0 at the 4 corners (c1,c2) in {4/5,1}^2.
 * This file proves all 4 corner quadratic forms (in w1,w2,w3,s1,s2) are negative
 * semidefinite for ALL d in (0, 3/20], by pure universal QE -> V'<=0 on the
 * entire large-signal domain c1,c2 in [4/5,1], parametric in d.
 * (Corner (1,1) is binding; NSD holds up to d~0.19, the linearized d<1/5 boundary.
 * Cross-validated: sympy V' multilinear in c1,c2; numpy corner eigenvalues <0.)
 */

ProgramVariables
  Real w1; Real w2; Real w3; Real s1; Real s2; Real d;
End.

Problem
  \forall d \forall w1 \forall w2 \forall w3 \forall s1 \forall s2 (
    ( 0 < d & d <= 3/20 )
    ->
    ( /* 100*V'|(c1=4/5,c2=4/5) */ 75*d^2*s1*w2 - 75*d^2*s2*w2 - 25*d*s1^2 - 150*d*s1*s2 - 100*d*s1*w1 + 25*d*s1*w2 - 25*d*s2^2 - 25*d*s2*w2 + 100*d*s2*w3 + 80*d*w1^2 - 20*d*w1*w2 + 80*d*w2^2 - 20*d*w2*w3 + 80*d*w3^2 - 75*s1^2 - 50*s1*s2 - 68*s1*w1 - 32*s1*w2 - 75*s2^2 + 32*s2*w2 + 68*s2*w3 - 120*w1^2 - 60*w1*w2 - 40*w2^2 - 60*w2*w3 - 120*w3^2 <= 0 &
        /* 100*V'|(c1=4/5,c2=1) */ 75*d^2*s1*w2 - 75*d^2*s2*w2 - 25*d*s1^2 - 150*d*s1*s2 - 100*d*s1*w1 + 25*d*s1*w2 - 25*d*s2^2 - 25*d*s2*w2 + 100*d*s2*w3 + 80*d*w1^2 - 20*d*w1*w2 + 65*d*w2^2 - 25*d*w2*w3 + 100*d*w3^2 - 75*s1^2 - 50*s1*s2 - 68*s1*w1 - 32*s1*w2 - 75*s2^2 + 40*s2*w2 + 60*s2*w3 - 120*w1^2 - 60*w1*w2 - 45*w2^2 - 75*w2*w3 - 100*w3^2 <= 0 &
        /* 100*V'|(c1=1,c2=4/5) */ 75*d^2*s1*w2 - 75*d^2*s2*w2 - 25*d*s1^2 - 150*d*s1*s2 - 100*d*s1*w1 + 25*d*s1*w2 - 25*d*s2^2 - 25*d*s2*w2 + 100*d*s2*w3 + 100*d*w1^2 - 25*d*w1*w2 + 65*d*w2^2 - 20*d*w2*w3 + 80*d*w3^2 - 75*s1^2 - 50*s1*s2 - 60*s1*w1 - 40*s1*w2 - 75*s2^2 + 32*s2*w2 + 68*s2*w3 - 100*w1^2 - 75*w1*w2 - 45*w2^2 - 60*w2*w3 - 120*w3^2 <= 0 &
        /* 20*V'|(c1=1,c2=1) */ 15*d^2*s1*w2 - 15*d^2*s2*w2 - 5*d*s1^2 - 30*d*s1*s2 - 20*d*s1*w1 + 5*d*s1*w2 - 5*d*s2^2 - 5*d*s2*w2 + 20*d*s2*w3 + 20*d*w1^2 - 5*d*w1*w2 + 10*d*w2^2 - 5*d*w2*w3 + 20*d*w3^2 - 15*s1^2 - 10*s1*s2 - 12*s1*w1 - 8*s1*w2 - 15*s2^2 + 8*s2*w2 + 12*s2*w3 - 20*w1^2 - 15*w1*w2 - 10*w2^2 - 15*w2*w3 - 20*w3^2 <= 0 ) )
