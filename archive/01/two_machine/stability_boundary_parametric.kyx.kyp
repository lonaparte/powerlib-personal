Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "True Stability Boundary (parametric in D, K)"

/*
 * Parametric companion to stability_boundary.kyx (which fixed D=1, K=1).
 *
 * CLAIM: for the symmetric two-machine system (D1=D2=D, J1=J2=1), the energy
 * sublevel {H < 4K} with H = w1^2 + w2^2 + 2K(1-c) is positively invariant
 * for ALL D > 0, K > 0.
 *
 * 4K is the saddle energy (delta=pi, c=-1): {H < 4K} is the largest energy
 * sublevel strictly below the saddle, i.e. the TRUE region of attraction.
 *
 * MECHANISM (pH structure): the sin coupling cancels in the energy balance,
 *   dH/dt = 2 w1(-D w1 - K s) + 2 w2(-D w2 + K s) + 2K s(w1 - w2)
 *         = -2 D (w1^2 + w2^2)  <= 0   for D > 0.
 * Cross-validated symbolically (sympy): Hdot + 2 D (w1^2 + w2^2) = 0 exactly.
 * Hence every sublevel of H (in particular {H < 4K}) is invariant; the dI is
 * structural and needs only D > 0 (no smallness condition on K).
 */

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

Problem
  \forall D \forall K (
    D > 0 & K > 0 &
    s^2 + c^2 = 1 &
    w1^2 + w2^2 + 2*K*(1 - c) < 4*K
    ->
    [{d1' = w1,
      d2' = w2,
      w1' = -D*w1 - K*s,
      w2' = -D*w2 + K*s,
      s'  = c*(w1 - w2),
      c'  = -s*(w1 - w2)
      & s^2 + c^2 = 1}]
    w1^2 + w2^2 + 2*K*(1 - c) < 4*K
  )
End.

Tactic "Proof"
  allR(1); allR(1);
  implyR(1);
  dI(1)
End.

End. """"
  tactic """" (allR(1);allR(1);implyR(1);dI(1)) """"
  proof """"  """"
End.
