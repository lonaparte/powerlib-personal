Lemma "user/True Stability Boundary".
"  ==>  (((((s)^((2)))+((c)^((2)))) = ((1)))&(((((w1)^((2)))+((w2)^((2))))+((((2))*((1)))*(((1))-(c)))) < (((4))*((1)))))->([{d1'=w1,d2'=w2,w1'=(-(((1))*(w1)))-(((1))*(s)),w2'=(-(((1))*(w2)))+(((1))*(s)),s'=(c)*((w1)-(w2)),c'=-((s)*((w1)-(w2)))&(((s)^((2)))+((c)^((2)))) = ((1))}](((((w1)^((2)))+((w2)^((2))))+((((2))*((1)))*(((1))-(c)))) < (((4))*((1)))))
