ArchiveEntry "Component-wise Stability Nonlinear"

Definitions
  Real K  = 1;
  Real D1 = 1;
  Real D2 = 1;
End.

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

Problem
  \forall eps (eps > 0 &
    s^2 + c^2 = 1 &
    w1^2 + w2^2 + 2*K*(1 - c) < eps
    ->
    [{d1' = w1,
      d2' = w2,
      w1' = -D1*w1 - K*s,
      w2' = -D2*w2 + K*s,
      s'  = c*(w1 - w2),
      c'  = -s*(w1 - w2)
      & s^2 + c^2 = 1}]
    (w1^2 < eps & w2^2 < eps & 1 - c < eps)
  )
End.

Tactic "Proof"
  allR(1);
  implyR(1);
  dC("w1^2 + w2^2 + 2*K*(1 - c) < eps", 1);
  <(
    dW(1); QE,
    dI(1)
  )
End.

End.
