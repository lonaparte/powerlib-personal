ArchiveEntry "LaSalle Step 2 (parametric in D1, D2, K)"

/*
 * Parametric companion to lasalle_step2.kyx (which fixed D1=D2=K=1).
 * On the region {w1^2+w2^2 > 0} (away from the omega-axis), with h0 frozen
 * to the initial energy, the Hamiltonian H = w1^2+w2^2+2K(1-c) satisfies
 * H(t) <= h0 for ALL D1>0, D2>0, K>0.
 * Mechanism: dH/dt = -2*D1*w1^2 - 2*D2*w2^2 <= 0 (sin coupling cancels).
 * Cross-validated (sympy): H' + 2*D1*w1^2 + 2*D2*w2^2 = 0 exactly.
 * This is the LaSalle "energy strictly decreasing off the equilibrium set"
 * step, now valid for all positive damping/coupling.
 */

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
  Real h0;
End.

Problem
  \forall D1 \forall D2 \forall K (
    D1 > 0 & D2 > 0 & K > 0 &
    s^2 + c^2 = 1 &
    h0 = w1^2 + w2^2 + 2*K*(1-c) &
    w1^2 + w2^2 > 0
    ->
    [{d1' = w1,
      d2' = w2,
      w1' = -D1*w1 - K*s,
      w2' = -D2*w2 + K*s,
      s'  = c*(w1 - w2),
      c'  = -s*(w1 - w2),
      h0' = 0
      & s^2 + c^2 = 1 & w1^2 + w2^2 > 0}]
    w1^2 + w2^2 + 2*K*(1-c) <= h0
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1);
  implyR(1);
  dI(1)
End.

End.
