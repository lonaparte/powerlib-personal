/* @evidence: parse of print of result of a proof */

Lemma "user/Two-Machine pH System Stability".
"  ==>  ((((((1))*((w1)^((2))))+(((1))*((w2)^((2)))))+(((1))*(((d1)-(d2))^((2))))) < ((1)))->([{d1'=w1,d2'=w2,w1'=(-((((1))/((1)))*(w1)))-((((1))/((1)))*((d1)-(d2))),w2'=(-((((1))/((1)))*(w2)))+((((1))/((1)))*((d1)-(d2)))}]((((((1))*((w1)^((2))))+(((1))*((w2)^((2)))))+(((1))*(((d1)-(d2))^((2))))) < ((1))))
\qed::3048aab19d0e7a6c6399621db19b5fe5"
End.
Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "Two-Machine pH System Stability"

/*
 * Two droop-controlled converters connected through a resistive line.
 *
 * Machine 1: J1*omega1' = -D1*omega1 - P12
 *            delta1' = omega1
 * Machine 2: J2*omega2' = -D2*omega2 + P12
 *            delta2' = omega2
 *
 * Where P12 = K*sin(delta1 - delta2) is the power transfer.
 *
 * For small angles: sin(delta1 - delta2) ~ delta1 - delta2
 *
 * Hamiltonian:
 *   H = (1/2)*J1*omega1^2 + (1/2)*J2*omega2^2
 *     + (1/2)*K*(delta1 - delta2)^2
 *
 * Lie derivative:
 *   dH/dt = -D1*omega1^2 - D2*omega2^2 <= 0
 *
 * This proves: energy sublevel sets are invariant.
 */

Definitions
  Real J1 = 1;
  Real J2 = 1;
  Real D1 = 1;
  Real D2 = 1;
  Real K  = 1;
End.

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
End.

Problem
  J1*w1^2 + J2*w2^2 + K*(d1-d2)^2 < 1
  ->
  [{d1' = w1,
    d2' = w2,
    w1' = -D1/J1*w1 - K/J1*(d1-d2),
    w2' = -D2/J2*w2 + K/J2*(d1-d2)}]
  J1*w1^2 + J2*w2^2 + K*(d1-d2)^2 < 1
End.

Tactic "Proof"
  implyR(1);
  dI(1)
End.

End. """"
  tactic """" (implyR(1);dI(1)) """"
  proof """"  """"
End.
