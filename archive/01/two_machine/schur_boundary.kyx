ArchiveEntry "Stability Boundary: Coupling vs Negative Damping"

ProgramVariables
  Real j;
  Real r1;
  Real r2;
End.

/* The pH structure preservation condition WITHOUT division:
 *
 * For r2 < 0 (non-passive component):
 * Schur complement R_eff >= 0 iff j^2 + r1*r2 >= 0
 * i.e., j^2 >= r1*|r2| (coupling must dominate)
 *
 * Physical meaning:
 *   j = coupling strength (K in power system)
 *   r1 = passive damping (droop coefficient)
 *   |r2| = negative damping magnitude (PLL effect)
 *
 * Stability boundary: j^2 = r1 * |r2|
 * i.e., K^2 = D_droop * D_PLL
 * i.e., K = sqrt(D_droop * D_PLL)
 */

/* Sufficiency: j^2 >= r1*|r2| => system is stable (pH preserved) */
Problem
  \forall j \forall r1 \forall r2 (
    r1 > 0 & r2 < 0 & j*j + r1*r2 >= 0
    -> r1*r2*r2 + j*j*r2 <= 0
  )
End.

Tactic "Proof"
  QE
End.

End.
