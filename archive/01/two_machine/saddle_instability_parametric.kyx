ArchiveEntry "Saddle Instability (parametric in D, K)"

/*
 * Parametric companion to saddle_instability.kyx (which fixed D=K=1).
 * Pure algebra (no ODE): near the saddle (c < -1/2, i.e. delta near pi) on the
 * omega-axis section w1 = 0, the rotational force has a destabilizing sign.
 * CLAIM: for ALL D>0, K>0,  (c < -1/2 & s != 0 & w1 = 0) -> (-D*w1 - K*s)*s < 0.
 * With w1 = 0 this is -K*s^2 < 0, which holds iff K > 0 and s != 0.
 */

ProgramVariables
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

Problem
  \forall D \forall K (
    D > 0 & K > 0 & s^2 + c^2 = 1 & c < -1/2 & s != 0 & w1 = 0
    ->
    (-D*w1 - K*s)*s < 0
  )
End.

Tactic "Proof"
  QE
End.

End.
