ArchiveEntry "Strict Dissipation Away from Equilibrium (parametric in D1, D2, K)"

/*
 * Parametric companion to strict_dissipation.kyx (which fixed J1=J2=D1=D2=K=1).
 * Inertia normalized J1=J2=1 (Conventions.md sec.4), damping/coupling symbolic.
 * The auxiliary state h integrates the dissipation, h' = -2*D1*w1^2 - 2*D2*w2^2.
 * CLAIM: the energy identity h = H = w1^2+w2^2+2K(1-c) is maintained exactly
 * for ALL D1>0, D2>0, K>0 -- i.e. the integrated dissipation equals the
 * Hamiltonian decrease (the pH energy-balance law).
 * Mechanism: (h - H)' = h' - dH/dt = 0.
 * Cross-validated (sympy): (h - H)' = 0 exactly.
 */

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
  Real h;
End.

Problem
  \forall D1 \forall D2 \forall K (
    D1 > 0 & D2 > 0 & K > 0 &
    s^2 + c^2 = 1 &
    h = w1^2 + w2^2 + 2*K*(1 - c)
    ->
    [{d1' = w1,
      d2' = w2,
      w1' = -D1*w1 - K*s,
      w2' = -D2*w2 + K*s,
      s'  = c*(w1 - w2),
      c'  = -s*(w1 - w2),
      h'  = -2*D1*w1^2 - 2*D2*w2^2}]
    h = w1^2 + w2^2 + 2*K*(1 - c)
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1);
  implyR(1);
  dI(1)
End.

End.
