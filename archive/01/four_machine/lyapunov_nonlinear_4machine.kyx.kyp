/*
 * 4-machine chain analog of lyapunov_nonlinear_3machine. Full epsilon-delta
 * Lyapunov stability of the synchronized equilibrium for the passive nonlinear
 * 4-machine chain, ALL D1..D4,K>0, using H = w1^2+w2^2+w3^2+w4^2+2K(1-c1)+
 * 2K(1-c2)+2K(1-c3). Witness delta = eps (parameter-INDEPENDENT): dH/dt =
 * -2(D1 w1^2+D2 w2^2+D3 w3^2+D4 w4^2) <= 0, so H non-increasing. TOPOLOGY-INDEP.
 */

ProgramVariables
  Real da; Real db; Real dc; Real dd;
  Real w1; Real w2; Real w3; Real w4;
  Real s1; Real c1; Real s2; Real c2; Real s3; Real c3;
End.

Problem
  \forall D1 \forall D2 \forall D3 \forall D4 \forall K (
    D1 > 0 & D2 > 0 & D3 > 0 & D4 > 0 & K > 0 ->
    \forall eps (eps > 0 ->
      \exists delta (delta > 0 &
        \forall da \forall db \forall dc \forall dd \forall w1 \forall w2 \forall w3 \forall w4 \forall s1 \forall c1 \forall s2 \forall c2 \forall s3 \forall c3 (
          s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1 & s3^2 + c3^2 = 1 &
          w1^2 + w2^2 + w3^2 + w4^2 + 2*K*(1-c1) + 2*K*(1-c2) + 2*K*(1-c3) < delta
          ->
          [{da' = w1, db' = w2, dc' = w3, dd' = w4,
            w1' = -D1*w1 - K*s1,
            w2' = -D2*w2 + K*s1 - K*s2,
            w3' = -D3*w3 + K*s2 - K*s3,
            w4' = -D4*w4 + K*s3,
            s1' = c1*(w1 - w2), c1' = -s1*(w1 - w2),
            s2' = c2*(w2 - w3), c2' = -s2*(w2 - w3),
            s3' = c3*(w3 - w4), c3' = -s3*(w3 - w4)}]
          w1^2 + w2^2 + w3^2 + w4^2 + 2*K*(1-c1) + 2*K*(1-c2) + 2*K*(1-c3) < eps
        )
      )
    )
  )
End.

