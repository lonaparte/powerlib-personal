Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "4-Machine CHAIN energy-balance identity h=H maintained (parametric in D1..D4,K)"

/*
 * 4-machine chain analog of strict_dissipation_3machine. Auxiliary state h
 * integrates the dissipation, h' = -2(D1 w1^2+D2 w2^2+D3 w3^2+D4 w4^2). The
 * energy identity h = H = w1^2+w2^2+w3^2+w4^2+2K(1-c1)+2K(1-c2)+2K(1-c3) is
 * maintained exactly for ALL D1..D4,K>0 -- the pH energy-balance law on the
 * chain (the three sin couplings cancel, so dH/dt = h'). TOPOLOGY-INDEPENDENT.
 */

ProgramVariables
  Real da; Real db; Real dc; Real dd;
  Real w1; Real w2; Real w3; Real w4;
  Real s1; Real c1; Real s2; Real c2; Real s3; Real c3;
  Real h;
End.

Problem
  \forall D1 \forall D2 \forall D3 \forall D4 \forall K (
    D1 > 0 & D2 > 0 & D3 > 0 & D4 > 0 & K > 0 &
    s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1 & s3^2 + c3^2 = 1 &
    h = w1^2 + w2^2 + w3^2 + w4^2 + 2*K*(1-c1) + 2*K*(1-c2) + 2*K*(1-c3)
    ->
    [{da' = w1, db' = w2, dc' = w3, dd' = w4,
      w1' = -D1*w1 - K*s1,
      w2' = -D2*w2 + K*s1 - K*s2,
      w3' = -D3*w3 + K*s2 - K*s3,
      w4' = -D4*w4 + K*s3,
      s1' = c1*(w1 - w2), c1' = -s1*(w1 - w2),
      s2' = c2*(w2 - w3), c2' = -s2*(w2 - w3),
      s3' = c3*(w3 - w4), c3' = -s3*(w3 - w4),
      h'  = -2*D1*w1^2 - 2*D2*w2^2 - 2*D3*w3^2 - 2*D4*w4^2}]
    h = w1^2 + w2^2 + w3^2 + w4^2 + 2*K*(1-c1) + 2*K*(1-c2) + 2*K*(1-c3)
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1); allR(1); allR(1);
  implyR(1);
  dI(1)
End.

