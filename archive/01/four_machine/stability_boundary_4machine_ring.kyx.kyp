Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "4-Machine RING stability region {H<8K} invariant, parametric in D1..D4,K"

/*
 * RING topology 1-2-3-4-1 stability region. The KEY TOPOLOGY-DEPENDENCE RESULT:
 * the ring's escape barrier is 8K, NOT the chain's 4K.
 *
 * WHY: on a ring the phase differences around the loop must sum to a multiple of
 * 2*pi (loop/circulation constraint). You CANNOT push a single bond to pi while
 * leaving the others at 0 -- the loop would not close. The lowest nonzero
 * critical point of U = sum 2K(1-cos delta_j) over the 4 ring bonds is the
 * "two-domain" twisted state with U = 8K (numerically: the only critical values
 * are 8K and 16K; gauge th4=0, fsolve over 2e4 starts). So the synchronized well
 * is DEEPER on the ring: {H < 8K} is the positively-invariant guaranteed region,
 * twice the chain barrier. (The naive "one bond to pi" 4K config is NOT a
 * critical point on the ring -- grad != 0 -- it is dynamically inaccessible as an
 * escape saddle because the loop constraint forbids it.)
 *
 * The dI proof itself is the SAME one-liner (H non-increasing); what changed is
 * the THRESHOLD CONSTANT, and that constant is set by the topology. Compare
 * stability_boundary_4machine.kyx (chain, 4K). Numerically cross-validated:
 * chain min saddle 4K, ring min saddle 8K.
 */

ProgramVariables
  Real da; Real db; Real dc; Real dd;
  Real w1; Real w2; Real w3; Real w4;
  Real s1; Real c1; Real s2; Real c2; Real s3; Real c3; Real s4; Real c4;
End.

Problem
  \forall D1 \forall D2 \forall D3 \forall D4 \forall K (
    D1 > 0 & D2 > 0 & D3 > 0 & D4 > 0 & K > 0 &
    s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1 & s3^2 + c3^2 = 1 & s4^2 + c4^2 = 1 &
    w1^2 + w2^2 + w3^2 + w4^2 + 2*K*(1-c1) + 2*K*(1-c2) + 2*K*(1-c3) + 2*K*(1-c4) < 8*K
    ->
    [{da' = w1, db' = w2, dc' = w3, dd' = w4,
      w1' = -D1*w1 - K*s1 + K*s4,
      w2' = -D2*w2 + K*s1 - K*s2,
      w3' = -D3*w3 + K*s2 - K*s3,
      w4' = -D4*w4 + K*s3 - K*s4,
      s1' = c1*(w1 - w2), c1' = -s1*(w1 - w2),
      s2' = c2*(w2 - w3), c2' = -s2*(w2 - w3),
      s3' = c3*(w3 - w4), c3' = -s3*(w3 - w4),
      s4' = c4*(w4 - w1), c4' = -s4*(w4 - w1)
      & s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1 & s3^2 + c3^2 = 1 & s4^2 + c4^2 = 1}]
    w1^2 + w2^2 + w3^2 + w4^2 + 2*K*(1-c1) + 2*K*(1-c2) + 2*K*(1-c3) + 2*K*(1-c4) < 8*K
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1); allR(1); allR(1);
  implyR(1);
  dI(1)
End.

End. """"
  tactic """" (allR(1);allR(1);allR(1);allR(1);allR(1);implyR(1);dI(1)) """"
