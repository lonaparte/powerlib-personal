ArchiveEntry "Lyapunov Stability Single Machine"

/*
 * Full Lyapunov stability for a single damped oscillator.
 *
 * System: d' = w, w' = -d - D*w  (K=1, J=1)
 * Equilibrium: (d,w) = (0,0)
 * H(d,w) = d^2 + w^2
 *
 * Since H = ||x||^2, sublevel sets of H are exactly norm balls.
 * So sublevel invariance IS Lyapunov stability.
 *
 * Proof:
 *   ||x(0)|| < delta  =>  H(x(0)) < delta^2
 *   dI: H(x(t)) <= H(x(0)) < delta^2
 *   =>  ||x(t)|| < delta
 *
 *   Take delta = sqrt(eps): ||x(0)|| < sqrt(eps) => ||x(t)|| < sqrt(eps) < eps
 *   (for eps < 1)
 *
 * Actually simpler: since H = ||x||^2 and H non-increasing,
 *   ||x(0)||^2 < eps  =>  ||x(t)||^2 < eps
 * which is exactly Lyapunov stability in terms of ||x||^2.
 */

Definitions
  Real D = 1;
End.

ProgramVariables
  Real d;
  Real w;
End.

Problem
  \forall eps (eps > 0 ->
    \exists delta (delta > 0 &
      \forall d \forall w (
        d^2 + w^2 < delta
        ->
        [{d' = w, w' = -d - D*w}]
        d^2 + w^2 < eps
      )
    )
  )
End.

Tactic "Proof"
  /* For all eps > 0 */
  allR(1);
  implyR(1);
  /* Witness: delta = eps (since H = ||x||^2 and H non-increasing) */
  existsR("eps", 1);
  andR(1);
  <(
    /* delta > 0: follows from eps > 0 */
    id,
    /* Main: d^2+w^2 < eps -> [ODE] d^2+w^2 < eps */
    allR(1); allR(1);
    implyR(1);
    dI(1)
  )
End.

End.
