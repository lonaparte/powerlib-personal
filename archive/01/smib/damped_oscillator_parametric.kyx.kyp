/* @evidence: parse of print of result of a proof */

Lemma "user/pH Damped Oscillator Stability (parametric in K, D)".
"  ==>  \forall K (\forall D ((((K) > ((0)))&(((D) > ((0)))&((((K)*((delta)^((2))))+((omega)^((2)))) < ((1)))))->([{delta'=omega,omega'=(-((K)*(delta)))-((D)*(omega))}]((((K)*((delta)^((2))))+((omega)^((2)))) < ((1))))))
\qed::a2a1ac51f844f72acf4e0f94408bac7a"
End.
Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "pH Damped Oscillator Stability (parametric in K, D)"

/*
 * Parametric companion to damped_oscillator.kyx (which fixed K=Jn=D=1).
 * Single pH oscillator, inertia normalized Jn=1 (Conventions.md sec.4):
 *   delta' = omega,  omega' = -K*delta - D*omega.
 * CLAIM: the energy sublevel {K*delta^2 + omega^2 < 1} is positively
 * invariant for ALL K>0, D>0.
 * Mechanism: V = K*delta^2 + omega^2, V' = -2*D*omega^2 <= 0 (D>0).
 * Cross-validated (sympy): V' + 2*D*omega^2 = 0 exactly.
 */

ProgramVariables
  Real delta;
  Real omega;
End.

Problem
  \forall K \forall D (
    K > 0 & D > 0 &
    K*delta^2 + omega^2 < 1
    ->
    [{delta' = omega, omega' = -K*delta - D*omega}]
    K*delta^2 + omega^2 < 1
  )
End.

Tactic "Proof"
  allR(1); allR(1);
  implyR(1);
  dC("K*delta^2 + omega^2 < 1", 1);
  <(
    dW(1); QE,
    dI(1)
  )
End.

End. """"
  tactic """" (allR(1);allR(1);implyR(1);dC("K*delta^2+omega^2 < 1", 1);<( (dW(1);QE), dI(1) )) """"
  proof """"  """"
End.
