/*
 * 3-machine analog of lyapunov_nonlinear_parametric. Full epsilon-delta Lyapunov
 * stability of the synchronized equilibrium for the passive nonlinear 3-machine
 * line, for ALL D1,D2,D3,K>0, using H = w1^2+w2^2+w3^2+2K(1-c1)+2K(1-c2).
 * Witness delta = eps (parameter-INDEPENDENT): dH/dt = -2(D1 w1^2+D2 w2^2+D3 w3^2)
 * <= 0, so H is non-increasing and H(0)<eps implies H(t)<eps for all t.
 */

ProgramVariables
  Real da; Real db; Real dc;
  Real w1; Real w2; Real w3;
  Real s1; Real c1; Real s2; Real c2;
End.

Problem
  \forall D1 \forall D2 \forall D3 \forall K (
    D1 > 0 & D2 > 0 & D3 > 0 & K > 0 ->
    \forall eps (eps > 0 ->
      \exists delta (delta > 0 &
        \forall da \forall db \forall dc \forall w1 \forall w2 \forall w3 \forall s1 \forall c1 \forall s2 \forall c2 (
          s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1 &
          w1^2 + w2^2 + w3^2 + 2*K*(1-c1) + 2*K*(1-c2) < delta
          ->
          [{da' = w1, db' = w2, dc' = w3,
            w1' = -D1*w1 - K*s1,
            w2' = -D2*w2 + K*s1 - K*s2,
            w3' = -D3*w3 + K*s2,
            s1' = c1*(w1 - w2), c1' = -s1*(w1 - w2),
            s2' = c2*(w2 - w3), c2' = -s2*(w2 - w3)}]
          w1^2 + w2^2 + w3^2 + 2*K*(1-c1) + 2*K*(1-c2) < eps
        )
      )
    )
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1); allR(1);
  implyR(1);
  allR(1);
  implyR(1);
  existsR("eps", 1);
  andR(1);
  <(
    id,
    allR(1); allR(1); allR(1); allR(1); allR(1); allR(1); allR(1); allR(1); allR(1); allR(1);
    implyR(1);
    dI(1)
  )
End.

