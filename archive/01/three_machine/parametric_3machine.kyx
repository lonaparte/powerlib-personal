ArchiveEntry "3-Machine passive pH sublevel invariance (parametric in D1,D2,D3,K)"

/*
 * Foundational 3-machine result that two-machine has (parametric.kyx) but the
 * 3-machine archive lacked. Line topology 1-2-3 (middle machine coupled to both
 * neighbors), ALL machines passive (D1,D2,D3>0). For ALL D1,D2,D3,K>0 the energy
 * sublevel {H<1} is positively invariant, where
 *   H = w1^2 + w2^2 + w3^2 + 2K(1-c1) + 2K(1-c2).
 * Mechanism (pH structure on the line): the two sin couplings cancel in the
 * energy balance, dH/dt = -2(D1 w1^2 + D2 w2^2 + D3 w3^2) <= 0.
 * Cross-validated (sympy): Hdot + 2(D1 w1^2+D2 w2^2+D3 w3^2) = 0 exactly.
 * Unlike the D2<0 case (theorem_3machine), the all-passive case is globally
 * dissipative -- no locality bound, no SOS needed; a one-line dI.
 */

ProgramVariables
  Real da; Real db; Real dc;
  Real w1; Real w2; Real w3;
  Real s1; Real c1; Real s2; Real c2;
End.

Problem
  \forall D1 \forall D2 \forall D3 \forall K (
    D1 > 0 & D2 > 0 & D3 > 0 & K > 0 &
    s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1 &
    w1^2 + w2^2 + w3^2 + 2*K*(1-c1) + 2*K*(1-c2) < 1
    ->
    [{da' = w1, db' = w2, dc' = w3,
      w1' = -D1*w1 - K*s1,
      w2' = -D2*w2 + K*s1 - K*s2,
      w3' = -D3*w3 + K*s2,
      s1' = c1*(w1 - w2), c1' = -s1*(w1 - w2),
      s2' = c2*(w2 - w3), c2' = -s2*(w2 - w3)
      & s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1}]
    w1^2 + w2^2 + w3^2 + 2*K*(1-c1) + 2*K*(1-c2) < 1
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1); allR(1);
  implyR(1);
  dI(1)
End.

End.
