    allL("c1*d*w1^2 - c1*d*w1*w2/4 - 3*c1*d*w2^2/4 + 2*c1*s1*w1/5 - 2*c1*s1*w2/5 + c1*w1^2 - 3*c1*w1*w2/4 - c1*w2^2/4 - 3*c2*d*w2^2/4 - c2*d*w2*w3/4 + c2*d*w3^2 + 2*c2*s2*w2/5 - 2*c2*s2*w3/5 - c2*w2^2/4 - 3*c2*w2*w3/4 + c2*w3^2 + 3*d^2*s1*w2/4 - 3*d^2*s2*w2/4 - d*s1^2/4 - 3*d*s1*s2/2 - d*s1*w1 + d*s1*w2/4 - d*s2^2/4 - d*s2*w2/4 + d*s2*w3 + 2*d*w2^2 - 3*s1^2/4 - s1*s2/2 - s1*w1 - 3*s2^2/4 + s2*w3 - 2*w1^2 - 2*w3^2", 'Llast);
    implyL('Llast); <(
      hideR(1); andR(1); <(QE, andR(1); <(QE, andR(1); <(QE, andR(1); <(QE, andR(1); <(QE, andR(1); <(QE, andR(1); <(QE, andR(1); <(QE, QE)))))))),
      id
