ArchiveEntry "3-Machine necessity: all-negative damping (D1,D2,D3<0) => energy grows (no asymptotic stability)"

/*
 * 3-machine analog of necessary_dneg. If all three machines have negative damping
 * (D1,D2,D3 < 0) and K>0, the Hamiltonian H = w1^2+w2^2+w3^2+2K(1-c1)+2K(1-c2)
 * never decreases: H(t) >= H(0) whenever there is motion (w1^2+w2^2+w3^2 > 0).
 *   Hdot = -2(D1 w1^2 + D2 w2^2 + D3 w3^2);  Di<0 => Hdot >= 0.
 * Energy is monotonically injected, so the in-phase equilibrium can never be
 * reached from a state with kinetic energy -- asymptotic stability is impossible.
 * This is the large-signal energy certificate for instability under negative
 * damping, dual to the passive case. (Symbolic in D1,D2,D3<0 and K>0.)
 *
 * h0 frozen via h0'=0 records the initial energy; the post-condition H >= h0
 * is the monotone-growth statement.
 */

ProgramVariables
  Real da; Real db; Real dc;
  Real w1; Real w2; Real w3;
  Real s1; Real c1; Real s2; Real c2;
  Real h0;
End.

Problem
  \forall D1 \forall D2 \forall D3 \forall K (
    D1 < 0 & D2 < 0 & D3 < 0 & K > 0 ->
    ( s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1 &
      h0 = w1^2 + w2^2 + w3^2 + 2*K*(1-c1) + 2*K*(1-c2) &
      w1^2 + w2^2 + w3^2 > 0
      ->
      [{da' = w1, db' = w2, dc' = w3,
        w1' = -D1*w1 - K*s1,
        w2' = -D2*w2 + K*s1 - K*s2,
        w3' = -D3*w3 + K*s2,
        s1' = c1*(w1 - w2), c1' = -s1*(w1 - w2),
        s2' = c2*(w2 - w3), c2' = -s2*(w2 - w3),
        h0' = 0
        & s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1 & w1^2 + w2^2 + w3^2 > 0}]
      w1^2 + w2^2 + w3^2 + 2*K*(1-c1) + 2*K*(1-c2) >= h0 )
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1); allR(1);
  implyR(1); implyR(1);
  dI(1)
End.

End.
