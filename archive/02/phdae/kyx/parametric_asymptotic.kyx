ArchiveEntry "Asymptotic Stability Heterogeneous D1=1 D2=5 K=2"

Definitions
  Real D1 = 1;
  Real D2 = 5;
  Real K  = 2;
  Real a  = 1/4;
End.

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
  Real t;
  Real v0;
End.

Problem
  \forall target (target > 0 & target < 1/2 ->
    (s^2 + c^2 = 1 & c > 0 &
     v0 = w1^2 + w2^2 + 2*K*(1-c) + a*(w1-w2)*s &
     v0 > 0 & v0 < 1 & t = 0
     ->
     [{d1' = w1,
       d2' = w2,
       w1' = -D1*w1 - K*s,
       w2' = -D2*w2 + K*s,
       s'  = c*(w1 - w2),
       c'  = -s*(w1 - w2),
       t'  = 1,
       v0' = 0
       & s^2 + c^2 = 1 & c >= 0 &
         w1^2 + w2^2 + 2*K*(1-c) + a*(w1-w2)*s >= target}]
     t < 48*v0/target)
  )
End.

Tactic "Proof"
  allR(1);
  implyR(1);
  implyR(1);
  dC("w1^2 + w2^2 + 2*K*(1-c) + a*(w1-w2)*s <= v0 - t*target/48", 1);
  <(
    dW(1); QE,
    dI(1)
  )
End.

End.
