Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "Parametric pH Two-Machine Stability"

/*
 * Same two-machine nonlinear system but with symbolic parameters.
 * Goal: derive stability CONDITIONS on parameters, not just verify fixed values.
 *
 * H = J1*w1^2 + J2*w2^2 + 2*K*(1-c)
 * dH/dt = 2*w1*(- D1*w1 - K*s) + 2*w2*(-D2*w2 + K*s) + 2*K*s*(w1-w2)
 *       = -2*D1*w1^2 - 2*D2*w2^2
 *
 * Need: D1 > 0, D2 > 0 for dH/dt <= 0
 * Also need: J1 > 0, J2 > 0, K > 0 for H to be positive definite
 */

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

Problem
  \forall J1 \forall J2 \forall D1 \forall D2 \forall K (
    J1 > 0 & J2 > 0 & D1 > 0 & D2 > 0 & K > 0 &
    s^2 + c^2 = 1 &
    J1*w1^2 + J2*w2^2 + 2*K*(1 - c) < 1
    ->
    [{d1' = w1,
      d2' = w2,
      w1' = -D1/J1*w1 - K/J1*s,
      w2' = -D2/J2*w2 + K/J2*s,
      s'  = c*(w1 - w2),
      c'  = -s*(w1 - w2)}]
    J1*w1^2 + J2*w2^2 + 2*K*(1 - c) < 1
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1); allR(1); allR(1);
  implyR(1);
  dI(1)
End.

End. """"
