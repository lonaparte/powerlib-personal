ArchiveEntry "Saddle Instability"

Definitions
  Real D = 1;
  Real K = 1;
End.

ProgramVariables
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

/* Near-saddle: c close to -1, s small but nonzero.
   w1' = -D*w1 - K*s.
   At w1=0: w1' = -K*s.
   If s > 0: w1' = -K*s < 0 (w1 accelerates negative)
   If s < 0: w1' = -K*s > 0 (w1 accelerates positive)
   Either way, w grows -> kinetic energy increases.
   
   This means the saddle point (c=-1,s=0,w=0) is unstable:
   any perturbation in s drives w away from zero. */

/* Prove: near saddle, angle acceleration is nonzero */
Problem
  s^2 + c^2 = 1 & c < -1/2 & s != 0 & w1 = 0
  -> (-D*w1 - K*s)*s < 0
End.

Tactic "Proof"
  QE
End.

End.
