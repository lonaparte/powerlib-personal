ArchiveEntry "pH Asymptotic Phase 1"

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
  Real t;
  Real h0;
End.

Problem
  s^2 + c^2 = 1 &
  h0 = w1^2 + w2^2 + 2*(1-c) &
  h0 > 0 & h0 < 1 & t = 0
  ->
  [{d1' = w1,
    d2' = w2,
    w1' = -w1 - s,
    w2' = -w2 + s,
    s'  = c*(w1 - w2),
    c'  = -s*(w1 - w2),
    t'  = 1,
    h0' = 0
    & s^2 + c^2 = 1 &
      w1^2 + w2^2 >= 1/100}]
  t < 50*h0
End.

Tactic "Proof"
  implyR(1);
  dC("w1^2 + w2^2 + 2*(1-c) <= h0 - t/50", 1);
  <(
    dW(1); QE,
    dI(1)
  )
End.

End.
