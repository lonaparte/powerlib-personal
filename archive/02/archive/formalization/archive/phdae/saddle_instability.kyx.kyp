/* @evidence: generated by KeYmaeraX 5.1.2 -launch -prove archive/phdae/saddle_instability.kyx -tool z3 */

/* @evidence: parse of print of result of a proof */

Lemma "user/Saddle Instability".
"  ==>  (((((s)^((2)))+((c)^((2)))) = ((1)))&(((c) < (-(((1))/((2)))))&(((s) != ((0)))&((w1) = ((0))))))->((((-(((1))*(w1)))-(((1))*(s)))*(s)) < ((0)))
\qed::aa3585b0bc36c798ebfa9d7c2e1a2b9e"
End.
Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "Saddle Instability"

Definitions
  Real D = 1;
  Real K = 1;
End.

ProgramVariables
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

/* Near-saddle: c close to -1, s small but nonzero.
   w1' = -D*w1 - K*s.
   At w1=0: w1' = -K*s.
   If s > 0: w1' = -K*s < 0 (w1 accelerates negative)
   If s < 0: w1' = -K*s > 0 (w1 accelerates positive)
   Either way, w grows -> kinetic energy increases.
   
   This means the saddle point (c=-1,s=0,w=0) is unstable:
   any perturbation in s drives w away from zero. */

/* Prove: near saddle, angle acceleration is nonzero */
Problem
  s^2 + c^2 = 1 & c < -1/2 & s != 0 & w1 = 0
  -> (-D*w1 - K*s)*s < 0
End.

Tactic "Proof"
  QE
End.

End. """"
  tactic """" QE """"
  proof """"  """"
End.
