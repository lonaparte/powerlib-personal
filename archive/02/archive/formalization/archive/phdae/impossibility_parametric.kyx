ArchiveEntry "Impossibility (PARAMETRIC in d): 2-param pH family fails for d in [1/4,1)"

/* KeYmaera X STATUS: NOT machine-verified. QE threw a resource exception on this
 * forall-in-d formulation (3 variables, intrinsically thin gap margin
 * ~-4e-3). The single-instance version (impossibility_ph_linear.kyx, d=3/10) IS verified. The d-band
 * boundary is an algebraic number, so a clean forall-d QE is out of reach. */

/*
 * PARAMETRIC version of #2 (no fixed d).
 * 2-parameter family V = H + a*(w1-w2)*s + b*w2*s (NO sin^2), D1=K=1, D2=-d.
 *
 * M(1) (h=0, a1=a, a2=b-a):
 *   M00=-2+a, M01=(b-2a)/2, M02=-a/2, M11=2d-(b-a), M12=(b-a)d/2, M22=b-2a
 *
 * M<0 iff all 3 leading minors of -M >0 (Sylvester). The 2-param family
 * fails (M never <0) for d >= 1/4 (the exact threshold d_thresh ~ 0.225
 * is an algebraic number; 1/4 is a clean rational bound above it).
 *
 * Claim: for ALL (a,b) and ALL d with 1/4 <= d < 1, the three minors are
 * NOT all positive. Pure forall QE in (a,b,d) — fully parametric in d.
 *
 * Minors (cleared *4, signs preserved):
 *   LM1   = 2 - a
 *   LM2*4 = 8ad - 8a - b^2 + 8b - 16d
 *   LM3*4 = a^3 d^2 + 2a^3 d + a^3 - 2a^2 b d^2 - 3a^2 b d - a^2 b
 *           - 2a^2 d^2 + 18a^2 d - 16a^2 + a b^2 d^2 + a b^2 d - 2a b^2
 *           + 4ab d^2 - 8ab d + 24ab - 32ad + b^3 - 2b^2 d^2 - 8b^2 + 16bd
 */

ProgramVariables
  Real a;
  Real b;
  Real d;
End.

Problem
  \forall a \forall b \forall d (
    ( d >= 1/4 & d < 1 )
    ->
    ( 2 - a <= 0
    | 8*a*d - 8*a - b^2 + 8*b - 16*d <= 0
    | a^3*d^2 + 2*a^3*d + a^3 - 2*a^2*b*d^2 - 3*a^2*b*d - a^2*b
        - 2*a^2*d^2 + 18*a^2*d - 16*a^2 + a*b^2*d^2 + a*b^2*d - 2*a*b^2
        + 4*a*b*d^2 - 8*a*b*d + 24*a*b - 32*a*d + b^3 - 2*b^2*d^2
        - 8*b^2 + 16*b*d <= 0 ) )
End.

Tactic "Proof"
  QE
End.

End.
