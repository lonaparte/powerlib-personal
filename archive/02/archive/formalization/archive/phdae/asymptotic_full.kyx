ArchiveEntry "Full Asymptotic Stability"

ProgramVariables
  Real d;
  Real w;
  Real t;
  Real v0;
End.

Problem
  \forall target (target > 0 ->
    (v0 > 0 & v0 < 1 & t = 0 & v0 = 3*d^2/2 + d*w + w^2
    ->
    [{d' = w, w' = -d - w, t' = 1, v0' = 0
      & 3*d^2/2 + d*w + w^2 >= target}]
    t < 2*v0/target + 1)
  )
End.

Tactic "Proof"
  allR(1);
  implyR(1);
  implyR(1);
  dC("3*d^2/2 + d*w + w^2 <= v0 - t*target/2", 1);
  <(
    dW(1); QE,
    dI(1)
  )
End.

End.
