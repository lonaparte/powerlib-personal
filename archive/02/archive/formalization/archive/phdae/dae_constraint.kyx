ArchiveEntry "pH-DAE with Network Constraint"

Definitions
  Real J1 = 1;
  Real J2 = 1;
  Real D1 = 1;
  Real D2 = 1;
  Real K  = 1;
End.

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

Problem
  s^2 + c^2 = 1 &
  J1*w1^2 + J2*w2^2 + 2*K*(1 - c) < 1
  ->
  [{d1' = w1,
    d2' = w2,
    w1' = -D1/J1*w1 - K/J1*s,
    w2' = -D2/J2*w2 + K/J2*s,
    s'  = c*(w1 - w2),
    c'  = -s*(w1 - w2)
    & s^2 + c^2 = 1}]
  J1*w1^2 + J2*w2^2 + 2*K*(1 - c) < 1
End.

Tactic "Proof"
  implyR(1);
  dI(1)
End.

End.
