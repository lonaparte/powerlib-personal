ArchiveEntry "R2 (Sigma_2 closed form): fully-symbolic fold manifold Phi(p)=0"

/* R2c closed form, ALL 6 params symbolic (scalar problem -> no CAS blowup, unlike the
 * 8x8 R1 case).  Fold manifold:  Phi(p) = M^2 - Vg^2 = 0  with  M = id_ref*wn*Lg +
 * iq_ref*Rg.  Expanded:
 *   Phi = Lg^2*id_ref^2*wn^2 + 2*Lg*Rg*id_ref*iq_ref*wn + Rg^2*iq_ref^2 - Vg^2.
 * This certificate checks the expansion identity (M^2-Vg^2 equals the expanded form)
 * and that Phi<0 <=> below fold (sync equilibrium exists) for all symbolic params. */
Problem
  \forall Vg \forall Rg \forall Lg \forall wn \forall idref \forall iqref
  ( (idref*wn*Lg + iqref*Rg)^2 - Vg^2
    = Lg^2*idref^2*wn^2 + 2*Lg*Rg*idref*iqref*wn + Rg^2*iqref^2 - Vg^2 )
End.
Tactic "fold closed form by QE"
  QE
End.
End.

ArchiveEntry "R2 (Sigma_2 closed form): Phi<0 iff strictly below the fold"

/* Phi(p) < 0  <=>  M^2 < Vg^2  <=>  a sync equilibrium exists (R2a).  Fully symbolic. */
Problem
  \forall Vg \forall Rg \forall Lg \forall wn \forall idref \forall iqref
  ( ( Lg^2*idref^2*wn^2 + 2*Lg*Rg*idref*iqref*wn + Rg^2*iqref^2 - Vg^2 < 0 )
    <-> ( (idref*wn*Lg + iqref*Rg)^2 < Vg^2 ) )
End.
Tactic "below fold iff by QE"
  QE
End.
End.
