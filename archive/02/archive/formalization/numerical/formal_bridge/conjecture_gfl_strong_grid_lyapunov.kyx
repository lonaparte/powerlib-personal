ArchiveEntry "Conjecture: GFL strong-grid local Lyapunov (10-state, quadratic V)"

/*
 * CONJECTURE (NOT machine-checked: KeYmaera X is not installed in this
 * environment -- only a JDK is present, no keymaerax jar/CLI).  This file
 * therefore has a Problem block but NO Tactic, per the project convention
 * (filename prefixed conjecture_).
 *
 * CLAIM (local / small-signal stability of the GFL equilibrium, strong grid)
 * ------------------------------------------------------------------------
 * For the 10-state grid-following converter of Conventions.md section 12 at the
 * STRONG-grid operating point
 *      SCR = 2.0, X/R = 10.0, Kp = 0.3, Ki = 150.0,
 * the linearization A = Df(x*) is Hurwitz (numerically verified:
 * max Re eig(A) = -3.5568e+01; the weak-grid Hopf is at SCR ~ 0.9051).
 *
 * We certify stability with a QUADRATIC Lyapunov function V = x^T P x for the
 * linear flow x' = A x, where (to obtain a manageable RATIONAL certificate) A
 * is taken in BALANCED, TIME-RESCALED coordinates:
 *      A := (1/tau) * Dinv * Df(x*) * D,   tau = 200,
 * D = diagonal balancing (a similarity transform: preserves the spectrum, hence
 * Hurwitz-ness and stability -- it is just a change of state basis), and the
 * uniform time rescale t -> t/tau preserves the sign of every eigenvalue's real
 * part and the sign of Vdot.  A is then rationalized (denominators <= 20);
 * the rationalized A (used as the ODE coefficient matrix below) is still Hurwitz
 * (max Re eig = -1.7734e-01) and lies inside the Hurwitz cone of the true
 * balanced linearization.  See
 * numerical/formal_bridge/verify_strong_grid_lyapunov.py and BRIDGE.md.
 *
 * The matrix P below solves  A^T P + P A = -I  EXACTLY over the rationals.
 * Hence along x' = A x the Lie derivative is
 *      Vdot = x^T (A^T P + P A) x = -(x1^2 + x2^2 + x3^2 + x4^2 + x5^2 + x6^2 + x7^2 + x8^2 + x9^2 + x10^2)  <=  0,
 * i.e. V is non-increasing.  P is positive definite (verified EXACTLY by
 * rational LDL^T, min pivot 1.283e-01; entries are rationals with
 * numerator/denominator ~ 1e168, large because the balanced GFL
 * spectrum spans ~7 orders of magnitude -- see BRIDGE.md).
 *
 * NUMERICAL GROUNDING (all in verify_strong_grid_lyapunov.py):
 *   - A (physical) Hurwitz at SCR=2.0; unstable past SCR_H~0.9051  [3+ combos]
 *   - rationalized balanced A Hurwitz                              [float]
 *   - A^T P + P A = -I                                             [exact over Q]
 *   - P > 0                                                        [exact LDL^T]
 *
 * INTERPRETATION / SCOPE.  This is LOCAL (small-signal) stability of the GFL
 * equilibrium in the strong-grid regime, expressed on the linear system in an
 * exact change of variables (balancing + time scale).  It is the linear/Lyapunov
 * companion to the nonlinear weak-grid subcriticality result (l1 > 0) discussed
 * in BRIDGE.md; it does NOT itself address the D2<0 / l1>0 nonlinear question.
 *
 * The Problem encodes:
 *   (positivity)  away from the origin, V > 0   [stated as: sum xi^2 > 0 -> V > 0]
 *   (invariance)  [{x' = A x}] V non-increasing, witnessed against the initial
 *                 value v0 (v0' = 0): V <= v0 is maintained.
 */

ProgramVariables
  Real x1;
  Real x2;
  Real x3;
  Real x4;
  Real x5;
  Real x6;
  Real x7;
  Real x8;
  Real x9;
  Real x10;
  Real v0;
End.

Problem
  (   ( x1^2 + x2^2 + x3^2 + x4^2 + x5^2 + x6^2 + x7^2 + x8^2 + x9^2 + x10^2 > 0 -> ()*x1*x1 + ()*x1*x2 + ()*x1*x3 + ()*x1*x4 + (-)*x1*x5 + (-)*x1*x6 + (-13/32)*x1*x7 + ()*x1*x8 + ()*x1*x9 + ()*x1*x10 + ()*x2*x2 + ()*x2*x3 + ()*x2*x4 + ()*x2*x5 + (-)*x2*x6 + (-)*x2*x7 + (-13/32)*x2*x8 + (-)*x2*x9 + ()*x2*x10 + ()*x3*x3 + ()*x3*x4 + (-)*x3*x5 + (-)*x3*x6 + (-)*x3*x7 + ()*x3*x8 + ()*x3*x9 + ()*x3*x10 + ()*x4*x4 + ()*x4*x5 + (-)*x4*x6 + (-)*x4*x7 + (-)*x4*x8 + (-)*x4*x9 + ()*x4*x10 + ()*x5*x5 + ()*x5*x6 + (-)*x5*x7 + (-)*x5*x8 + (-)*x5*x9 + ()*x5*x10 + ()*x6*x6 + (-)*x6*x7 + (-)*x6*x8 + (-)*x6*x9 + (-)*x6*x10 + ()*x7*x7 + ()*x7*x8 + ()*x7*x9 + (-)*x7*x10 + ()*x8*x8 + ()*x8*x9 + ()*x8*x10 + ()*x9*x9 + (-)*x9*x10 + ()*x10*x10 > 0 )
   &  ( v0 = ()*x1*x1 + ()*x1*x2 + ()*x1*x3 + ()*x1*x4 + (-)*x1*x5 + (-)*x1*x6 + (-13/32)*x1*x7 + ()*x1*x8 + ()*x1*x9 + ()*x1*x10 + ()*x2*x2 + ()*x2*x3 + ()*x2*x4 + ()*x2*x5 + (-)*x2*x6 + (-)*x2*x7 + (-13/32)*x2*x8 + (-)*x2*x9 + ()*x2*x10 + ()*x3*x3 + ()*x3*x4 + (-)*x3*x5 + (-)*x3*x6 + (-)*x3*x7 + ()*x3*x8 + ()*x3*x9 + ()*x3*x10 + ()*x4*x4 + ()*x4*x5 + (-)*x4*x6 + (-)*x4*x7 + (-)*x4*x8 + (-)*x4*x9 + ()*x4*x10 + ()*x5*x5 + ()*x5*x6 + (-)*x5*x7 + (-)*x5*x8 + (-)*x5*x9 + ()*x5*x10 + ()*x6*x6 + (-)*x6*x7 + (-)*x6*x8 + (-)*x6*x9 + (-)*x6*x10 + ()*x7*x7 + ()*x7*x8 + ()*x7*x9 + (-)*x7*x10 + ()*x8*x8 + ()*x8*x9 + ()*x8*x10 + ()*x9*x9 + (-)*x9*x10 + ()*x10*x10
        ->
        [{
    x1' = (-84/5)*x1 + (10)*x5 + (32/13)*x7,
    x2' = (-84/5)*x2 + (10)*x6 + (32/13)*x8,
    x3' = (25/2)*x1 + (22/7)*x4 + (-25/2)*x5,
    x4' = (25/4)*x2 + (-11/14)*x3 + (-9/19)*x4 + (-25/4)*x6 + (-7/15)*x9,
    x5' = (35/4)*x3 + (-2/17)*x4 + (-3/19)*x5 + (11/7)*x6 + (-2/17)*x9 + (9/19)*x10,
    x6' = (248/15)*x4 + (-11/7)*x5 + (-3/19)*x6 + (-15/16)*x9 + (13/5)*x10,
    x7' = (-23/18)*x1,
    x8' = (-23/18)*x2,
    x9' = (41/16)*x4,
    x10' = (43/14)*x4 + (3)*x9,
    v0' = 0
        }]
        ()*x1*x1 + ()*x1*x2 + ()*x1*x3 + ()*x1*x4 + (-)*x1*x5 + (-)*x1*x6 + (-13/32)*x1*x7 + ()*x1*x8 + ()*x1*x9 + ()*x1*x10 + ()*x2*x2 + ()*x2*x3 + ()*x2*x4 + ()*x2*x5 + (-)*x2*x6 + (-)*x2*x7 + (-13/32)*x2*x8 + (-)*x2*x9 + ()*x2*x10 + ()*x3*x3 + ()*x3*x4 + (-)*x3*x5 + (-)*x3*x6 + (-)*x3*x7 + ()*x3*x8 + ()*x3*x9 + ()*x3*x10 + ()*x4*x4 + ()*x4*x5 + (-)*x4*x6 + (-)*x4*x7 + (-)*x4*x8 + (-)*x4*x9 + ()*x4*x10 + ()*x5*x5 + ()*x5*x6 + (-)*x5*x7 + (-)*x5*x8 + (-)*x5*x9 + ()*x5*x10 + ()*x6*x6 + (-)*x6*x7 + (-)*x6*x8 + (-)*x6*x9 + (-)*x6*x10 + ()*x7*x7 + ()*x7*x8 + ()*x7*x9 + (-)*x7*x10 + ()*x8*x8 + ()*x8*x9 + ()*x8*x10 + ()*x9*x9 + (-)*x9*x10 + ()*x10*x10 <= v0 )
  )
End.

