/* For Variant S, F9_S = kappa*(Pref - Pmeas) - b*dw with Pmeas = 3/2*Vg*id.
 * Its gradient w.r.t. the 8 inner states z=(id,iq,vcd,vcq,igd,igq,eta,th):
 *   dF9_S/d(id) = -kappa*3/2*Vg  (the ONLY nonzero inner partial),
 *   dF9_S/d(everything else in z) = 0,
 * i.e. rho^T = dF9_S/dz = -1.5*kappa*Vg * e1^T.  And dF9_S/d(dw) = -b = j99.
 * We verify these partial values from the explicit F9_S expression. */
Problem
  \forall kappa \forall Vg \forall b \forall Pref \forall id \forall dw \forall eps
  (
    /* directional check: F9_S changes in id with slope -1.5 kappa Vg, in dw with slope -b */
    ( kappa*(Pref - 3/2*Vg*(id+eps)) - b*dw ) - ( kappa*(Pref - 3/2*Vg*id) - b*dw )
      = (-kappa*(3/2)*Vg)*eps
    &
    ( kappa*(Pref - 3/2*Vg*id) - b*(dw+eps) ) - ( kappa*(Pref - 3/2*Vg*id) - b*dw )
      = (-b)*eps
  )
End.
