/* @evidence: parse of print of result of a proof */

Lemma "user/Theorem C: angle-coupled slow subsystem is Lyapunov stable".
"  ==>  (((b) > ((0)))&((((beta)*(Ks)) >= ((0)))&(((((beta)*(Ks))*((delta)^((2))))+((dw)^((2)))) <= (v0))))->([{delta'=dw,dw'=(-((b)*(dw)))-(((beta)*(Ks))*(delta))}](((((beta)*(Ks))*((delta)^((2))))+((dw)^((2)))) <= (v0)))
\qed::424cab849cb8d50415ef8f11af2a79a8"
End.
Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "Theorem C: angle-coupled slow subsystem is Lyapunov stable"

/* Augment the swing-anchored reduced model with an angle state delta and an
 * angle->power restoring term:   delta' = dw ,  dw' = -b*dw - beta*Ks*delta ,
 * with b := D/(2H) > 0, beta := wn/(2H) > 0, stiffness Ks >= 0.
 *
 * Lyapunov function  V = beta*Ks*delta^2 + dw^2  (>= 0).
 *   V' = 2*beta*Ks*delta*dw + 2*dw*(-b*dw - beta*Ks*delta) = -2*b*dw^2 <= 0.
 * So every sublevel set of V is invariant: the (delta,dw) subsystem is stable for
 * all b>0, beta*Ks>=0.  Parametric.
 *
 * The oscillation THRESHOLD is a separate real-arithmetic fact (see
 * thmC_oscillation_threshold.kyx): the (delta,dw) eigenvalues are complex iff
 * beta*Ks > b^2/4.  When Ks = 0 (a bare GFL, by the Power Lock) the eigenvalues are
 * {0,-b}, real -- no oscillation.
 *
 * MACHINE-CHECKED: KeYmaera X 5.1.2 reports `proved` (dI, Z3 backend). See
 * ../results/keymaerax_proof_log.txt.
 */

ProgramVariables
  Real delta;
  Real dw;
  Real b;
  Real beta;
  Real Ks;
  Real v0;
End.

Problem
  b > 0 & beta*Ks >= 0 & beta*Ks*delta^2 + dw^2 <= v0
  -> [{ delta' = dw, dw' = -b*dw - beta*Ks*delta }] (beta*Ks*delta^2 + dw^2 <= v0)
End.

Tactic "Lyapunov stability by dI"
  implyR(1) ; dI(1)
End.

End. """"
  tactic """" (implyR(1);dI(1)) """"
  proof """"  """"
End.
