Lemma "user/SMIB passive: H sublevel invariant (symbolic D,K>0)".
"  ==>  \forall D (\forall K ((((D) > ((0)))&(((K) > ((0)))&(((((s)^((2)))+((c)^((2)))) = ((1)))&((((w)^((2)))+((((2))*(K))*(((1))-(c)))) < ((1))))))->([{delta'=w,w'=(-((D)*(w)))-((K)*(s)),s'=(c)*(w),c'=-((s)*(w))&(((s)^((2)))+((c)^((2)))) = ((1))}]((((w)^((2)))+((((2))*(K))*(((1))-(c)))) < ((1))))))
