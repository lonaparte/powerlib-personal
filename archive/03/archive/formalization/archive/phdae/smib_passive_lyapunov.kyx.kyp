Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "SMIB passive: H sublevel invariant (symbolic D,K>0)"

/*
 * Single machine vs infinite bus (damped pendulum):
 *   delta'=w, w'=-D*w-K*sin(delta),  s=sin(delta), c=cos(delta), s^2+c^2=1.
 * H = w^2 + 2K(1-c),  Hdot = -2D w^2 <= 0 for D>0.
 * Sublevel sets of H are positively invariant => Lyapunov stability.
 * Fully parametric in D,K>0.
 */
ProgramVariables Real delta; Real w; Real s; Real c; End.
Problem
  \forall D \forall K (
    D > 0 & K > 0 & s^2+c^2=1 & w^2+2*K*(1-c) < 1
    ->
    [{delta'=w, w'=-D*w-K*s, s'=c*w, c'=-s*w & s^2+c^2=1}]
    w^2+2*K*(1-c) < 1 )
End.
Tactic "Proof" allR(1); allR(1); implyR(1); dI(1) End.
End. """"
  tactic """" (allR(1);allR(1);implyR(1);dI(1)) """"
