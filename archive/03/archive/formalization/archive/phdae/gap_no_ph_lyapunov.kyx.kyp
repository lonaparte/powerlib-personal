/*
 * #4 as a Problem: at d=|D2|=19/20 (inside the gap (d_LMI,1), d_LMI~0.8899),
 * the FULL 3-parameter pH family V = H + h*sin^2(d) + a1*w1*s + a2*w2*s
 * CANNOT yield V'_lin < 0 for ANY (a1,a2,h).
 *
 * M(1) at c=1, D1=K=1, d=19/20:
 *   M00=-2+a1, M01=(a2-a1)/2, M02=(-a1+2h)/2
 *   M11=2d-a2, M12=(a2*d-2h)/2, M22=a2-a1
 *
 * M < 0  iff  -M > 0  iff  all 3 leading minors of -M positive (Sylvester):
 *   LM1 = 2 - a1
 *   LM2 = (-2+a1)(2d-a2) - ((a2-a1)/2)^2
 *   LM3 = det(-M)
 *
 * Claim (gap): for ALL (a1,a2,h), the three minors are NOT all positive.
 * Pure universally-quantified polynomial statement (no exists).
 *
 * NOTE: the gap is intrinsically THIN. The max over (a1,a2,h) of
 * min(LM1,LM2,LM3) is about -1e-5 (margin tiny but strictly negative).
 * QE is exact/symbolic, so thinness affects speed, not correctness.
 *
 * Cleared denominators (d=19/20, signs preserved):
 *   LM2*20  = -5*a1^2 - 10*a1*a2 + 38*a1 - 5*a2^2 + 40*a2 - 76
 *   LM3*400 = -100*a1^3 - 295*a1^2*a2 + 200*a1^2*h + 950*a1^2
 *             + (1141/4)*a1*a2^2 + 10*a1*a2*h + 40*a1*a2 - 760*a1*h
 *             - 1520*a1 + 100*a2^3 - 190*a2^2*h - (1961/2)*a2^2
 *             + 760*a2*h + 1520*a2 - 40*h^2
 */

ProgramVariables
  Real a1;
  Real a2;
  Real h;
End.

Problem
  \forall a1 \forall a2 \forall h (
    2 - a1 <= 0
    | -5*a1^2 - 10*a1*a2 + 38*a1 - 5*a2^2 + 40*a2 - 76 <= 0
    | -100*a1^3 - 295*a1^2*a2 + 200*a1^2*h + 950*a1^2
        + 1141*a1*a2^2/4 + 10*a1*a2*h + 40*a1*a2 - 760*a1*h
        - 1520*a1 + 100*a2^3 - 190*a2^2*h - 1961*a2^2/2
        + 760*a2*h + 1520*a2 - 40*h^2 <= 0)
End.

Tactic "Proof"
  QE
End.

