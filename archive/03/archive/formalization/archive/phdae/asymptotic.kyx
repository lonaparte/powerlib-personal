ArchiveEntry "pH Asymptotic Approach"

/*
 * A weaker form of asymptotic stability:
 * If the system starts with energy H < eps,
 * then H is non-increasing (already proved),
 * AND the dissipation is strictly related to omega.
 *
 * Full asymptotic stability in dL requires Tan-Platzer's
 * advanced tactics (dV, ODE liveness). Here we verify
 * the invariance of decreasing energy shells:
 * For any target < eps, if H reaches target, it stays below.
 */

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

Problem
  \forall D1 \forall D2 \forall K \forall eps \forall target (
    D1 > 0 & D2 > 0 & K > 0 &
    eps > 0 & target > 0 & target <= eps &
    s^2 + c^2 = 1 &
    w1^2 + w2^2 + 2*K*(1 - c) < target
    ->
    [{d1' = w1,
      d2' = w2,
      w1' = -D1*w1 - K*s,
      w2' = -D2*w2 + K*s,
      s'  = c*(w1 - w2),
      c'  = -s*(w1 - w2)}]
    w1^2 + w2^2 + 2*K*(1 - c) < target
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1); allR(1); allR(1);
  implyR(1);
  dI(1)
End.

End.
