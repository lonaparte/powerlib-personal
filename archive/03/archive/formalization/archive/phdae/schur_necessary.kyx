ArchiveEntry "Necessity: Coupling too weak implies pH breaks"

ProgramVariables
  Real j;
  Real r1;
  Real r2;
End.

/* If j^2 + r1*r2 < 0 (coupling too weak), then R_eff < 0 (pH broken) */
/* j^2 < r1*|r2| means coupling cannot compensate negative damping */

Problem
  \forall j \forall r1 \forall r2 (
    r1 > 0 & r2 < 0 & j*j + r1*r2 < 0
    -> r1*r2*r2 + j*j*r2 > 0
  )
End.

Tactic "Proof"
  QE
End.

End.
