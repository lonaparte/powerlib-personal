/* @evidence: parse of print of result of a proof */

Lemma "user/Two-Machine Nonlinear pH Stability".
"  ==>  ((((((s)^((2)))+((c)^((2)))) = ((1)))&((c) <= ((1))))&((((((1))*((w1)^((2))))+(((1))*((w2)^((2)))))+((((2))*((1)))*(((1))-(c)))) < ((1))))->([{d1'=w1,d2'=w2,w1'=(-((((1))/((1)))*(w1)))-((((1))/((1)))*(s)),w2'=(-((((1))/((1)))*(w2)))+((((1))/((1)))*(s)),s'=(c)*((w1)-(w2)),c'=-((s)*((w1)-(w2)))}]((((((1))*((w1)^((2))))+(((1))*((w2)^((2)))))+((((2))*((1)))*(((1))-(c)))) < ((1))))
\qed::51e17a1acbf506bee155673f8b81e245"
End.
Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "Two-Machine Nonlinear pH Stability"

/*
 * In dL, sin/cos are not built-in functions.
 * We introduce auxiliary variables s = sin(d1-d2), c = cos(d1-d2)
 * that evolve according to their ODE: s' = c*(d1'-d2'), c' = -s*(d1'-d2')
 *
 * H = J1*w1^2 + J2*w2^2 + 2*K*(1 - c)
 * Lie derivative = -2*D1*w1^2 - 2*D2*w2^2 <= 0
 */

Definitions
  Real J1 = 1;
  Real J2 = 1;
  Real D1 = 1;
  Real D2 = 1;
  Real K  = 1;
End.

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;  /* sin(d1-d2) */
  Real c;  /* cos(d1-d2) */
End.

Problem
  (s^2 + c^2 = 1 & c <= 1) &
  J1*w1^2 + J2*w2^2 + 2*K*(1 - c) < 1
  ->
  [{d1' = w1,
    d2' = w2,
    w1' = -D1/J1*w1 - K/J1*s,
    w2' = -D2/J2*w2 + K/J2*s,
    s'  = c*(w1 - w2),
    c'  = -s*(w1 - w2)}]
  J1*w1^2 + J2*w2^2 + 2*K*(1 - c) < 1
End.

Tactic "Proof"
  implyR(1);
  dI(1)
End.

End. """"
  tactic """" (implyR(1);dI(1)) """"
  proof """"  """"
End.
