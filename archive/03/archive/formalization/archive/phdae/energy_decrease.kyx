ArchiveEntry "Strict Energy Decrease"

/*
 * Proves: if omega != 0 initially, then energy strictly decreases.
 * Specifically: H(t) < H(0) for all t > 0 along the ODE.
 *
 * We use dC to cut in the energy bound, combined with
 * the fact that dH/dt = -2*D*(w1^2 + w2^2) < 0 when w != 0.
 *
 * This is the "strict decrease away from V_dot = 0 set" property
 * needed for LaSalle-type arguments.
 */

ProgramVariables
  Real w1;
  Real w2;
  Real d1;
  Real d2;
  Real s;
  Real c;
  Real h0;
End.

Problem
  s^2 + c^2 = 1 &
  h0 = w1^2 + w2^2 + 2*(1 - c) &
  (w1 != 0 | w2 != 0) &
  h0 > 0
  ->
  [{d1' = w1,
    d2' = w2,
    w1' = -w1 - s,
    w2' = -w2 + s,
    s'  = c*(w1 - w2),
    c'  = -s*(w1 - w2),
    h0' = 0}]
  w1^2 + w2^2 + 2*(1 - c) <= h0
End.

Tactic "Proof"
  implyR(1);
  dI(1)
End.

End.
