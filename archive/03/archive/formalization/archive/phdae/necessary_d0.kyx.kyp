Lemma "user/Necessity: D=0 implies energy conservation (general)".
"  ==>  \forall K (((K) > ((0)))->((((((s)^((2)))+((c)^((2)))) = ((1)))&(((h0) = ((((w1)^((2)))+((w2)^((2))))+((((2))*(K))*(((1))-(c)))))&((h0) > ((0)))))->([{d1'=w1,d2'=w2,w1'=-((K)*(s)),w2'=(K)*(s),s'=(c)*((w1)-(w2)),c'=-((s)*((w1)-(w2))),h0'=(0)&(((s)^((2)))+((c)^((2)))) = ((1))}](((((w1)^((2)))+((w2)^((2))))+((((2))*(K))*(((1))-(c)))) = (h0)))))
\qed::02757709ad57b7eb2478c7b47f678fe4"
End.
Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "Necessity: D=0 implies energy conservation (general)"

/*
 * If D = 0 (no damping), energy is exactly conserved.
 *
 * H = w1^2 + w2^2 + 2*K*(1-c)
 * Hdot = 2*w1*(-K*s) + 2*w2*(K*s) + 2*K*s*(w1-w2)
 *      = -2*K*w1*s + 2*K*w2*s + 2*K*s*w1 - 2*K*s*w2
 *      = 0
 *
 * Since H is constant, the system cannot be asymptotically stable
 * (trajectories with H(0) > 0 never reach the origin).
 *
 * This proof is for symbolic K > 0 (not just K = 1).
 */

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
  Real h0;
End.

Problem
  \forall K (K > 0 ->
    (s^2 + c^2 = 1 &
     h0 = w1^2 + w2^2 + 2*K*(1-c) &
     h0 > 0
     ->
     [{d1' = w1,
       d2' = w2,
       w1' = -K*s,
       w2' = K*s,
       s'  = c*(w1 - w2),
       c'  = -s*(w1 - w2),
       h0' = 0
       & s^2 + c^2 = 1}]
     w1^2 + w2^2 + 2*K*(1-c) = h0))
End.

Tactic "Proof"
  allR(1);
  implyR(1); implyR(1);
  dI(1)
End.

End. """"
  tactic """" (allR(1);implyR(1);implyR(1);dI(1)) """"
  proof """"  """"
End.
