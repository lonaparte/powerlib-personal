ArchiveEntry "Gap (PARAMETRIC in d): no 3-param pH function for d in [9/10,1)"

/* KeYmaera X STATUS: NOT machine-verified. QE timed out (>360s) on this
 * forall-in-d formulation (4 variables, intrinsically thin gap margin
 * ~-3e-6). The single-instance version (gap_no_ph_lyapunov.kyx, d=19/20) IS verified. The d-band
 * boundary is an algebraic number, so a clean forall-d QE is out of reach. */

/*
 * PARAMETRIC version of #4 (no fixed d).
 * 3-parameter pH family V = H + h*sin^2 + a1*w1*s + a2*w2*s, D1=K=1, D2=-d.
 *
 * Claim: for ALL (a1,a2,h) and ALL d with 9/10 <= d < 1, the three leading
 * minors of -M(1) are NOT all positive (so M(1) is never <0, no pH Lyapunov
 * function exists). 9/10 is a clean rational bound above d_LMI ~ 0.8899.
 *
 * Pure forall QE in 4 variables (a1,a2,h,d). The gap margin is intrinsically
 * THIN (~3e-6 worst on this band), so QE may be very slow or time out.
 *
 * Minors (cleared, signs preserved):
 *   LM1   = 2 - a1
 *   LM2*4 = -a1^2 - 2 a1 a2 + 8 a1 d - a2^2 + 8 a2 - 16 d
 *   LM3*8 = -2a1^3 - 2a1^2 a2 d - 4a1^2 a2 + 20a1^2 d + 4a1^2 h
 *           + 2a1 a2^2 d^2 + 2a1 a2^2 d + 2a1 a2^2 - 4a1 a2 d h - 16a1 a2 d
 *           + 4a1 a2 h + 16a1 a2 - 16a1 d h - 32a1 d + 2a2^3 - 4a2^2 d^2
 *           - 4a2^2 d h - 16a2^2 + 16a2 d h + 32a2 d + 16 d h^2 - 16 h^2
 */

ProgramVariables
  Real a1;
  Real a2;
  Real h;
  Real d;
End.

Problem
  \forall a1 \forall a2 \forall h \forall d (
    ( d >= 9/10 & d < 1 )
    ->
    ( 2 - a1 <= 0
    | -a1^2 - 2*a1*a2 + 8*a1*d - a2^2 + 8*a2 - 16*d <= 0
    | -2*a1^3 - 2*a1^2*a2*d - 4*a1^2*a2 + 20*a1^2*d + 4*a1^2*h
        + 2*a1*a2^2*d^2 + 2*a1*a2^2*d + 2*a1*a2^2 - 4*a1*a2*d*h - 16*a1*a2*d
        + 4*a1*a2*h + 16*a1*a2 - 16*a1*d*h - 32*a1*d + 2*a2^3 - 4*a2^2*d^2
        - 4*a2^2*d*h - 16*a2^2 + 16*a2*d*h + 32*a2*d + 16*d*h^2 - 16*h^2 <= 0 ) )
End.

Tactic "Proof"
  QE
End.

End.
