/-
  SCR-Hopf — the CONCRETE Hopf-boundary polynomial, machine-checked root (NOT abstract aᵢ).  The earlier
  files prove "IF coefficients aᵢ satisfy conditions THEN a Hopf exists", with aᵢ left ABSTRACT.  This
  file INSTANTIATES the aᵢ with the actual 4D P-only GFL model and reduces to one explicit univariate
  polynomial: F₀,F₁ are linear in (i_d,i_q) ⟹ solved; the PLL lock F₂=0 and the Routh–Hurwitz Hopf
  condition χ₄=0 are reduced via Weierstrass t=tan(θ_e/2) to a single resultant in t, whose physical
  factor `pHopf(Lg) ∈ ℤ[Lg]` (degree 16; the raw resultant is degree 22 = Lg⁶·pHopf, the Lg⁶ being
  unphysical Lg=0 roots) has positive roots = the Hopf boundaries.  Lean then proves, by `norm_num` on the
  explicit (621-digit) coefficients + IVT, that `pHopf` has a real root in `(0.1214, 0.1215)`.

   * `pHopf` — the explicit degree-16 Hopf-boundary polynomial (CAS-eliminated integer coefficients).
   * `pHopf_neg` / `pHopf_pos` — `pHopf(0.1214) < 0 < pHopf(0.1215)` by `norm_num` (concrete; no abstract aᵢ).
   * `pHopf_hopf_root` — `∃ Lg ∈ (0.1214,0.1215), pHopf(Lg)=0` by `intermediate_value_Ioo`: a CONCRETE Hopf
     boundary of the GFL-parameter model, not an "if-then".  (The raw resultant degree 22 MATCHES the
     A-route's claimed degree-22 Lg polynomial.)

  SCOPE (honest).  (1) LOSSLESS model at RATIONAL SURROGATES of the GFL baseline (Vg=3103/10≈760/√6,
  wn=314159/1000≈100π, Lf=1/1000, Kpi=126/100, Kp_pll=573/1000, Ki_pll=509/10, Kp_P=Kp_Q=215/10⁶,
  P_ref=37200).  The root Lg*≈0.12144 ⟹ a physical-range SCR, but NOT the A-route's lossy SCR≈0.0346
  (that needs the LOSSY model + EXACT irrational params, whose elimination is the 388-digit Singular
  oracle — same method, beyond sympy in this sandbox).  (2) `pHopf` is reproduced by sympy (resultant
  elimination), NOT Singular; the coefficients are data.  (3) The link "pHopf(Lg*)=0 ⟺ the 4D system has
  a Hopf at Lg*" is BY CONSTRUCTION (resultant) + NUMERICAL cross-validation (verify_hopf_elim.py: at
  Lg*≈0.12144 the Jacobian has a pure-imaginary pair λ≈84.2i, maxRe crosses 0, all aᵢ>0 ⟹ genuine, root
  matches to 1e-6) — it is NOT proven inside Lean (the ideal-membership "T2" step; out of scope).  What
  Lean certifies: the explicit polynomial has the stated real root.  This is the concrete instantiation
  the abstract-aᵢ files lacked; the residual gap to the exact lossy 0.0346 is exact-param elimination
  (Singular), not a Lean gap.
-/
import GFL.ScrAxis

namespace GFL
open Polynomial Set
set_option linter.unusedVariables false
set_option maxHeartbeats 8000000

/-- The explicit degree-16 Hopf-boundary polynomial `pHopf(Lg)` of the lossless 4D P-only GFL at
rational surrogates of the GFL baseline params, from eliminating the equilibrium (linear i_d,i_q
solve + Weierstrass + resultant; physical factor of the degree-22 raw resultant).  Coefficients are
CAS-eliminated integers (data); its positive root ≈0.12144 is the Hopf boundary. -/
noncomputable def pHopf : Polynomial ℝ :=
    C ( : ℝ) * X ^ 16
    + C ( : ℝ) * X ^ 15
    + C ( : ℝ) * X ^ 14
    + C ( : ℝ) * X ^ 13
    + C ( : ℝ) * X ^ 12
    + C (- : ℝ) * X ^ 11
    + C ( : ℝ) * X ^ 10
    + C (- : ℝ) * X ^ 9
    + C ( : ℝ) * X ^ 8
    + C (- : ℝ) * X ^ 7
    + C ( : ℝ) * X ^ 6
    + C (- : ℝ) * X ^ 5
    + C ( : ℝ) * X ^ 4
    + C (- : ℝ) * X ^ 3
    + C (- : ℝ) * X ^ 2
    + C ( : ℝ) * X
    + C (- : ℝ)

/-- `pHopf(0.1214) < 0` — concrete (`norm_num` on the 621-digit coefficients). -/
theorem pHopf_neg : pHopf.eval (1214 / 10000) < 0 := by
  simp only [pHopf, eval_add, eval_mul, eval_pow, eval_C, eval_X]
  norm_num

/-- `0 < pHopf(0.1215)` — concrete (`norm_num`). -/
theorem pHopf_pos : 0 < pHopf.eval (1215 / 10000) := by
  simp only [pHopf, eval_add, eval_mul, eval_pow, eval_C, eval_X]
  norm_num

/-- **Concrete Hopf boundary (NOT abstract).**  `pHopf` has a real root in `(0.1214, 0.1215)` —
`∃ Lg, pHopf(Lg)=0`, the Hopf boundary of the actual GFL-parameter model, by IVT on the explicit
polynomial.  This is the instantiation the abstract-aᵢ chain lacked. -/
theorem pHopf_hopf_root : ∃ Lg ∈ Set.Ioo (1214 / 10000 : ℝ) (1215 / 10000), pHopf.eval Lg = 0 := by
  have hmem : (0 : ℝ) ∈ Set.Ioo (pHopf.eval (1214 / 10000)) (pHopf.eval (1215 / 10000)) :=
    ⟨pHopf_neg, pHopf_pos⟩
  obtain ⟨Lg, hLg, hev⟩ :=
    intermediate_value_Ioo (by norm_num) pHopf.continuous.continuousOn hmem
  exact ⟨Lg, hLg, hev⟩

/-! ### T5 — tight numerical anchor + concrete SCR boundary (lossless surrogate, zfac=1) -/

/-- `pHopf(0.121444) < 0` — tight endpoint (`norm_num`). -/
theorem pHopf_neg_tight : pHopf.eval (121444 / 1000000) < 0 := by
  simp only [pHopf, eval_add, eval_mul, eval_pow, eval_C, eval_X]
  norm_num

/-- `0 < pHopf(0.121445)` — tight endpoint (`norm_num`). -/
theorem pHopf_pos_tight : 0 < pHopf.eval (121445 / 1000000) := by
  simp only [pHopf, eval_add, eval_mul, eval_pow, eval_C, eval_X]
  norm_num

/-- **Tight anchor (T5).**  `pHopf` has a root in `(121444/10⁶, 121445/10⁶)`, i.e. `|Lg*−0.121444| < 10⁻⁶`. -/
theorem pHopf_root_tight :
    ∃ Lg ∈ Set.Ioo (121444 / 1000000 : ℝ) (121445 / 1000000), pHopf.eval Lg = 0 := by
  obtain ⟨Lg, hLg, hev⟩ :=
    intermediate_value_Ioo (by norm_num) pHopf.continuous.continuousOn ⟨pHopf_neg_tight, pHopf_pos_tight⟩
  exact ⟨Lg, hLg, hev⟩

/-- **Concrete SCR boundary (T5).**  Lossless ⟹ X/R=∞ ⟹ impedance factor `zfac=1`, so the surrogate
`SCR(Lg) = Vn²/(Sn·Lg·wn) = 1444/(314159·Lg)` (Vn=380, Sn=10⁵, wn=314159/1000) is strictly decreasing;
the Hopf `SCR*` therefore lies in the explicit interval `(scrOfLg .. 0.121445, scrOfLg .. 0.121444)`
(≈ 0.037845).  A CONCRETE SCR boundary NUMBER for the model — not abstract, not an assumed sign. -/
theorem pHopf_scr_bracket :
    ∃ Lg, scrOfLg 380 100000 (314159 / 1000) 1 Lg
        ∈ Set.Ioo (scrOfLg 380 100000 (314159 / 1000) 1 (121445 / 1000000))
                  (scrOfLg 380 100000 (314159 / 1000) 1 (121444 / 1000000))
      ∧ pHopf.eval Lg = 0 := by
  obtain ⟨Lg, hLg, hev⟩ := pHopf_root_tight
  have hpos : (0 : ℝ) < Lg := lt_trans (by norm_num) hLg.1
  have hanti := scrOfLg_strictAntiOn 380 100000 (314159 / 1000) 1
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
  refine ⟨Lg, ⟨?_, ?_⟩, hev⟩
  · exact hanti (Set.mem_Ioi.mpr hpos) (Set.mem_Ioi.mpr (by norm_num)) hLg.2
  · exact hanti (Set.mem_Ioi.mpr (by norm_num)) (Set.mem_Ioi.mpr hpos) hLg.1

end GFL
