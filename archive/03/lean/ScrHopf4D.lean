      = ((1:ℝ)*J01*J10*J11*gθ^3*Kp_pll^3 - (1:ℝ)*J00*J11^2*gθ^3*Kp_pll^3 + (1:ℝ)*J00*J01*J10*gθ^3*Kp_pll^3 - (1:ℝ)*J00^2*J11*gθ^3*Kp_pll^3 + (1:ℝ)*J11^2*gθ^3*Kp_pll^2*Ki_pll - (1:ℝ)*J01*J10*J11^2*gθ^2*Kp_pll^2 + (2:ℝ)*J00*J11*gθ^3*Kp_pll^2*Ki_pll + (1:ℝ)*J00*J11^3*gθ^2*Kp_pll^2 - (2:ℝ)*J00*J01*J10*J11*gθ^2*Kp_pll^2 + (1:ℝ)*J00^2*gθ^3*Kp_pll^2*Ki_pll + (2:ℝ)*J00^2*J11^2*gθ^2*Kp_pll^2 - (1:ℝ)*J00^2*J01*J10*gθ^2*Kp_pll^2 + (1:ℝ)*J00^3*J11*gθ^2*Kp_pll^2 - (1:ℝ)*J11*gθ^3*Kp_pll*Ki_pll^2 - (1:ℝ)*J11^3*gθ^2*Kp_pll*Ki_pll - (2:ℝ)*J01*J10*J11*gθ^2*Kp_pll*Ki_pll - (1:ℝ)*J01^2*J10^2*J11*gθ*Kp_pll - (1:ℝ)*J00*gθ^3*Kp_pll*Ki_pll^2 - (1:ℝ)*J00*J11^2*gθ^2*Kp_pll*Ki_pll - (2:ℝ)*J00*J01*J10*gθ^2*Kp_pll*Ki_pll + (2:ℝ)*J00*J01*J10*J11^2*gθ*Kp_pll - (1:ℝ)*J00*J01^2*J10^2*gθ*Kp_pll - (1:ℝ)*J00^2*J11*gθ^2*Kp_pll*Ki_pll - (1:ℝ)*J00^2*J11^3*gθ*Kp_pll + (2:ℝ)*J00^2*J01*J10*J11*gθ*Kp_pll - (1:ℝ)*J00^3*gθ^2*Kp_pll*Ki_pll - (1:ℝ)*J00^3*J11^2*gθ*Kp_pll) + (- (1:ℝ)*J03*J11*J13*J20*J21*gθ*Kp_pll^3 + (1:ℝ)*J03*J11^2*J20*gθ^2*Kp_pll^3 + (1:ℝ)*J03*J10*J13*J21^2*gθ*Kp_pll^3 - (1:ℝ)*J03*J10*J11*J21*gθ^2*Kp_pll^3 - (1:ℝ)*J03^2*J11*J20^2*gθ*Kp_pll^3 + (1:ℝ)*J03^2*J10*J20*J21*gθ*Kp_pll^3 + (1:ℝ)*J01*J13^2*J20*J21*gθ*Kp_pll^3 - (1:ℝ)*J01*J11*J13*J20*gθ^2*Kp_pll^3 - (1:ℝ)*J01*J10*J13*J21*gθ^2*Kp_pll^3 + (1:ℝ)*J01*J03*J13*J20^2*gθ*Kp_pll^3 - (1:ℝ)*J01*J03*J10*J20*gθ^2*Kp_pll^3 - (1:ℝ)*J00*J13^2*J21^2*gθ*Kp_pll^3 + (2:ℝ)*J00*J11*J13*J21*gθ^2*Kp_pll^3 - (1:ℝ)*J00*J03*J13*J20*J21*gθ*Kp_pll^3 + (2:ℝ)*J00*J03*J11*J20*gθ^2*Kp_pll^3 - (1:ℝ)*J00*J03*J10*J21*gθ^2*Kp_pll^3 - (1:ℝ)*J00*J01*J13*J20*gθ^2*Kp_pll^3 + (1:ℝ)*J00^2*J13*J21*gθ^2*Kp_pll^3 + (1:ℝ)*J13^2*J21^2*gθ*Kp_pll^2*Ki_pll - (2:ℝ)*J11*J13*J21*gθ^2*Kp_pll^2*Ki_pll + (2:ℝ)*J03*J13*J20*J21*gθ*Kp_pll^2*Ki_pll - (2:ℝ)*J03*J11*J20*gθ^2*Kp_pll^2*Ki_pll + (1:ℝ)*J03*J11^2*J13*J20*J21*Kp_pll^2 - (1:ℝ)*J03*J11^3*J20*gθ*Kp_pll^2 - (1:ℝ)*J03*J10*J11*J13*J21^2*Kp_pll^2 + (1:ℝ)*J03*J10*J11^2*J21*gθ*Kp_pll^2 + (1:ℝ)*J03^2*J20^2*gθ*Kp_pll^2*Ki_pll + (1:ℝ)*J03^2*J10*J11*J20