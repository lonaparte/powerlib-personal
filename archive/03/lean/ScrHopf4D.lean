/-
  SCR-Hopf — the explicit 4D χ₄ decomposition (T_DIM4), parametric.  Completes ScrHopfExist's 3D `chi3`
  with the deg-4 analogue: the Routh–Hurwitz Hopf quantity χ₄ of the 4D droop Jacobian splits into a
  fold-bound part (∝ gθ, the err=0 / references-met case) and a DROOP part injected by the tracking
  error (∝ J03,J13 ∝ (Kpi/Lf)·err_P*).  All `ring`; abstract in the Jacobian entries.

  M4droop (rows/cols i_d,i_q,η,θ_e; extends M3droop by the i_d state, row/col 0; the lone −Ki_pll
  in col 2 is the PLL integrator, J03,J13 ≠ 0 in col 3 = the θ_e→current droop injection):
    [[J00,J01,0,J03],[J10,J11,0,J13],[J20,J21,0,gθ],[−Kp_pll·J20,−Kp_pll·J21,−Ki_pll,−Kp_pll·gθ]]
  char poly λ⁴+a₁λ³+a₂λ²+a₃λ+a₄, a_i from the CAS charpoly (gen_chi4_lean.py) and GROUNDED in Lean by
  `M4droop_charpoly` (4×4 det via `det_succ_row_zero`+`det_fin_three`) — the a₁..a₄ that χ₄ decomposes
  are PROVED to be M4droop's actual char-poly coefficients, not asserted.  χ₄:=a₁a₂a₃−a₃²−a₁²a₄.
-/
import GFL.ScrHopfExist

namespace GFL
open Matrix
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxHeartbeats 8000000

/-- **M4droop — the 4D droop Jacobian.**  Extends `M3droop` by the i_d state (row/col 0).  States
`(i_d, i_q, η, θ_e)`; col 2's lone `−Ki_pll` is the PLL integrator, `J03,J13` (col 3) are the
`θ_e→current` couplings ∝ `(Kpi/Lf)·err_P*` — the droop injection that breaks the err=0 factorisation. -/
noncomputable def M4droop (J00 J01 J03 J10 J11 J13 J20 J21 gθ Kp_pll Ki_pll : ℝ) : Matrix (Fin 4) (Fin 4) ℝ :=
  !![J00, J01, 0, J03; J10, J11, 0, J13; J20, J21, 0, gθ;
     -Kp_pll * J20, -Kp_pll * J21, -Ki_pll, -Kp_pll * gθ]

/-- **M4droop char poly (GROUNDING).**  `det(λI − M4droop) = λ⁴ + a₁λ³ + a₂λ² + a₃λ + a₄` with the
literal `a₁..a₄` that `chi4_droop_decomp` feeds to χ₄ — so those coefficients are PROVED to be the
4D droop Jacobian's char-poly coefficients (4×4 `det_succ_row_zero`+`det_fin_three`), not asserted. -/
theorem M4droop_charpoly (J00 J01 J03 J10 J11 J13 J20 J21 gθ Kp_pll Ki_pll lam : ℝ) :
    (lam • (1 : Matrix (Fin 4) (Fin 4) ℝ) - M4droop J00 J01 J03 J10 J11 J13 J20 J21 gθ Kp_pll Ki_pll).det
      = lam ^ 4 + ((1:ℝ)*gθ*Kp_pll - (1:ℝ)*J11 - (1:ℝ)*J00) * lam ^ 3 + ((1:ℝ)*J13*J21*Kp_pll - (1:ℝ)*J11*gθ*Kp_pll + (1:ℝ)*J03*J20*Kp_pll - (1:ℝ)*J00*gθ*Kp_pll + (1:ℝ)*gθ*Ki_pll - (1:ℝ)*J01*J10 + (1:ℝ)*J00*J11) * lam ^ 2 + (- (1:ℝ)*J03*J11*J20*Kp_pll + (1:ℝ)*J03*J10*J21*Kp_pll + (1:ℝ)*J01*J13*J20*Kp_pll - (1:ℝ)*J01*J10*gθ*Kp_pll - (1:ℝ)*J00*J13*J21*Kp_pll + (1:ℝ)*J00*J11*gθ*Kp_pll + (1:ℝ)*J13*J21*Ki_pll - (1:ℝ)*J11*gθ*Ki_pll + (1:ℝ)*J03*J20*Ki_pll - (1:ℝ)*J00*gθ*Ki_pll) * lam + (- (1:ℝ)*J03*J11*J20*Ki_pll + (1:ℝ)*J03*J10*J21*Ki_pll + (1:ℝ)*J01*J13*J20*Ki_pll - (1:ℝ)*J01*J10*gθ*Ki_pll - (1:ℝ)*J00*J13*J21*Ki_pll + (1:ℝ)*J00*J11*gθ*Ki_pll) := by
  have hM : lam • (1 : Matrix (Fin 4) (Fin 4) ℝ) - M4droop J00 J01 J03 J10 J11 J13 J20 J21 gθ Kp_pll Ki_pll
      = !![lam - J00, -J01, 0, -J03; -J10, lam - J11, 0, -J13; -J20, -J21, lam, -gθ;
           Kp_pll * J20, Kp_pll * J21, Ki_pll, lam + Kp_pll * gθ] := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [M4droop, Matrix.sub_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
  rw [hM]
  simp [Matrix.det_succ_row_zero (n := 3), Matrix.det_fin_three,
    Finset.sum_fin_eq_sum_range, Finset.sum_range_succ, Fin.succAbove]
  ring

/-- **χ₄ decomposition (T_DIM4).**  `χ₄ = a₁a₂a₃−a₃²−a₁²a₄ = (err=0 part, ∝ gθ) + (droop term,
∝ J03,J13)`.  The first summand is fold-bound (vanishes at gθ=0); the second is injected by the
tracking error (J03,J13 ≠ 0) and vanishes at J03=J13=0 — the deg-4 analogue of `chi3_droop_decomp`. -/
