    ((1:ℝ)*gθ*Kp_pll - (1:ℝ)*J11 - (1:ℝ)*J00) * ((1:ℝ)*J13*J21*Kp_pll - (1:ℝ)*J11*gθ*Kp_pll + (1:ℝ)*J03*J20*Kp_pll - (1:ℝ)*J00*gθ*Kp_pll + (1:ℝ)*gθ*Ki_pll - (1:ℝ)*J01*J10 + (1:ℝ)*J00*J11) * (- (1:ℝ)*J03*J11*J20*Kp_pll + (1:ℝ)*J03*J10*J21*Kp_pll + (1:ℝ)*J01*J13*J20*Kp_pll - (1:ℝ)*J01*J10*gθ*Kp_pll - (1:ℝ)*J00*J13*J21*Kp_pll + (1:ℝ)*J00*J11*gθ*Kp_pll + (1:ℝ)*J13*J21*Ki_pll - (1:ℝ)*J11*gθ*Ki_pll + (1:ℝ)*J03*J20*Ki_pll - (1:ℝ)*J00*gθ*Ki_pll) - (- (1:ℝ)*J03*J11*J20*Kp_pll + (1:ℝ)*J03*J10*J21*Kp_pll + (1:ℝ)*J01*J13*J20*Kp_pll - (1:ℝ)*J01*J10*gθ*Kp_pll - (1:ℝ)*J00*J13*J21*Kp_pll + (1:ℝ)*J00*J11*gθ*Kp_pll + (1:ℝ)*J13*J21*Ki_pll - (1:ℝ)*J11*gθ*Ki_pll + (1:ℝ)*J03*J20*Ki_pll - (1:ℝ)*J00*gθ*Ki_pll) ^ 2 - ((1:ℝ)*gθ*Kp_pll - (1:ℝ)*J11 - (1:ℝ)*J00) ^ 2 * (- (1:ℝ)*J03*J11*J20*Ki_pll + (1:ℝ)*J03*J10*J21*Ki_pll + (1:ℝ)*J01*J13*J20*Ki_pll - (1:ℝ)*J01*J10*gθ*Ki_pll - (1:ℝ)*J00*J13*J21*Ki_pll + (1:ℝ)*J00*J11*gθ*Ki_pll)
      = ((1:ℝ)*J01*J10*J11*gθ^3*Kp_pll^3 - (1:ℝ)*J00*J11^2*gθ^3*Kp_pll^3 + (1:ℝ)*J00*J01*J10*gθ^3*Kp_pll^3 - (1:ℝ)*J00^2*J11*gθ^3*Kp_pll^3 + (1:ℝ)*J11^2*gθ^3*Kp_pll^2*Ki_pll - (1:ℝ)*J01*J10*J11^2*gθ^2*Kp_pll^2 + (2:ℝ)*J00*J11*gθ^3*Kp_pll^2*Ki_pll + (1:ℝ)*J00*J11^3*gθ^2*Kp_pll^2 - (2:ℝ)*J00*J01*J10*J11*gθ^2*Kp_pll^2 + (1:ℝ)*J00^2*gθ^3*Kp_pll^2*Ki_pll + (2:ℝ)*J00^2*J11^2*gθ^2*Kp_pll^2 - (1:ℝ)*J00^2*J01*J10*gθ^2*Kp_pll^2 + (1:ℝ)*J00^3*J11*gθ^2*Kp_pll^2 - (1:ℝ)*J11*gθ^3*Kp_pll*Ki_pll^2 - (1:ℝ)*J11^3*gθ^2*Kp_pll*Ki_pll - (2:ℝ)*J01*J10*J11*gθ^2*Kp_pll*Ki_pll - (1:ℝ)*J01^2*J10^2*J11*gθ*Kp_pll - (1:ℝ)*J00*gθ^3*Kp_pll*Ki_pll^2 - (1:ℝ)*J00*J11^2*gθ^2*Kp_pll*Ki_pll - (2:ℝ)*J00*J01*J10*gθ^2*Kp_pll*Ki_pll + (2:ℝ)*J00*J01*J10*J11^2*gθ*Kp_pll - (1:ℝ)*J00*J01^2*J10^2*gθ*Kp_pll - (1:ℝ)*J00^2*J11*gθ^2*Kp_pll*Ki_pll - (1:ℝ)*J00^2*J11^3*gθ*Kp_pll + (2:ℝ)*J00^2*J01*J10*J11*gθ*Kp_pll - (1:ℝ)*J00^3*gθ^2*Kp_pll*Ki_pll - (1:ℝ)*J00^3*J11^2*gθ*Kp_pll) := by subst hP hQ; ring

/-- **4D genuine Hopf (T_DIM4 + genuineness).**  If the 4D droop char-poly coefficients satisfy
`a₁>0, a₃>0` and the Hopf condition `χ₄ = 0`, then there is a GENUINE pure-imaginary pair `±iω`
