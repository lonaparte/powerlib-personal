import powerlib

/-! # Index of the library's connection statements

Every typed connection statement `connection% P` of a `theorem.*` module is filed under one
category, read from the constants occurring in its proposition `P` (the implicit argument of
`TMIO.Statement`):

* `observation`: what observations certify or predict about models, or the observation
  closure. `P` mentions a member of `TMIO.Seed` (`u₃`, `uTO`, …), `TMIO.certify`,
  `TMIO.possibly` or `TMIO.predict`.
* `translation`: the requirement translation compared with the semantics (exactness, soundness,
  the translation chain against the semantics connection). `P` mentions `Family.chain`,
  `Family.Exact`, `Family.ExactUnder`, `Family.Sound`, `Family.SoundUnder`, `Family.translate`,
  `TMIO.ExactUnder` or `TMIO.cover`; or it compares a requirement space with a denotation
  without naming the translation (a `requirementSpace` and a `denotation` constant together,
  e.g. `realize Meets Γ ≠ F.den s`).
* `requirementSpace`: which models meet given requirements, the space generated by requirement
  satisfaction. `P` mentions `TMIO.realize` or `TMIO.satisfaction`.
* `denotation`: which models satisfy a sentence. `P` mentions `Family.den`, `Family.semantics`
  or `Family.Holds`.

The first matching category in this order is the statement's category, so the categories
partition the statements: an observation usually observes a denotation, and a translation
comparison mentions the semantics or a requirement space. Compiling this module checks that
every statement is filed (`POWERLIB_TMIO_INDEX_OK`).

Usage. After `lake build`, write a file anywhere in the workspace, for example

```
import dependencies.tests.lean.Library.TMIOIndex

#tmio_edges                -- number of statements in each category
#tmio_edges translation    -- every statement of one category, grouped by module
```

and check it with `lake env lean <file>`. The argument is one of `translation`, `denotation`,
`requirementSpace`, `observation`. The index is computed from the imported environment at each
query, so it always reflects the built library. -/

namespace TMIOIndex

open Lean Elab Command

/-- What a connection statement compares. -/
inductive Category where
  | translation | denotation | requirementSpace | observation
  deriving BEq, Inhabited

/-- Listing order. -/
def categories : Array Category := #[.translation, .denotation, .requirementSpace, .observation]

def Category.label : Category → String
  | .translation => "translation"
  | .denotation => "denotation"
  | .requirementSpace => "requirementSpace"
  | .observation => "observation"

def Category.meaning : Category → String
  | .translation => "requirement translation compared with the semantics"
  | .denotation => "models satisfying a sentence"
  | .requirementSpace => "models meeting requirements"
  | .observation => "observations of models"

def translationMarkers : Array Name :=
  #[``powerlib.Family.chain, ``powerlib.Family.Exact, ``powerlib.Family.ExactUnder,
    ``powerlib.Family.Sound, ``powerlib.Family.SoundUnder, ``powerlib.Family.translate,
    ``powerlib.TMIO.ExactUnder, ``powerlib.TMIO.cover]

def denotationMarkers : Array Name :=
  #[``powerlib.Family.den, ``powerlib.Family.semantics, ``powerlib.Family.Holds]

def requirementMarkers : Array Name := #[``powerlib.TMIO.realize, ``powerlib.TMIO.satisfaction]

/-- Relational observation maps; members of `TMIO.Seed` are matched by namespace. -/
def observationMarkers : Array Name :=
  #[``powerlib.TMIO.certify, ``powerlib.TMIO.possibly, ``powerlib.TMIO.predict]

def isSeedMember (c : Name) : Bool :=
  c != ``powerlib.TMIO.Seed && (``powerlib.TMIO.Seed).isPrefixOf c

/-- The category of a statement whose proposition mentions the constants `cs`. -/
def classify (cs : Array Name) : Option Category :=
  let has (markers : Array Name) := cs.any markers.contains
  if has observationMarkers || cs.any isSeedMember then some .observation
  else if has translationMarkers || (has denotationMarkers && has requirementMarkers) then
    some .translation
  else if has requirementMarkers then some .requirementSpace
  else if has denotationMarkers then some .denotation
  else none

structure Entry where
  name : Name
  module : Name
  consts : Array Name

/-- The proposition of a connection statement, under its parameters. -/
def statementProp? : Expr → Option Expr
  | .forallE _ _ body _ => statementProp? body
  | e => if e.isAppOf ``powerlib.TMIO.Statement then e.getAppArgs[0]? else none

/-- The connection statements of the `theorem.*` modules, read from each module's own constants. -/
def statements (env : Environment) : Array Entry := Id.run do
  let mut out := #[]
  for i in [:env.header.moduleNames.size] do
    let module := env.header.moduleNames[i]!
    unless module.getRoot == `theorem do continue
    for name in env.header.moduleData[i]!.constNames do
      let some (.thmInfo info) := env.find? name | continue
      let some prop := statementProp? info.type | continue
      out := out.push { name, module, consts := prop.getUsedConstants }
  return out.qsort fun a b =>
    a.module.toString < b.module.toString ||
      (a.module == b.module && a.name.toString < b.name.toString)

def select (entries : Array Entry) (c : Category) : Array Entry :=
  entries.filter (classify ·.consts == some c)

def moduleCount (entries : Array Entry) : Nat :=
  (entries.foldl (fun (ms : Array Name) e => if ms.contains e.module then ms else ms.push e.module)
    #[]).size

def summary (entries : Array Entry) : String := Id.run do
  let mut lines := #[s!"{entries.size} connection statements in {moduleCount entries} modules:"]
  for c in categories do
    let n := toString (select entries c).size
    lines := lines.push s!"  {c.label}{"".pushn ' ' (22 - c.label.length - n.length)}{n}  \
      ({c.meaning})"
  lines := lines.push "List one category with `#tmio_edges translation` (or denotation, \
    requirementSpace, observation)."
  return "\n".intercalate lines.toList

def listing (entries : Array Entry) (c : Category) : String := Id.run do
  let selected := select entries c
  let mut lines := #[s!"{c.label} ({c.meaning}): {selected.size} connection statements in \
    {moduleCount selected} modules"]
  let mut current : Name := .anonymous
  for e in selected do
    if e.module != current then
      current := e.module
      lines := lines.push s!"{current} ({(selected.filter (·.module == current)).size})"
    lines := lines.push s!"  {e.name}"
  return "\n".intercalate lines.toList

/-- `#tmio_edges` counts the library's connection statements in each category;
`#tmio_edges translation` (or `denotation`, `requirementSpace`, `observation`) lists the
statements of one category by module. -/
syntax (name := tmioEdgesCmd) "#tmio_edges" (ppSpace ident)? : command

@[command_elab tmioEdgesCmd] def elabTmioEdges : CommandElab := fun stx => do
  let entries := statements (← getEnv)
  match stx[1].getOptional? with
  | none => logInfo (summary entries)
  | some arg =>
    let label := arg.getId.toString
    let some c := categories.find? (·.label == label) |
      throwErrorAt arg "Unknown category {label}; expected translation, denotation, \
        requirementSpace or observation"
    logInfo (listing entries c)

end TMIOIndex

#tmio_edges

open Lean Elab Command TMIOIndex in
run_cmd do
  let entries := statements (← getEnv)
  if entries.isEmpty then throwError "No connection statements found in the theorem modules"
  let unfiled := entries.filter (classify ·.consts |>.isNone)
  unless unfiled.isEmpty do
    throwError "Connection statements in no category:\n{"\n".intercalate
      (unfiled.map fun e => s!"{e.name} in {e.module}: {e.consts.filter (·.getRoot == `powerlib)}").toList}"
  let counts := ", ".intercalate
    (categories.map fun c => s!"{c.label} {(select entries c).size}").toList
  logInfo m!"POWERLIB_TMIO_INDEX_OK: {entries.size} connection statements in \
    {moduleCount entries} modules; {counts}"
