import powerlib

/-! # Index of the library's connection statements

Every typed connection statement `connection% P` of a `theorem.*` module is filed under one
category, read from the constants occurring in its proposition `P` (the implicit argument of
`TMIO.Statement`). The categories follow the four layers of `theorem/Stack/Basic.lean`: theory
(T), models organized for a situation (M), implementations under realistic constraints (I), and
records produced by implementations (O).

* `data` (T–O and O–I): data-driven inference, theory-driven certification and prediction of
  records along a stack. `P` mentions `Stack.infer`, `Stack.certified`, `Stack.truth`,
  `Stack.inferOrganized`, `Stack.certifiedOrganized` or `Stack.predicted`.
* `realization` (M–I): implementations against the models they realize. `P` mentions
  `Implementation.RealizationSoundUnder`, `Implementation.RealizationCompleteUnder`,
  `Implementation.RealizationExactUnder` or `Implementation.uTI`.
* `observation` (the seed encoding, observation relations on models): what observations certify
  or predict about models, or the observation closure. `P` mentions a member of `TMIO.Seed`
  (`u₃`, `uTO`, …), `TMIO.certify`, `TMIO.possibly` or `TMIO.predict`.
* `implementation` (I): translation, denotation or requirement space of an implementation family:
  a family whose system type is the implementation type of some `Implementation` or `Stack`
  declared in the library, or a family that is the implementation family (the `impl` field) of an
  `Implementation` built in the library — generic ones included, so that a law about the Euler
  implementations of an arbitrary family (`Numerics.eulerFamily`) is filed here like its
  instances. The implementation types and families are read from the types and values of the
  library's `Implementation` and `Stack` constants, never from names or tags.
* `translation` (T–M, organization): the requirement translation of a model family compared with
  the semantics (exactness, soundness, the translation chain against the semantics connection).
  `P` mentions `Family.chain`, `Family.Exact`, `Family.ExactUnder`, `Family.Sound`,
  `Family.SoundUnder`, `Family.translate`, `TMIO.ExactUnder` or `TMIO.cover`; or it compares a
  requirement space with a denotation without naming the translation (a `requirementSpace` and a
  `denotation` constant together, e.g. `realize Meets Γ ≠ F.den s`).
* `requirementSpace` (M): which models meet given requirements, the space generated by requirement
  satisfaction. `P` mentions `TMIO.realize` or `TMIO.satisfaction`.
* `denotation` (T–M, truth): which models satisfy a sentence. `P` mentions `Family.den`,
  `Family.semantics` or `Family.Holds`.

The first matching category in this order is the statement's category, so the categories
partition the statements. Compiling this module checks that every statement is filed
(`POWERLIB_TMIO_INDEX_OK`).

Usage. After `lake build`, write a file anywhere in the workspace, for example

```
import dependencies.tests.lean.Library.TMIOIndex

#tmio_edges                -- number of statements in each category
#tmio_edges translation    -- every statement of one category, grouped by module
```

and check it with `lake env lean <file>`. The argument is one of `data`, `realization`,
`observation`, `implementation`, `translation`, `requirementSpace`, `denotation`. The index is
computed from the imported environment at each query, so it always reflects the built library. -/

namespace TMIOIndex

open Lean Elab Command

/-- What a connection statement compares, by layer. -/
inductive Category where
  | data | realization | observation | implementation | translation | requirementSpace | denotation
  deriving BEq, Inhabited

/-- Listing order. -/
def categories : Array Category :=
  #[.translation, .denotation, .requirementSpace, .implementation, .realization, .data,
    .observation]

def Category.label : Category → String
  | .data => "data"
  | .realization => "realization"
  | .observation => "observation"
  | .implementation => "implementation"
  | .translation => "translation"
  | .requirementSpace => "requirementSpace"
  | .denotation => "denotation"

def Category.layer : Category → String
  | .data => "O"
  | .realization => "M–I"
  | .observation => "seed"
  | .implementation => "I"
  | .translation => "T–M"
  | .requirementSpace => "M"
  | .denotation => "T–M"

def Category.meaning : Category → String
  | .data => "records along a stack: inference, certification, prediction"
  | .realization => "implementations against the models they realize"
  | .observation => "observation relations on models (seed encoding)"
  | .implementation => "implementation families: translation, denotation, requirement space"
  | .translation => "requirement translation compared with the semantics"
  | .requirementSpace => "models meeting requirements"
  | .denotation => "models satisfying a sentence"

def dataMarkers : Array Name :=
  #[``powerlib.Stack.infer, ``powerlib.Stack.certified, ``powerlib.Stack.truth,
    ``powerlib.Stack.inferOrganized, ``powerlib.Stack.certifiedOrganized,
    ``powerlib.Stack.predicted]

def realizationMarkers : Array Name :=
  #[``powerlib.Implementation.RealizationSoundUnder,
    ``powerlib.Implementation.RealizationCompleteUnder,
    ``powerlib.Implementation.RealizationExactUnder, ``powerlib.Implementation.uTI]

def translationMarkers : Array Name :=
  #[``powerlib.Family.chain, ``powerlib.Family.Exact, ``powerlib.Family.ExactUnder,
    ``powerlib.Family.Sound, ``powerlib.Family.SoundUnder, ``powerlib.Family.translate,
    ``powerlib.TMIO.ExactUnder, ``powerlib.TMIO.cover]

def denotationMarkers : Array Name :=
  #[``powerlib.Family.den, ``powerlib.Family.semantics, ``powerlib.Family.Holds]

def requirementMarkers : Array Name := #[``powerlib.TMIO.realize, ``powerlib.TMIO.satisfaction]

/-- Relational observation maps; members of `TMIO.Seed` are matched by namespace. -/
def observationMarkers : Array Name :=
  #[``powerlib.TMIO.certify, ``powerlib.TMIO.possibly, ``powerlib.TMIO.predict]

def isSeedMember (c : Name) : Bool :=
  c != ``powerlib.TMIO.Seed && (``powerlib.TMIO.Seed).isPrefixOf c

structure Entry where
  name : Name
  module : Name
  consts : Array Name
  /-- Whether the proposition reads a family whose system type is an implementation type. -/
  readsImplementation : Bool

/-- The category of a statement. -/
def classify (e : Entry) : Option Category :=
  let cs := e.consts
  let has (markers : Array Name) := cs.any markers.contains
  if has dataMarkers then some .data
  else if has realizationMarkers then some .realization
  else if has observationMarkers || cs.any isSeedMember then some .observation
  else if e.readsImplementation &&
      (has translationMarkers || has denotationMarkers || has requirementMarkers) then
    some .implementation
  else if has translationMarkers || (has denotationMarkers && has requirementMarkers) then
    some .translation
  else if has requirementMarkers then some .requirementSpace
  else if has denotationMarkers then some .denotation
  else none

/-- The proposition of a connection statement, under its parameters. -/
def statementProp? : Expr → Option Expr
  | .forallE _ _ body _ => statementProp? body
  | e => if e.isAppOf ``powerlib.TMIO.Statement then e.getAppArgs[0]? else none

/-- The implementation types of the library: the system type `Y` of every constant of type
`Implementation X Q Y R n p m q` or `Stack X Q Y R V n p m q` (under its parameters) in a
`theorem.*` module. -/
def implementationTypes (env : Environment) : Array Expr := Id.run do
  let mut out := #[]
  for i in [:env.header.moduleNames.size] do
    unless env.header.moduleNames[i]!.getRoot == `theorem do continue
    for name in env.header.moduleData[i]!.constNames do
      let some info := env.find? name | continue
      let mut ty := info.type
      while ty.isForall do ty := ty.bindingBody!
      if ty.isAppOf ``powerlib.Stack || ty.isAppOf ``powerlib.Implementation then
        if let some y := ty.getAppArgs[2]? then
          unless y.hasLooseBVars || out.contains y do out := out.push y
  return out

/-- The implementation families of the library: the head constant of the `impl` field of every
`Implementation` constant of a `theorem.*` module whose value (under its parameters) is built with
`Implementation.mk`, generic ones included. -/
def implementationFamilies (env : Environment) : Array Name := Id.run do
  let mut out := #[]
  for i in [:env.header.moduleNames.size] do
    unless env.header.moduleNames[i]!.getRoot == `theorem do continue
    for name in env.header.moduleData[i]!.constNames do
      let some (.defnInfo info) := env.find? name | continue
      let mut ty := info.type
      while ty.isForall do ty := ty.bindingBody!
      unless ty.isAppOf ``powerlib.Implementation do continue
      let mut val := info.value
      while val.isLambda do val := val.bindingBody!
      unless val.isAppOf ``powerlib.Implementation.mk do continue
      -- `Implementation.mk X Q Y R n p m q model impl realizes`
      let some impl := val.getAppArgs[9]? | continue
      let .const c _ := impl.getAppFn | continue
      unless out.contains c do out := out.push c
  return out

/-- Whether some `Family` constant in `e` is applied at a system type in `types` (its first
argument). -/
def readsFamilyAt (types : Array Expr) (e : Expr) : Bool :=
  (e.find? fun sub => Id.run do
    let .const c _ := sub.getAppFn | return false
    unless (`powerlib.Family).isPrefixOf c do return false
    let some x := sub.getAppArgs[0]? | return false
    return types.contains x).isSome

/-- The connection statements of the `theorem.*` modules, read from each module's own constants. -/
def statements (env : Environment) : Array Entry := Id.run do
  let types := implementationTypes env
  let families := implementationFamilies env
  let mut out := #[]
  for i in [:env.header.moduleNames.size] do
    let module := env.header.moduleNames[i]!
    unless module.getRoot == `theorem do continue
    for name in env.header.moduleData[i]!.constNames do
      let some (.thmInfo info) := env.find? name | continue
      let some prop := statementProp? info.type | continue
      let consts := prop.getUsedConstants
      out := out.push
        { name, module, consts
          readsImplementation := readsFamilyAt types prop || consts.any families.contains }
  return out.qsort fun a b =>
    a.module.toString < b.module.toString ||
      (a.module == b.module && a.name.toString < b.name.toString)

def select (entries : Array Entry) (c : Category) : Array Entry :=
  entries.filter (classify · == some c)

def moduleCount (entries : Array Entry) : Nat :=
  (entries.foldl (fun (ms : Array Name) e => if ms.contains e.module then ms else ms.push e.module)
    #[]).size

def summary (entries : Array Entry) : String := Id.run do
  let mut lines := #[s!"{entries.size} connection statements in {moduleCount entries} modules:"]
  for c in categories do
    let n := toString (select entries c).size
    lines := lines.push s!"  {c.layer}{"".pushn ' ' (6 - c.layer.length)}{c.label}\
      {"".pushn ' ' (22 - c.label.length - n.length)}{n}  ({c.meaning})"
  lines := lines.push "List one category with `#tmio_edges translation` (or denotation, \
    requirementSpace, implementation, realization, data, observation)."
  return "\n".intercalate lines.toList

def listing (entries : Array Entry) (c : Category) : String := Id.run do
  let selected := select entries c
  let mut lines := #[s!"{c.label} [{c.layer}] ({c.meaning}): {selected.size} connection \
    statements in {moduleCount selected} modules"]
  let mut current : Name := .anonymous
  for e in selected do
    if e.module != current then
      current := e.module
      lines := lines.push s!"{current} ({(selected.filter (·.module == current)).size})"
    lines := lines.push s!"  {e.name}"
  return "\n".intercalate lines.toList

/-- `#tmio_edges` counts the library's connection statements in each category;
`#tmio_edges translation` (or `denotation`, `requirementSpace`, `implementation`, `realization`,
`data`, `observation`) lists the statements of one category by module. -/
syntax (name := tmioEdgesCmd) "#tmio_edges" (ppSpace ident)? : command

@[command_elab tmioEdgesCmd] def elabTmioEdges : CommandElab := fun stx => do
  let entries := statements (← getEnv)
  match stx[1].getOptional? with
  | none => logInfo (summary entries)
  | some arg =>
    let label := arg.getId.toString
    let some c := categories.find? (·.label == label) |
      throwErrorAt arg "Unknown category {label}; expected translation, denotation, \
        requirementSpace, implementation, realization, data or observation"
    logInfo (listing entries c)

end TMIOIndex

#tmio_edges

open Lean Elab Command TMIOIndex in
run_cmd do
  let entries := statements (← getEnv)
  if entries.isEmpty then throwError "No connection statements found in the theorem modules"
  let unfiled := entries.filter (classify · |>.isNone)
  unless unfiled.isEmpty do
    throwError "Connection statements in no category:\n{"\n".intercalate
      (unfiled.map fun e => s!"{e.name} in {e.module}: {e.consts.filter (·.getRoot == `powerlib)}").toList}"
  let counts := ", ".intercalate
    (categories.map fun c => s!"{c.label} {(select entries c).size}").toList
  logInfo m!"POWERLIB_TMIO_INDEX_OK: {entries.size} connection statements in \
    {moduleCount entries} modules; {counts}"
