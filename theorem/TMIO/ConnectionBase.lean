import Mathlib.Order.Closure
import Mathlib.Order.Hom.CompleteLattice
import Mathlib.Order.Rel.GaloisConnection

/-! # Connection primitives

The generated adjoint, its closure, and the relational upper map are defined before the
connection grammar. Their public laws live in `Generate` and `Relation`, which can therefore
use `connection%` without importing themselves through the elaborator. Construction obligations
are proved here directly from Mathlib; no theorem registry or duplicate public law is introduced.

Scope.
* Generic complete lattices and powerset relations; no engineering model or semantic predicate.

Source: Mathlib's `LowerAdjoint`, arbitrary-infimum homomorphisms and relational Galois connection.

Results.
* `generate`, `closure` and `cover`: primitive maps used by the connection certificate grammar.
-/

namespace powerlib.TMIO

variable {A B : Type*} [CompleteLattice A] [CompleteLattice B]

/-- The lower adjoint uniquely generated by the supplied upper map. -/
def generate (u : sInfHom B A) : LowerAdjoint u where
  toFun a := sInf {b | a ≤ u b}
  gc' a _ := by
    have hle : a ≤ u (sInf {b | a ≤ u b}) := by
      rw [map_sInf]
      exact le_sInf (by rintro _ ⟨b, hb, rfl⟩; exact hb)
    exact ⟨fun h => hle.trans (OrderHomClass.mono u h), fun h => sInf_le h⟩

/-- The closure induced by a generated adjunction. -/
def closure (u : sInfHom B A) : ClosureOperator A := (generate u).closureOperator

/-- The relational upper map: sentences whose translations all lie in the input set. -/
def cover {S Q : Type*} (R : SetRel S Q) : sInfHom (Set Q) (Set S) where
  toFun := R.core
  map_sInf' s := by
    rw [sInf_image]
    exact (show GaloisConnection R.image R.core from fun _ _ => SetRel.image_subset_iff).u_sInf

end powerlib.TMIO
