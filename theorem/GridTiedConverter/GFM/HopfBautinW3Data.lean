import theorem.GridTiedConverter.GFM.HopfBautinSurface
import theorem.Dynamics.PolySign

/-! # The line `w = 3` of the zero-current Hopf boundary: exact centre-manifold and Lyapunov data

Model boundary.
* The line `Line.VSM.bautinSurf s 3` (`s > 0`) of
  `theorem/GridTiedConverter/GFM/HopfBautinSurface.lean` (the four-state VSM on a dynamic R–L line,
  zero current, `E = V = 1`, `R = s`, `L = 1`, `ω₀ = 3`, `P_ref = 0`, `δ* = 0`, on the Hopf boundary
  with Hopf frequency `1`) in the critical chart of `(bautinSurfQ s 3, bautinSurfP s 3)`, chart
  coordinates `y = (y₀, y₁)`.
* Content: exact rational functions of `s`, valid for every `s > 0`, written as integer numerators
  over products of powers of the bases
  `2`, `3`, `5`, `s`, `s² + 16`, `s² + 4`, `s² + 8`, `s⁸ + 42s⁶ + 545s⁴ + 2452s² + 3136`,
  `s⁸ + 48s⁶ + 608s⁴ + 2320s² + 1024`, `s⁸ + 58s⁶ + 753s⁴ + 2740s² + 64`,
  `s⁸ + 72s⁶ + 1040s⁴ + 4672s² + 4096`
  (`Dynamics.PolyCertificate`): the coefficients of the order-four approximate centre manifold
  (`h₁ = x₂`, `h₂ = x₃` and `x₀` components, degrees two to four), the line atoms (`KA` the
  coefficient of `f₁`, `W10` … `W21` the kernel vectors, `A10`,
  `A11` the matrix of `A` on `ker π`), the critical-chart coordinates `PV0ₖ = Re pₖ + Im pₖ`,
  `PV1ₖ = Re pₖ − Im pₖ`, the 36 coefficients of the quintic jet of the chart field, the
  weight-five truncations `T` of the three nonlinearities (through the coefficients `S` of the 34
  products of manifold pieces) and their values `TV`, the homological coefficients `Hom`, the
  Lyapunov polynomial of the jet, and the path polynomial `bautinSurfNum s 3` with its real roots.
  No analysis here: the analytic statements (Taylor remainders, invariance defect, jet of the chart
  field, stability) are in `theorem/GridTiedConverter/GFM/HopfBautinW3Point.lean`.

Source: the derivation was done in exact arithmetic over `ℚ(s, w)` with python-flint and SymPy
(the homological equations of orders two to four solved through the Cayley–Hamilton inverse of
the homological operator, then `w = 3`; untrusted, discovery evidence only); every identity
below is checked by the kernel (`Dynamics.PolyCertificate.PExpr.val_eq_zero`, `decide +kernel`),
every sign on an interval by a Möbius-transform certificate (`Dynamics.PolyCertificate.zmob`).
Kuznetsov, *Elements of Applied Bifurcation Theory* (3rd ed.), §8.3 (Bautin points); Carr,
*Applications of Centre Manifold Theory* (1981), §2.5.

Results.
* `bases`, `zeval_bases_pos`, `bases_ne_zero`, `bval_s`; the atoms `CM1_ij`, `CM2_ij`, `CA_ij`
  (manifold), `KA`, `W10`, `W11`, `W20`, `W21`, `A10`, `A11` (line), `PV0_k`, `PV1_k`, `DETV`
  (chart), `TVk_ij` (truncations), `JA_ij`, `JB_ij` (jet), `LY_*`, `L1V`, `L2V` (Lyapunov
  polynomial); the coefficient expressions `S*_ij`, `T1_ij`, `T2_ij`, `T3_ij`, `jet`, `Hom2_ij`,
  `Hom3_ij`, `highD2`, `highD3`.
* The manifold and the line: `CA_ij_eq`, `KA_eq` … `A11_eq` (closed forms), `Tk_ij_val`.
* Chart: `PV0_k_eq`, `PV1_k_eq`, `DETV_eq`, `piw1_0`, `piw1_1`, `piw2_0`, `piw2_1`.
* The jet: `JA_ij_eq`, `JB_ij_eq`.
* **The homological equations**: `Hom2_ij_eq`, `Hom3_ij_eq` (for every `s > 0`).
* The Lyapunov polynomial: `jet_c30` … `jet_k6`, `jet_l1`, `jet_l2`; `zeval_nNN`, `L1V_eq`
  (`l₁(J)` is a multiple of the path polynomial), `A10_W10`, `A11_W20`, the root localisations
  `root_upper`, `root_lower` (Möbius covers of the complement of the isolating intervals), their
  existence `exists_root_upper`, `exists_root_lower` (intermediate values), and the signs
  `L2V_upper`, `L2V_lower` of `l₂(J)` on the isolating intervals (Möbius certificates on its
  numerator).
-/

noncomputable section
namespace powerlib.GFM.Line.VSM
namespace BautinW3
open powerlib.Dynamics.PolyCertificate Dynamics.Degenerate.PlanarFocus

/-! ## The bases of the denominators -/

/-- The bases of the denominators: `2`, `3`, `5`, `s`, `s² + 16`, `s² + 4`, `s² + 8`, `s⁸ + 42s⁶ +
545s⁴ + 2452s² + 3136`, `s⁸ + 48s⁶ + 608s⁴ + 2320s² + 1024`, `s⁸ + 58s⁶ + 753s⁴ + 2740s² + 64`, `s⁸
+ 72s⁶ + 1040s⁴ + 4672s² + 4096`. -/
def bases : List (List ℤ) :=
  [[2], [3], [5], [0, 1], [16, 0, 1], [4, 0, 1], [8, 0, 1], [3136, 0, 2452, 0, 545, 0, 42, 0, 1],
   [1024, 0, 2320, 0, 608, 0, 48, 0, 1], [64, 0, 2740, 0, 753, 0, 58, 0, 1],
   [4096, 0, 4672, 0, 1040, 0, 72, 0, 1]]

/-- Every base is positive for `s > 0`. Static evidence on the model. -/
@[tmio M, powerlib_domain] theorem zeval_bases_pos {s : ℝ} (hs : 0 < s) :
    ∀ b ∈ bases, 0 < zeval b s := by
  intro b hb
  simp only [bases, List.mem_cons, List.mem_nil_iff, or_false] at hb
  rcases hb with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp only [zeval] <;> push_cast <;> ring_nf <;> positivity

/-- Every base is nonzero for `s > 0`. Static evidence on the model. -/
@[tmio M, powerlib_domain] theorem bases_ne_zero {s : ℝ} (hs : 0 < s) :
    ∀ b ∈ bases, zeval b s ≠ 0 :=
  fun b hb => (zeval_bases_pos hs b hb).ne'

/-- The denominator `sᵏ`. Static evidence on the model. -/
@[tmio M, powerlib_domain] theorem bval_s (s : ℝ) (k : ℕ) :
    bval bases [0, 0, 0, k] s = s ^ k := by
  simp [zeval, bval, bases]

