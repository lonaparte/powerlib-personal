/-! ## The path polynomial, the numerator of `l₂(J)` and the roots -/

/-- `A` on `ker π`: `A10 = W10 − 3`. Static evidence on the model. -/
@[tmio M, powerlib_domain] theorem A10_W10 {s : ℝ} (hs : 0 < s) : A10 s = W10 s - 3 := by
  rw [A10_eq hs, W10_eq hs]; field_simp; ring

/-- `A` on `ker π`: `A11 = W20 − s`. Static evidence on the model. -/
@[tmio M, powerlib_domain] theorem A11_W20 {s : ℝ} (hs : 0 < s) : A11 s = W20 s - s := by
  rw [A11_eq hs, W20_eq hs]; field_simp; ring

/-- `nNN` is the path polynomial `bautinSurfNum s 3`. Static evidence on the model. -/
@[tmio M, powerlib_domain] theorem zeval_nNN (s : ℝ) : zeval nNN s = bautinSurfNum s 3 := by
  simp only [nNN, zeval, bautinSurfNum]; push_cast; ring

/-- The certificate expression of `L1V_eq`. -/
def cL1num : PExpr := (.add (.atom nL1V []) (.neg (.mul (.atom nL1Q []) (.atom nNN []))))

/-- **`l₁(J)` is a multiple of the path polynomial**: `L1V = Q₁(s) N(s)/d(s)`. Static evidence on
the model. -/
@[tmio M, powerlib_domain] theorem L1V_eq {s : ℝ} (hs : 0 < s) :
    L1V s = zeval nL1Q s * bautinSurfNum s 3 / bval bases eL1V s := by
  have h := PExpr.val_eq_zero (bases_ne_zero hs) cL1num (by decide +kernel)
  simp only [cL1num, PExpr.val, bval_nil_right, div_one] at h
  rw [L1V, ← zeval_nNN]
  congr 1
  linear_combination h

