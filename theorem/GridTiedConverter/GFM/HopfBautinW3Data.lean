/-- **Localisation of the upper root of the path polynomial**: every zero with `s < 3` lies in
`(2782/1309, 3681/1732)`. Static evidence on the model. -/
@[tmio M, powerlib_domain] theorem root_upper {s : ℝ} (hs : 0 < s) (hw : s < (3 : ℝ))
    (hN : bautinSurfNum s 3 = 0) : (2782 / 1309 : ℝ) < s ∧ s < (3681 / 1732 : ℝ) := by
  rw [← zeval_nNN] at hN
  rcases lt_trichotomy s (2782 / 1309 : ℝ) with h | h | h
  · exfalso
    rcases lt_or_ge s (1 : ℝ) with hc0 | hc0
    · linarith [nNN_piece_0 (s := s) (by linarith) (by linarith)]
    linarith [nNN_piece_1 (s := s) (by linarith) (by linarith)]
  · exfalso
    rw [h] at hN
