@[tmio T, powerlib_foundation] private theorem quintic10_H (x4 y4 x3 y3 x2 y2 x1 y1 x0 y0 : ℝ) :
    Criteria.BilharzPoly.quintic10 x4 y4 x3 y3 x2 y2 x1 y1 x0 y0 =
      quintic10H x4 y4 x3 y3 x2 y2 x1 y1 x0 y0 := by
  simp only [Criteria.BilharzPoly.quintic10, Criteria.BilharzPoly.quintic10_0,
    Criteria.BilharzPoly.quintic10_1, Criteria.BilharzPoly.quintic10_2,
    Criteria.BilharzPoly.quintic10_3, Criteria.BilharzPoly.quintic10_4,
    Criteria.BilharzPoly.quintic10_5, Criteria.BilharzPoly.quintic10_6,
    Criteria.BilharzPoly.quintic10_7, Criteria.BilharzPoly.quintic10_8,
    Criteria.BilharzPoly.quintic10_9, Criteria.BilharzPoly.quintic10_10,
    Criteria.BilharzPoly.quintic10_11, Criteria.BilharzPoly.quintic10_12,
    Criteria.BilharzPoly.quintic10_13, quintic10H]
  poly_rfl

/-- `Δ₁₀ = k_i q · delta10R` in the ideal design, normalized parameters. -/
@[tmio M, powerlib_domain] theorem quinticBilharz10_eq (kp ki ρ r w c P q : ℝ) :
    Criteria.quinticBilharz10 (FastLevel.coeffs kp ki ρ r w c P 0 q 0 0 0 4)
      (FastLevel.coeffs kp ki ρ r w c P 0 q 0 0 0 3)
      (FastLevel.coeffs kp ki ρ r w c P 0 q 0 0 0 2)
      (FastLevel.coeffs kp ki ρ r w c P 0 q 0 0 0 1)
      (FastLevel.coeffs kp ki ρ r w c P 0 q 0 0 0 0) =
      ki * q * delta10R kp ki ρ r w c P q := by
  simp only [Criteria.quinticBilharz10, FastLevel.coeffs, Matrix.cons_val, Matrix.cons_val_zero,
    Matrix.cons_val_one]
  rw [quintic10_H]
  simp only [quintic10H, delta10R, delta10R_0, delta10R_1, delta10R_2, delta10R_3, delta10R_4,
    delta10R_5, delta10R_6, delta10R_7]
  poly_rfl

end IdealLevel

namespace Params

variable (p : Params)

/-- `Δ₁₀` of the ideal design (`L_f, C_f, L_g ≠ 0`). -/
@[tmio M, powerlib_domain] theorem fastDelta_four_ideal (hLf : p.Lf ≠ 0) (hCf : p.Cf ≠ 0)
    (hLg : p.Lg ≠ 0) (hid : p.kff = 1 ∧ p.kdv = 1 ∧ p.Rv = 0 ∧ p.Xv = 0) :
    p.fastDelta 4 = p.Kic / p.Lf * (p.Kiv / p.Cf) * IdealLevel.delta10R (p.Kpc / p.Lf)
      (p.Kic / p.Lf) (p.Rf / p.Lf) (p.Rg / p.Lg) p.ω0 (1 / (p.Cf * p.Lg)) (p.Kpv / p.Cf)
      (p.Kiv / p.Cf) := by
  simp only [fastDelta, p.fastCoeff_ideal hLf hCf hLg hid, Matrix.cons_val]
  exact IdealLevel.quinticBilharz10_eq _ _ _ _ _ _ _ _

/-- **The boundary layer of the ideal design, all five conditions explicit** (`L_f, C_f,
L_g ≠ 0`, `k_ff = k_dv = 1`, `Z_v = 0`, every other parameter value). -/
@[tmio M, powerlib_domain] theorem spectrallyStable_fastBlock_iff_ideal_explicit
    (hLf : p.Lf ≠ 0) (hCf : p.Cf ≠ 0) (hLg : p.Lg ≠ 0)
    (hid : p.kff = 1 ∧ p.kdv = 1 ∧ p.Rv = 0 ∧ p.Xv = 0) (δ : ℝ) :
    Linear.SpectrallyStable (p.fastBlock δ) ↔
      0 < (p.Kpc + p.Rf) / p.Lf + p.Rg / p.Lg ∧
        0 < FastLevel.delta4 (p.Kpc / p.Lf) (p.Kic / p.Lf) (p.Rf / p.Lf) (p.Rg / p.Lg) p.ω0
          (1 / (p.Cf * p.Lg)) (p.Kpv / p.Cf) 0 (p.Kiv / p.Cf) 0 0 0 ∧
        0 < IdealLevel.delta6 (p.Kpc / p.Lf) (p.Kic / p.Lf) (p.Rf / p.Lf) (p.Rg / p.Lg) p.ω0
          (1 / (p.Cf * p.Lg)) (p.Kpv / p.Cf) (p.Kiv / p.Cf) ∧
        0 < IdealLevel.delta8 (p.Kpc / p.Lf) (p.Kic / p.Lf) (p.Rf / p.Lf) (p.Rg / p.Lg) p.ω0
          (1 / (p.Cf * p.Lg)) (p.Kpv / p.Cf) (p.Kiv / p.Cf) ∧
        0 < p.Kic / p.Lf * (p.Kiv / p.Cf) * IdealLevel.delta10R (p.Kpc / p.Lf) (p.Kic / p.Lf)
          (p.Rf / p.Lf) (p.Rg / p.Lg) p.ω0 (1 / (p.Cf * p.Lg)) (p.Kpv / p.Cf) (p.Kiv / p.Cf) := by
  rw [p.spectrallyStable_fastBlock_iff_ideal hLf hCf hLg hid δ,
    p.fastDelta_four_ideal hLf hCf hLg hid]

end Params
