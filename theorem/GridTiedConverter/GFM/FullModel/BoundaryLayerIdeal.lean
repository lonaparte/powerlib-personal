variable (p : Params)

/-- The coefficients of the ideal design (`k_ff = k_dv = 1`, `Z_v = 0`) in normalized
parameters. -/
@[tmio M, powerlib_domain] theorem fastCoeff_ideal (hLf : p.Lf ≠ 0) (hCf : p.Cf ≠ 0)
    (hLg : p.Lg ≠ 0) (hid : p.kff = 1 ∧ p.kdv = 1 ∧ p.Rv = 0 ∧ p.Xv = 0) :
    p.fastCoeff = FastLevel.coeffs (p.Kpc / p.Lf) (p.Kic / p.Lf) (p.Rf / p.Lf) (p.Rg / p.Lg)
      p.ω0 (1 / (p.Cf * p.Lg)) (p.Kpv / p.Cf) 0 (p.Kiv / p.Cf) 0 0 0 := by
  obtain ⟨hff, hdv, hRv, hXv⟩ := hid
  rw [p.fastCoeff_eq hLf hCf hLg, hff, hdv, hRv, hXv]
  simp only [sub_self, zero_div]

/-- `Δ₆` of the ideal design (`L_f, C_f, L_g ≠ 0`). -/
