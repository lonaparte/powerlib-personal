    (hLg : p.Lg ≠ 0) (hid : p.kff = 1 ∧ p.kdv = 1 ∧ p.Rv = 0 ∧ p.Xv = 0) :
    p.fastDelta 2 = IdealLevel.delta6 (p.Kpc / p.Lf) (p.Kic / p.Lf) (p.Rf / p.Lf)
      (p.Rg / p.Lg) p.ω0 (1 / (p.Cf * p.Lg)) (p.Kpv / p.Cf) (p.Kiv / p.Cf) := by
  simp only [fastDelta, p.fastCoeff_ideal hLf hCf hLg hid, Matrix.cons_val]
  exact IdealLevel.quinticBilharz6_eq _ _ _ _ _ _ _ _

