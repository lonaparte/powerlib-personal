/-- **The boundary layer of the ideal design** (`L_f, C_f, L_g ≠ 0`, `k_ff = k_dv = 1`,
`Z_v = 0`, every other parameter value): spectrally stable iff `k_p + ρ + r > 0`,
`FastLevel.delta4 > 0`, `IdealLevel.delta6 > 0`, `IdealLevel.delta8 > 0` and `Δ₁₀ > 0`. -/
@[tmio M, powerlib_domain] theorem spectrallyStable_fastBlock_iff_ideal (hLf : p.Lf ≠ 0)
    (hCf : p.Cf ≠ 0) (hLg : p.Lg ≠ 0) (hid : p.kff = 1 ∧ p.kdv = 1 ∧ p.Rv = 0 ∧ p.Xv = 0)
    (δ : ℝ) :
    Linear.SpectrallyStable (p.fastBlock δ) ↔
      0 < (p.Kpc + p.Rf) / p.Lf + p.Rg / p.Lg ∧
        0 < FastLevel.delta4 (p.Kpc / p.Lf) (p.Kic / p.Lf) (p.Rf / p.Lf) (p.Rg / p.Lg) p.ω0
          (1 / (p.Cf * p.Lg)) (p.Kpv / p.Cf) 0 (p.Kiv / p.Cf) 0 0 0 ∧
        0 < IdealLevel.delta6 (p.Kpc / p.Lf) (p.Kic / p.Lf) (p.Rf / p.Lf) (p.Rg / p.Lg) p.ω0
          (1 / (p.Cf * p.Lg)) (p.Kpv / p.Cf) (p.Kiv / p.Cf) ∧
        0 < IdealLevel.delta8 (p.Kpc / p.Lf) (p.Kic / p.Lf) (p.Rf / p.Lf) (p.Rg / p.Lg) p.ω0
          (1 / (p.Cf * p.Lg)) (p.Kpv / p.Cf) (p.Kiv / p.Cf) ∧
        0 < p.fastDelta 4 := by
  obtain ⟨hff, hdv, hRv, hXv⟩ := hid
  have h4 := p.spectrallyStable_fastBlock_iff_explicit hLf hCf hLg δ
  rw [hff, hdv, hRv, hXv] at h4
  simp only [sub_self, zero_div] at h4
  rw [h4, p.fastDelta_two_ideal hLf hCf hLg ⟨hff, hdv, hRv, hXv⟩,
    p.fastDelta_three_ideal hLf hCf hLg ⟨hff, hdv, hRv, hXv⟩]

end Params
