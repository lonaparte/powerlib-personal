    + 6 * M ^ (2:ℕ) * D * ω * w ^ (4:ℕ) * k * c ^ (2:ℕ) * ρ ^ (2:ℕ)
    - M * D ^ (4:ℕ) * ω ^ (6:ℕ) * k ^ (6:ℕ) * τ ^ (2:ℕ)
    + 3 * M * D ^ (4:ℕ) * ω ^ (6:ℕ) * k ^ (5:ℕ) * c ^ (2:ℕ) * μ * τ
    - 5 * M * D ^ (4:ℕ) * ω ^ (6:ℕ) * k ^ (4:ℕ) * c ^ (2:ℕ) * μ ^ (2:ℕ) * τ ^ (2:ℕ)
    + 5 * M * D ^ (4:ℕ) * ω ^ (6:ℕ) * k ^ (4:ℕ) * c ^ (2:ℕ) * μ * τ
    + 3 * M * D ^ (4:ℕ) * ω ^ (6:ℕ) * k ^ (3:ℕ) * c ^ (4:ℕ) * μ ^ (3:ℕ) * τ
    - 3 * M * D ^ (4:ℕ) * ω ^ (6:ℕ) * k ^ (3:ℕ) * c ^ (4:ℕ) * μ ^ (2:ℕ)
    - 4 * M * D ^ (4:ℕ) * ω ^ (6:ℕ) * k ^ (2:ℕ) * c ^ (4:ℕ) * μ ^ (4:ℕ) * τ ^ (2:ℕ)
    + 8 * M * D ^ (4:ℕ) * ω ^ (6:ℕ) * k ^ (2:ℕ) * c ^ (4:ℕ) * μ ^ (3:ℕ) * τ
    - 4 * M * D ^ (4:ℕ) * ω ^ (6:ℕ) * k ^ (2:ℕ) * c ^ (4:ℕ) * μ ^ (2:ℕ)
    - 4 * M * D ^ (4:ℕ) * ω ^ (4:ℕ) * w ^ (2:ℕ) * k ^ (4:ℕ) * c ^ (2:ℕ)
    - 3 * M * D ^ (4:ℕ) * ω ^ (4:ℕ) * w ^ (2:ℕ) * k ^ (4:ℕ) * τ ^ (2:ℕ)
    + 2 * M * D ^ (4:ℕ) * ω ^ (4:ℕ) * w ^ (2:ℕ) * k ^ (3:ℕ) * c ^ (2:ℕ) * μ * τ
    - 10 * M * D ^ (4:ℕ) * ω ^ (4:ℕ) * w ^ (2:ℕ) * k ^ (2:ℕ) * c ^ (4:ℕ) * μ ^ (2:ℕ)
    - 5 * M * D ^ (4:ℕ) * ω ^ (4:ℕ) * w ^ (2:ℕ) * k ^ (2:ℕ) * c ^ (2:ℕ) * μ ^ (2:ℕ) * τ ^ (2:ℕ)
    + 5 * M * D ^ (4:ℕ) * ω ^ (4:ℕ) * w ^ (2:ℕ) * k ^ (2:ℕ) * c ^ (2:ℕ) * μ * τ
    + 9 * M * D ^ (4:ℕ) * ω ^ (4:ℕ) * w ^ (2:ℕ) * k * c ^ (4:ℕ) * μ ^ (3:ℕ) * τ
    - 9 * M * D ^ (4:ℕ) * ω ^ (4:ℕ) * w ^ (2:ℕ) * k * c ^ (4:ℕ) * μ ^ (2:ℕ)
    + M * D ^ (4:ℕ) * ω ^ (4:ℕ) * w ^ (2:ℕ) * c ^ (4:ℕ) * μ ^ (4:ℕ) * τ ^ (2:ℕ)
    - 2 * M * D ^ (4:ℕ) * ω ^ (4:ℕ) * w ^ (2:ℕ) * c ^ (4:ℕ) * μ ^ (3:ℕ) * τ
    + M * D ^ (4:ℕ) * ω ^ (4:ℕ) * w ^ (2:ℕ) * c ^ (4:ℕ) * μ ^ (2:ℕ)
    - 4 * M * D ^ (4:ℕ) * ω ^ (2:ℕ) * w ^ (4:ℕ) * k ^ (2:ℕ) * c ^ (2:ℕ)
    - 3 * M * D ^ (4:ℕ) * ω ^ (2:ℕ) * w ^ (4:ℕ) * k ^ (2:ℕ) * τ ^ (2:ℕ)
    - M * D ^ (4:ℕ) * ω ^ (2:ℕ) * w ^ (4:ℕ) * k * c ^ (2:ℕ) * μ * τ
    + M * D ^ (4:ℕ) * ω ^ (2:ℕ) * w ^ (4:ℕ) * c ^ (4:ℕ) * μ ^ (2:ℕ)
    - M * D ^ (4:ℕ) * w ^ (6:ℕ) * τ ^ (2:ℕ) + M * D ^ (3:ℕ) * ω ^ (5:ℕ) * k ^ (5:ℕ) * c * ρ * τ
    + 3 * M * D ^ (3:ℕ) * ω ^ (5:ℕ) * k ^ (4:ℕ) * c ^ (3:ℕ) * μ * ρ
    - 4 * M * D ^ (3:ℕ) * ω ^ (5:ℕ) * k ^ (3:ℕ) * c ^ (3:ℕ) * μ ^ (2:ℕ) * ρ * τ
    + 2 * M * D ^ (3:ℕ) * ω ^ (5:ℕ) * k ^ (3:ℕ) * c ^ (3:ℕ) * μ * ρ
    + 3 * M * D ^ (3:ℕ) * ω ^ (5:ℕ) * k ^ (2:ℕ) * c ^ (5:ℕ) * μ ^ (3:ℕ) * ρ
    - 5 * M * D ^ (3:ℕ) * ω ^ (5:ℕ) * k * c ^ (5:ℕ) * μ ^ (4:ℕ) * ρ * τ
    + 5 * M * D ^ (3:ℕ) * ω ^ (5:ℕ) * k * c ^ (5:ℕ) * μ ^ (3:ℕ) * ρ
    + 2 * M * D ^ (3:ℕ) * ω ^ (3:ℕ) * w ^ (2:ℕ) * k ^ (3:ℕ) * c * ρ * τ
    - M * D ^ (3:ℕ) * ω ^ (3:ℕ) * w ^ (2:ℕ) * k ^ (2:ℕ) * c ^ (3:ℕ) * μ * ρ
    - 2 * M * D ^ (3:ℕ) * ω ^ (3:ℕ) * w ^ (2:ℕ) * k * c ^ (3:ℕ) * μ ^ (2:ℕ) * ρ * τ
    + 2 * M * D ^ (3:ℕ) * ω ^ (3:ℕ) * w ^ (2:ℕ) * k * c ^ (3:ℕ) * μ * ρ
    + M * D ^ (3:ℕ) * ω * w ^ (4:ℕ) * k * c * ρ * τ
    + 2 * M * D ^ (2:ℕ) * ω ^ (4:ℕ) * k ^ (4:ℕ) * c ^ (2:ℕ) * ρ ^ (2:ℕ)
    + M * D ^ (2:ℕ) * ω ^ (4:ℕ) * k ^ (2:ℕ) * c ^ (4:ℕ) * μ ^ (2:ℕ) * ρ ^ (2:ℕ)
    - M * D ^ (2:ℕ) * ω ^ (4:ℕ) * c ^ (6:ℕ) * μ ^ (4:ℕ) * ρ ^ (2:ℕ)
    - M * D ^ (2:ℕ) * ω ^ (2:ℕ) * w ^ (2:ℕ) * c ^ (4:ℕ) * μ ^ (2:ℕ) * ρ ^ (2:ℕ)
    - 2 * M * D ^ (2:ℕ) * w ^ (4:ℕ) * c ^ (2:ℕ) * ρ ^ (2:ℕ)
    + D ^ (5:ℕ) * ω ^ (5:ℕ) * k ^ (4:ℕ) * c ^ (2:ℕ) * μ * τ
    - D ^ (5:ℕ) * ω ^ (5:ℕ) * k ^ (3:ℕ) * c ^ (2:ℕ) * μ ^ (2:ℕ) * τ ^ (2:ℕ)
    + D ^ (5:ℕ) * ω ^ (5:ℕ) * k ^ (3:ℕ) * c ^ (2:ℕ) * μ * τ
    + D ^ (5:ℕ) * ω ^ (5:ℕ) * k ^ (2:ℕ) * c ^ (4:ℕ) * μ ^ (3:ℕ) * τ
    - D ^ (5:ℕ) * ω ^ (5:ℕ) * k ^ (2:ℕ) * c ^ (4:ℕ) * μ ^ (2:ℕ)
    - D ^ (5:ℕ) * ω ^ (5:ℕ) * k * c ^ (4:ℕ) * μ ^ (4:ℕ) * τ ^ (2:ℕ)
    + 2 * D ^ (5:ℕ) * ω ^ (5:ℕ) * k * c ^ (4:ℕ) * μ ^ (3:ℕ) * τ
    - D ^ (5:ℕ) * ω ^ (5:ℕ) * k * c ^ (4:ℕ) * μ ^ (2:ℕ)
    - D ^ (5:ℕ) * ω ^ (3:ℕ) * w ^ (2:ℕ) * k ^ (3:ℕ) * c ^ (2:ℕ)
    + D ^ (5:ℕ) * ω ^ (3:ℕ) * w ^ (2:ℕ) * k ^ (2:ℕ) * c ^ (2:ℕ) * μ * τ
    - 2 * D ^ (5:ℕ) * ω ^ (3:ℕ) * w ^ (2:ℕ) * k * c ^ (4:ℕ) * μ ^ (2:ℕ)
    - D ^ (5:ℕ) * ω ^ (3:ℕ) * w ^ (2:ℕ) * k * c ^ (2:ℕ) * μ ^ (2:ℕ) * τ ^ (2:ℕ)
    + D ^ (5:ℕ) * ω ^ (3:ℕ) * w ^ (2:ℕ) * k * c ^ (2:ℕ) * μ * τ
    + 2 * D ^ (5:ℕ) * ω ^ (3:ℕ) * w ^ (2:ℕ) * c ^ (4:ℕ) * μ ^ (3:ℕ) * τ
    - 2 * D ^ (5:ℕ) * ω ^ (3:ℕ) * w ^ (2:ℕ) * c ^ (4:ℕ) * μ ^ (2:ℕ)
    - D ^ (5:ℕ) * ω * w ^ (4:ℕ) * k * c ^ (2:ℕ) + D ^ (4:ℕ) * ω ^ (4:ℕ) * k ^ (4:ℕ) * c * ρ * τ
    + D ^ (4:ℕ) * ω ^ (4:ℕ) * k ^ (3:ℕ) * c ^ (3:ℕ) * μ * ρ
    + D ^ (4:ℕ) * ω ^ (4:ℕ) * k * c ^ (5:ℕ) * μ ^ (3:ℕ) * ρ
    - D ^ (4:ℕ) * ω ^ (4:ℕ) * c ^ (5:ℕ) * μ ^ (4:ℕ) * ρ * τ
    + D ^ (4:ℕ) * ω ^ (4:ℕ) * c ^ (5:ℕ) * μ ^ (3:ℕ) * ρ
    + 2 * D ^ (4:ℕ) * ω ^ (2:ℕ) * w ^ (2:ℕ) * k ^ (2:ℕ) * c * ρ * τ
    + D ^ (4:ℕ) * ω ^ (2:ℕ) * w ^ (2:ℕ) * k * c ^ (3:ℕ) * μ * ρ
    + D ^ (4:ℕ) * w ^ (4:ℕ) * c * ρ * τ
    + D ^ (3:ℕ) * ω ^ (3:ℕ) * k ^ (3:ℕ) * c ^ (2:ℕ) * ρ ^ (2:ℕ)
    + D ^ (3:ℕ) * ω ^ (3:ℕ) * k * c ^ (4:ℕ) * μ ^ (2:ℕ) * ρ ^ (2:ℕ)
    + D ^ (3:ℕ) * ω * w ^ (2:ℕ) * k * c ^ (2:ℕ) * ρ ^ (2:ℕ)

/-- **The numerator of `ℓ₁` on the Hopf surface** (231 monomials in
`M, D, ω_q, ω, k, c, μ, ρ, τ`, in 3 parts): `ℓ₁ = hopfNum/QVDroop.hopfDen` at the critical
pair `QVDroop.hopfQ`, `QVDroop.hopfP`. -/
def hopfNum (M D ω w k c μ ρ τ : ℝ) : ℝ :=
  hopfNum1 M D ω w k c μ ρ τ + hopfNum2 M D ω w k c μ ρ τ + hopfNum3 M D ω w k c μ ρ τ

/-- The resolvent vector `r = A⁻¹ B(q, q̄)` (real). -/
def hopfR (M D ω w k c μ ρ τ : ℝ) : Fin 3 → ℂ :=
  ![((hopfR0 M D ω w k c μ ρ τ : ℝ) : ℂ), 0, ((hopfR2 M D ω w k c μ ρ τ : ℝ) : ℂ)]

/-- The resolvent vector `s = (2iω − A)⁻¹ B(q, q)`. -/
def hopfS (M D ω w k c μ ρ τ : ℝ) : Fin 3 → ℂ :=
  ![((hopfS0re M D ω w k c μ ρ τ : ℝ) : ℂ) + ((hopfS0im M D ω w k c μ ρ τ : ℝ) : ℂ) * I,
    ((hopfS1re M D ω w k c μ ρ τ : ℝ) : ℂ) + ((hopfS1im M D ω w k c μ ρ τ : ℝ) : ℂ) * I,
    ((hopfS2re M D ω w k c μ ρ τ : ℝ) : ℂ) + ((hopfS2im M D ω w k c μ ρ τ : ℝ) : ℂ) * I]

variable {M D ω w k c μ ρ τ : ℝ}

@[tmio M, powerlib_domain] private theorem hopf_r (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0)
    (hw : w ≠ 0) (hL : QVDroop.hopfL M D ω k ≠ 0) :
    Linear.complexify (QVDroop.hopfJ M D ω w k c) *ᵥ hopfR M D ω w k c μ ρ τ =
      bForm M ω (QVDroop.hopfA M D ω w k) (QVDroop.hopfB D ω w k c) c k μ ρ τ
        (QVDroop.hopfQ ω w k c) (star (QVDroop.hopfQ ω w k c)) := by
  ext i; fin_cases i
  all_goals simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three, droopJacobian, hopfR, hopfR0,
    hopfR2, bForm, QVDroop.hopfQ, QVDroop.hopfA, QVDroop.hopfB, Complex.ext_iff,
    -Complex.ofReal_mul, -Complex.ofReal_div, -Complex.ofReal_pow, -Complex.ofReal_neg,
    -Complex.ofReal_sub, -Complex.ofReal_add, -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals (field_simp; (try simp only [QVDroop.hopfL]); ring)

@[tmio M, powerlib_domain] private theorem hopf_s (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0)
    (hw : w ≠ 0) (h4 : QVDroop.hopfQ4 M D ω w k ≠ 0) :
    shift2 (Linear.complexify (QVDroop.hopfJ M D ω w k c)) w *ᵥ hopfS M D ω w k c μ ρ τ =
      bForm M ω (QVDroop.hopfA M D ω w k) (QVDroop.hopfB D ω w k c) c k μ ρ τ
        (QVDroop.hopfQ ω w k c) (QVDroop.hopfQ ω w k c) := by
  ext i; fin_cases i
  all_goals simp [shift2, Matrix.mulVec, dotProduct, Fin.sum_univ_three, droopJacobian, hopfS,
    hopfS0re, hopfS0im, hopfS1re, hopfS1im, hopfS2re, hopfS2im, bForm, QVDroop.hopfQ,
    QVDroop.hopfA, QVDroop.hopfB, Complex.ext_iff, -Complex.ofReal_mul, -Complex.ofReal_div,
    -Complex.ofReal_pow, -Complex.ofReal_neg, -Complex.ofReal_sub, -Complex.ofReal_add,
    -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals (field_simp; (try simp only [QVDroop.hopfQ4, QVDroop.hopfL]); ring)

@[tmio M, powerlib_domain] private theorem hopf_Z1 (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0) :
    QVDroop.hopfY M D ω w k c ⬝ᵥ cForm M ω (QVDroop.hopfA M D ω w k) c μ ρ τ
        (QVDroop.hopfQ ω w k c) (QVDroop.hopfQ ω w k c) (star (QVDroop.hopfQ ω w k c)) =
      ((hopfZ1re M D ω w k c μ ρ τ : ℝ) : ℂ) + ((hopfZ1im M D ω w k c μ ρ τ : ℝ) : ℂ) * I := by
  simp [dotProduct, Fin.sum_univ_three, cForm, QVDroop.hopfY, QVDroop.hopfQ, QVDroop.hopfA,
    QVDroop.hopfB, hopfZ1re, hopfZ1im, Complex.ext_iff, -Complex.ofReal_mul,
    -Complex.ofReal_div, -Complex.ofReal_pow, -Complex.ofReal_neg, -Complex.ofReal_sub,
    -Complex.ofReal_add, -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals (field_simp; ring)

@[tmio M, powerlib_domain] private theorem hopf_Z2 (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0)
    (hw : w ≠ 0) (hL : QVDroop.hopfL M D ω k ≠ 0) :
    QVDroop.hopfY M D ω w k c ⬝ᵥ bForm M ω (QVDroop.hopfA M D ω w k) (QVDroop.hopfB D ω w k c)
        c k μ ρ τ (QVDroop.hopfQ ω w k c) (hopfR M D ω w k c μ ρ τ) =
      ((hopfZ2re M D ω w k c μ ρ τ : ℝ) : ℂ) + ((hopfZ2im M D ω w k c μ ρ τ : ℝ) : ℂ) * I := by
  simp [dotProduct, Fin.sum_univ_three, bForm, QVDroop.hopfY, QVDroop.hopfQ, hopfR, hopfR0,
    hopfR2, QVDroop.hopfA, QVDroop.hopfB, hopfZ2re, hopfZ2im, hopfZ2reN, hopfZ2imN,
    Complex.ext_iff, -Complex.ofReal_mul, -Complex.ofReal_div, -Complex.ofReal_pow,
    -Complex.ofReal_neg, -Complex.ofReal_sub, -Complex.ofReal_add, -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals (field_simp; ring)

/-- `⟨ȳ, B(q̄, v)⟩` is linear in `v₀`, `v₂`. -/
@[tmio M, powerlib_domain] private theorem hopf_Z3_lin (v : Fin 3 → ℂ) :
    QVDroop.hopfY M D ω w k c ⬝ᵥ bForm M ω (QVDroop.hopfA M D ω w k) (QVDroop.hopfB D ω w k c)
        c k μ ρ τ (star (QVDroop.hopfQ ω w k c)) v =
      v 0 * (QVDroop.hopfY M D ω w k c 1 * (-((ρ / M : ℝ) : ℂ) * star (QVDroop.hopfQ ω w k c) 0 +
          ((μ * QVDroop.hopfA M D ω w k / M : ℝ) : ℂ) * star (QVDroop.hopfQ ω w k c) 2) +
        QVDroop.hopfY M D ω w k c 2 * (((ω * τ : ℝ) : ℂ) * star (QVDroop.hopfQ ω w k c) 0 -
          ((ω * μ * c : ℝ) : ℂ) * star (QVDroop.hopfQ ω w k c) 2)) +
      v 2 * (QVDroop.hopfY M D ω w k c 1 * (((μ * QVDroop.hopfA M D ω w k / M : ℝ) : ℂ) *
          star (QVDroop.hopfQ ω w k c) 0 -
          ((μ * (QVDroop.hopfB D ω w k c + μ * ρ) / M : ℝ) : ℂ) *
          star (QVDroop.hopfQ ω w k c) 2) +
        QVDroop.hopfY M D ω w k c 2 * (-((ω * μ * c : ℝ) : ℂ) * star (QVDroop.hopfQ ω w k c) 0 +
          ((ω * μ * (k - 1 + μ * τ) : ℝ) : ℂ) * star (QVDroop.hopfQ ω w k c) 2)) := by
  simp only [dotProduct, Fin.sum_univ_three, bForm, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
  ring

@[tmio M, powerlib_domain] private theorem hopf_Z3 (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0)
    (hw : w ≠ 0) (h4 : QVDroop.hopfQ4 M D ω w k ≠ 0) :
    QVDroop.hopfY M D ω w k c ⬝ᵥ bForm M ω (QVDroop.hopfA M D ω w k) (QVDroop.hopfB D ω w k c)
        c k μ ρ τ (star (QVDroop.hopfQ ω w k c)) (hopfS M D ω w k c μ ρ τ) =
      ((hopfZ3re M D ω w k c μ ρ τ : ℝ) : ℂ) + ((hopfZ3im M D ω w k c μ ρ τ : ℝ) : ℂ) * I := by
  rw [hopf_Z3_lin]
  simp only [hopfS, Matrix.cons_val_zero, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons]
  simp [QVDroop.hopfY, QVDroop.hopfQ, QVDroop.hopfA, QVDroop.hopfB, Complex.ext_iff,
    -Complex.ofReal_mul, -Complex.ofReal_div, -Complex.ofReal_pow, -Complex.ofReal_neg,
    -Complex.ofReal_sub, -Complex.ofReal_add, -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals
    simp only [hopfS0re, hopfS0im, hopfS2re, hopfS2im, hopfZ3re, hopfZ3im, hopfZ3reN, hopfZ3imN]
    field_simp
    ring

/-- The numerator identity: `6 ω² (ω² + ω_q² k²) hopfNum = Re(Z) Re(n₀) + ω Im(Z) Im(n₀)` with the
cleared pairing numerators. -/
@[tmio M, powerlib_domain] private theorem hopfNum_eq :
    6 * w ^ 2 * (w ^ 2 + ω ^ 2 * k ^ 2) * hopfNum M D ω w k c μ ρ τ =
      (3 * c ^ 2 * w ^ 2 * QVDroop.hopfL M D ω k * QVDroop.hopfQ4 M D ω w k *
            hopfZ1re M D ω w k c μ ρ τ -
          6 * QVDroop.hopfQ4 M D ω w k * hopfZ2reN M D ω w k c μ ρ τ +
          QVDroop.hopfL M D ω k * hopfZ3reN M D ω w k c μ ρ τ) *
          (-2 * w ^ 2 * (D + 2 * M * k * ω)) +
        w * (3 * c ^ 2 * w * QVDroop.hopfL M D ω k * QVDroop.hopfQ4 M D ω w k *
            hopfZ1im M D ω w k c μ ρ τ -
          6 * QVDroop.hopfQ4 M D ω w k * hopfZ2imN M D ω w k c μ ρ τ +
          QVDroop.hopfL M D ω k * hopfZ3imN M D ω w k c μ ρ τ) *
          (2 * w * (D * k * ω + M * k ^ 2 * ω ^ 2 - M * w ^ 2)) := by
  simp only [hopfNum, hopfNum1, hopfNum2, hopfNum3, hopfZ1re, hopfZ1im, hopfZ2reN, hopfZ2imN,
    hopfZ3reN, hopfZ3imN, QVDroop.hopfL, QVDroop.hopfQ4]
  ring

@[tmio M, powerlib_domain] private theorem hopf_final (hc : c ≠ 0) (hw : 0 < w)
    (hL : 0 < QVDroop.hopfL M D ω k) :
    1 / (2 * w) * ((((hopfZ1re M D ω w k c μ ρ τ : ℝ) : ℂ) +
        ((hopfZ1im M D ω w k c μ ρ τ : ℝ) : ℂ) * I -
        2 * (((hopfZ2re M D ω w k c μ ρ τ : ℝ) : ℂ) + ((hopfZ2im M D ω w k c μ ρ τ : ℝ) : ℂ) * I) +
        (((hopfZ3re M D ω w k c μ ρ τ : ℝ) : ℂ) + ((hopfZ3im M D ω w k c μ ρ τ : ℝ) : ℂ) * I)) /
        QVDroop.hopfN0 M D ω w k).re =
      hopfNum M D ω w k c μ ρ τ / QVDroop.hopfDen M D ω w k c := by
  have hQ1 : 0 < QVDroop.hopfQ1 M D ω w k := by unfold QVDroop.hopfQ1; positivity
  have hQ4 : 0 < QVDroop.hopfQ4 M D ω w k := by unfold QVDroop.hopfQ4; positivity
  have hk2 : 0 < w ^ 2 + ω ^ 2 * k ^ 2 := by positivity
  have hn : Complex.normSq (QVDroop.hopfN0 M D ω w k) =
      4 * w ^ 2 * (w ^ 2 + ω ^ 2 * k ^ 2) * QVDroop.hopfQ1 M D ω w k := by
    simp [Complex.normSq_apply, QVDroop.hopfN0, QVDroop.hopfQ1, QVDroop.hopfL,
      -Complex.ofReal_mul, -Complex.ofReal_pow, -Complex.ofReal_add, -Complex.ofReal_neg,
      -Complex.ofReal_sub]
    ring
  rw [Complex.div_re, hn]
  simp only [Complex.add_re, Complex.sub_re, Complex.mul_re, Complex.add_im, Complex.sub_im,
    Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im,
    Complex.re_ofNat, Complex.im_ofNat, QVDroop.hopfN0]
  have key := hopfNum_eq (M := M) (D := D) (ω := ω) (w := w) (k := k) (c := c) (μ := μ) (ρ := ρ)
    (τ := τ)
  rw [QVDroop.hopfDen, hopfZ2re, hopfZ2im, hopfZ3re, hopfZ3im]
  generalize hopfNum M D ω w k c μ ρ τ = N at key ⊢
  generalize hopfZ1re M D ω w k c μ ρ τ = z1r at key ⊢
  generalize hopfZ1im M D ω w k c μ ρ τ = z1i at key ⊢
  generalize hopfZ2reN M D ω w k c μ ρ τ = z2r at key ⊢
  generalize hopfZ2imN M D ω w k c μ ρ τ = z2i at key ⊢
  generalize hopfZ3reN M D ω w k c μ ρ τ = z3r at key ⊢
  generalize hopfZ3imN M D ω w k c μ ρ τ = z3i at key ⊢
  generalize QVDroop.hopfL M D ω k = L at key hL hQ1 hQ4 ⊢
  generalize QVDroop.hopfQ1 M D ω w k = Q1 at hQ1 ⊢
  generalize QVDroop.hopfQ4 M D ω w k = Q4 at key hQ4 ⊢
  field_simp
  linear_combination (-1 : ℝ) * key

/-- **Consistency with the model without virtual impedance**: at its curvatures `ρ = −c`,
`τ = a = M ω² − D ω_q k` the numerator is `QVDroop.hopfNum`. -/
@[tmio M, powerlib_domain] theorem hopfNum_neg_hopfA :
    hopfNum M D ω w k c μ (-c) (QVDroop.hopfA M D ω w k) = QVDroop.hopfNum M D ω w k c μ := by
  simp only [hopfNum, hopfNum1, hopfNum2, hopfNum3, QVDroop.hopfNum, QVDroop.hopfNum1,
    QVDroop.hopfNum2, QVDroop.hopfNum3, QVDroop.hopfA]
  ring

/-- **The Hopf point algebra with a virtual impedance.** A field whose Jacobian at `x₀` is the
droop-loop pattern on the Hopf surface (`a = M ω² − D ω_q k`, `b = −D(ω² + ω_q² k²)/(ω_q c)`,
`M, ω_q, ω > 0`, `c ≠ 0`, `L = D + M ω_q k > 0`), whose second and third derivatives are the forms
`bForm`, `cForm` with the angle curvatures `ρ`, `τ`, and that vanishes at `x₀` has the critical
pair `(QVDroop.hopfQ, QVDroop.hopfP)` at the frequency `ω` and
`ℓ₁ = hopfNum/QVDroop.hopfDen`. -/
@[tmio M, powerlib_domain] theorem hopf_isCriticalPair_firstLyapunov {F : State 3 → State 3}
    {x₀ : State 3} (hM : 0 < M) (hω : 0 < ω) (hw : 0 < w) (hc : c ≠ 0)
    (hL : 0 < QVDroop.hopfL M D ω k) (h0 : F x₀ = 0)
    (hJ : jacobianC F x₀ = Linear.complexify (QVDroop.hopfJ M D ω w k c))
    (hB : ∀ u v, bilinC F x₀ u v =
      bForm M ω (QVDroop.hopfA M D ω w k) (QVDroop.hopfB D ω w k c) c k μ ρ τ u v)
    (hT : ∀ u v z, trilinC F x₀ u v z = cForm M ω (QVDroop.hopfA M D ω w k) c μ ρ τ u v z) :
    IsCriticalPair F x₀ w (QVDroop.hopfQ ω w k c) (QVDroop.hopfP M D ω w k c) ∧
      firstLyapunov F x₀ w (QVDroop.hopfQ ω w k c) (QVDroop.hopfP M D ω w k c) =
        hopfNum M D ω w k c μ ρ τ / QVDroop.hopfDen M D ω w k c := by
  have hN := QVDroop.hopfN0_ne hw hL
  have hQ4 : 0 < QVDroop.hopfQ4 M D ω w k := by unfold QVDroop.hopfQ4; positivity
  have hpstar : star (QVDroop.hopfP M D ω w k c) =
      fun j => QVDroop.hopfY M D ω w k c j / QVDroop.hopfN0 M D ω w k := by
    funext j; simp [QVDroop.hopfP]
  have hpair : ∀ v, pairing (QVDroop.hopfP M D ω w k c) v =
      (QVDroop.hopfY M D ω w k c ⬝ᵥ v) / QVDroop.hopfN0 M D ω w k := by
    intro v
    rw [pairing_eq_dotProduct, hpstar]
    simp only [dotProduct, Fin.sum_univ_three]
    ring
  refine ⟨⟨h0, hw, ?_, ?_, ?_⟩, ?_⟩
  · rw [hJ]; exact QVDroop.hopf_right hM.ne' hω.ne' hc
  · rw [hJ]
    have h := transpose_mulVec_conj_div (z := starRingEnd ℂ (QVDroop.hopfN0 M D ω w k))
      (QVDroop.hopf_leftY (D := D) (w := w) (k := k) hM.ne' hω.ne' hc)
    have e : starRingEnd ℂ ((w : ℂ) * I) = -((w : ℂ) * I) := by simp
    rw [e] at h
    exact h
  · rw [hpstar]
    simp only [dotProduct, Fin.sum_univ_three]
    have h := QVDroop.hopf_dotYQ (M := M) (D := D) (w := w) (k := k) hω.ne' hc
    simp only [dotProduct, Fin.sum_univ_three] at h
    rw [show QVDroop.hopfY M D ω w k c 0 / QVDroop.hopfN0 M D ω w k * QVDroop.hopfQ ω w k c 0 +
        QVDroop.hopfY M D ω w k c 1 / QVDroop.hopfN0 M D ω w k * QVDroop.hopfQ ω w k c 1 +
        QVDroop.hopfY M D ω w k c 2 / QVDroop.hopfN0 M D ω w k * QVDroop.hopfQ ω w k c 2 =
        (QVDroop.hopfY M D ω w k c 0 * QVDroop.hopfQ ω w k c 0 +
          QVDroop.hopfY M D ω w k c 1 * QVDroop.hopfQ ω w k c 1 +
          QVDroop.hopfY M D ω w k c 2 * QVDroop.hopfQ ω w k c 2) /
          QVDroop.hopfN0 M D ω w k by ring, h, div_self hN]
  · have hA : IsUnit (jacobianC F x₀).det := by
      rw [hJ, QVDroop.hopf_det hM.ne' hω.ne' hc]
      refine isUnit_iff_ne_zero.mpr (Complex.ofReal_ne_zero.mpr ?_)
      have : 0 < w ^ 2 * QVDroop.hopfL M D ω k / M := by positivity
      linarith
    have h2 : IsUnit (shift2 (jacobianC F x₀) w).det := by
      rw [hJ, QVDroop.hopf_det2 hM.ne' hω.ne' hc]
      refine isUnit_iff_ne_zero.mpr fun h => ?_
      have h' := congrArg Complex.re h
      simp only [Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.ofReal_im,
        Complex.I_re, Complex.I_im, Complex.zero_re, mul_zero, zero_mul, sub_zero,
        add_zero] at h'
      have : 0 < 3 * w ^ 2 * QVDroop.hopfL M D ω k / M := by positivity
      linarith
    have hr : jacobianC F x₀ *ᵥ hopfR M D ω w k c μ ρ τ =
        bilinC F x₀ (QVDroop.hopfQ ω w k c) (star (QVDroop.hopfQ ω w k c)) := by
      rw [hJ, hB]; exact hopf_r hM.ne' hω.ne' hc hw.ne' hL.ne'
    have hs : shift2 (jacobianC F x₀) w *ᵥ hopfS M D ω w k c μ ρ τ =
        bilinC F x₀ (QVDroop.hopfQ ω w k c) (QVDroop.hopfQ ω w k c) := by
      rw [hJ, hB]; exact hopf_s hM.ne' hω.ne' hc hw.ne' hQ4.ne'
    rw [firstLyapunov_eq_of_solve hA h2 hr hs, hpair, hpair, hpair, hT, hB, hB,
      hopf_Z1 hM.ne' hω.ne' hc, hopf_Z2 hM.ne' hω.ne' hc hw.ne' hL.ne',
      hopf_Z3 hM.ne' hω.ne' hc hw.ne' hQ4.ne', ← hopf_final (μ := μ) (ρ := ρ) (τ := τ) hc hw hL]
    congr 2
    ring

end Core

/-! ## The Hopf surface of the virtual-impedance model -/

/-- The frequency `ω = √((P_tδ + D ω_q K_t)/M)` at the selected point. -/
def Model.hopfFreq (m : Model) : ℝ :=
  √((m.q.Ptδ m.δ (m.q.emf m.Qf) + m.q.D * m.q.ωq * m.q.gain m.δ (m.q.emf m.Qf)) / m.q.M)

/-- The numerator `hopfNum` at the data of the selected point. -/
def Model.hopfNumAt (m : Model) : ℝ :=
  hopfNum m.q.M m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))
    (m.q.Qtδ m.δ (m.q.emf m.Qf)) (m.q.nq / m.q.emf m.Qf) (m.q.Ptδδ m.δ (m.q.emf m.Qf))
    (m.q.Qtδδ m.δ (m.q.emf m.Qf))

/-- A Hopf point of the Routh region: an equilibrium with `A > 0`, `C > 0`, `G = 0`. -/
def Model.IsHopf (m : Model) : Prop :=
  m.q.field m.point = 0 ∧ 0 < m.q.routhTrace m.δ (m.q.emf m.Qf) ∧
    0 < m.q.routhFold m.δ (m.q.emf m.Qf) ∧ m.q.routhHopf m.δ (m.q.emf m.Qf) = 0

/-- **The Hopf relations.** At a Hopf point with `M, D, ω_q > 0`: `ω = hopfFreq > 0`,
`P_tδ = M ω² − D ω_q K_t`, `Q_tδ ≠ 0` and `n_q P_tE = −D (ω² + ω_q² K_t²)/(ω_q Q_tδ)`. Static
evidence on the model. -/
@[tmio M, powerlib_domain] theorem Model.hopf_relations (m : Model) (hM : 0 < m.q.M)
    (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (h : m.IsHopf) :
    0 < m.hopfFreq ∧
      m.q.Ptδ m.δ (m.q.emf m.Qf) = QVDroop.hopfA m.q.M m.q.D m.q.ωq m.hopfFreq
        (m.q.gain m.δ (m.q.emf m.Qf)) ∧
      m.q.Qtδ m.δ (m.q.emf m.Qf) ≠ 0 ∧
      m.q.nq * m.q.PtE m.δ (m.q.emf m.Qf) = QVDroop.hopfB m.q.D m.q.ωq m.hopfFreq
        (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.Qtδ m.δ (m.q.emf m.Qf)) := by
  obtain ⟨-, hA, hC, hG⟩ := h
  have hGe := m.q.routhHopf_eq m.δ (m.q.emf m.Qf)
  have ha1 : 0 < m.q.Ptδ m.δ (m.q.emf m.Qf) + m.q.D * m.q.ωq * m.q.gain m.δ (m.q.emf m.Qf) := by
    rw [hG] at hGe
    have : 0 < m.q.routhTrace m.δ (m.q.emf m.Qf) *
        (m.q.Ptδ m.δ (m.q.emf m.Qf) + m.q.D * m.q.ωq * m.q.gain m.δ (m.q.emf m.Qf)) := by
      nlinarith [mul_pos (mul_pos hM hω) hC]
    exact pos_of_mul_pos_right this hA.le
  have hw : 0 < m.hopfFreq := Real.sqrt_pos.mpr (div_pos ha1 hM)
  have hw2 : m.hopfFreq ^ 2 = (m.q.Ptδ m.δ (m.q.emf m.Qf) +
      m.q.D * m.q.ωq * m.q.gain m.δ (m.q.emf m.Qf)) / m.q.M :=
    Real.sq_sqrt (div_pos ha1 hM).le
  generalize m.hopfFreq = w at hw hw2 ⊢
  have ha : m.q.Ptδ m.δ (m.q.emf m.Qf) = QVDroop.hopfA m.q.M m.q.D m.q.ωq w
      (m.q.gain m.δ (m.q.emf m.Qf)) := by
    rw [QVDroop.hopfA, hw2]; field_simp; ring
  have hbc : m.q.ωq * ((m.q.nq * m.q.PtE m.δ (m.q.emf m.Qf)) * m.q.Qtδ m.δ (m.q.emf m.Qf)) =
      -(m.q.D * (w ^ 2 + m.q.ωq ^ 2 * m.q.gain m.δ (m.q.emf m.Qf) ^ 2)) := by
    have hG' := hG
    simp only [routhHopf, coupling] at hG'
    rw [ha, QVDroop.hopfA] at hG'
    have : m.q.M * (m.q.D * (w ^ 2 + m.q.ωq ^ 2 * m.q.gain m.δ (m.q.emf m.Qf) ^ 2) +
        m.q.ωq * ((m.q.nq * m.q.PtE m.δ (m.q.emf m.Qf)) * m.q.Qtδ m.δ (m.q.emf m.Qf))) = 0 := by
      linear_combination hG'
    linear_combination (mul_eq_zero.mp this).resolve_left hM.ne'
  have hc : m.q.Qtδ m.δ (m.q.emf m.Qf) ≠ 0 := by
    intro h0
    rw [h0, mul_zero, mul_zero] at hbc
    have : 0 < m.q.D * (w ^ 2 + m.q.ωq ^ 2 * m.q.gain m.δ (m.q.emf m.Qf) ^ 2) := by positivity
    linarith
  refine ⟨hw, ha, hc, ?_⟩
  rw [QVDroop.hopfB, eq_div_iff (mul_ne_zero hω.ne' hc)]
  linear_combination hbc

/-- **The Hopf data of the model.** At a Hopf point with `M, D, ω_q > 0` and `E* ≠ 0`, the pair
`(QVDroop.hopfQ, QVDroop.hopfP)` (at the data `ω = hopfFreq`, `k = K_t`, `c = Q_tδ`) is critical,
`ℓ₁ = hopfNum/QVDroop.hopfDen` and `det(sI − J) = (s² + ω²)(s + A/M)`. Static evidence on the
model. -/
@[tmio M, powerlib_domain] theorem Model.hopf_data (m : Model) (hM : 0 < m.q.M)
    (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (hE : m.q.emf m.Qf ≠ 0) (h : m.IsHopf) :
    IsCriticalPair m.field 0 m.hopfFreq
        (QVDroop.hopfQ m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))
          (m.q.Qtδ m.δ (m.q.emf m.Qf)))
        (QVDroop.hopfP m.q.M m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))
          (m.q.Qtδ m.δ (m.q.emf m.Qf))) ∧
      firstLyapunov m.field 0 m.hopfFreq
          (QVDroop.hopfQ m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))
            (m.q.Qtδ m.δ (m.q.emf m.Qf)))
          (QVDroop.hopfP m.q.M m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))
            (m.q.Qtδ m.δ (m.q.emf m.Qf))) =
        m.hopfNumAt / QVDroop.hopfDen m.q.M m.q.D m.q.ωq m.hopfFreq
          (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.Qtδ m.δ (m.q.emf m.Qf)) ∧
      (jacobianC m.field 0).charpoly =
        (Polynomial.X ^ 2 + Polynomial.C ((m.hopfFreq : ℂ) ^ 2)) *
          (Polynomial.X +
            Polynomial.C (((m.q.routhTrace m.δ (m.q.emf m.Qf)) / m.q.M : ℝ) : ℂ)) := by
  obtain ⟨hw, ha, hc, hb⟩ := m.hopf_relations hM hD hω h
  obtain ⟨heq, hA, -, -⟩ := h
  have hL : 0 < QVDroop.hopfL m.q.M m.q.D m.q.ωq (m.q.gain m.δ (m.q.emf m.Qf)) := by
    have : QVDroop.hopfL m.q.M m.q.D m.q.ωq (m.q.gain m.δ (m.q.emf m.Qf)) =
        m.q.routhTrace m.δ (m.q.emf m.Qf) := by simp only [QVDroop.hopfL, routhTrace]; ring
    rw [this]; exact hA
  have hJ : jacobianC m.field 0 = Linear.complexify (QVDroop.hopfJ m.q.M m.q.D m.q.ωq
      m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.Qtδ m.δ (m.q.emf m.Qf))) := by
    rw [m.jacobianC_field, Model.jacobian, jacobian_eq_droopJacobian, ha, hb]
  have hB : ∀ u v, bilinC m.field 0 u v = bForm m.q.M m.q.ωq (QVDroop.hopfA m.q.M m.q.D m.q.ωq
      m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))) (QVDroop.hopfB m.q.D m.q.ωq m.hopfFreq
      (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.Qtδ m.δ (m.q.emf m.Qf))) (m.q.Qtδ m.δ (m.q.emf m.Qf))
      (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.nq / m.q.emf m.Qf) (m.q.Ptδδ m.δ (m.q.emf m.Qf))
      (m.q.Qtδδ m.δ (m.q.emf m.Qf)) u v := by
    intro u v; rw [m.bilinC_field hE, ha, hb]
  have hT : ∀ u v z, trilinC m.field 0 u v z = cForm m.q.M m.q.ωq (QVDroop.hopfA m.q.M m.q.D
      m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))) (m.q.Qtδ m.δ (m.q.emf m.Qf))
      (m.q.nq / m.q.emf m.Qf) (m.q.Ptδδ m.δ (m.q.emf m.Qf)) (m.q.Qtδδ m.δ (m.q.emf m.Qf))
      u v z := by
    intro u v z; rw [m.trilinC_field hE, ha]
  have h0 : m.field 0 = 0 := by simpa [Model.field] using heq
  obtain ⟨hcp, hl⟩ := hopf_isCriticalPair_firstLyapunov hM hω hw hc hL h0 hJ hB hT
  refine ⟨hcp, hl, ?_⟩
  refine Polynomial.funext fun s => ?_
  rw [hJ, ← Linear.det_characteristicMatrix_eq_eval,
    Criteria.det_characteristicMatrix_droopJacobian hM.ne']
  have e1 : ((QVDroop.hopfA m.q.M m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf)) +
      m.q.D * m.q.ωq * m.q.gain m.δ (m.q.emf m.Qf)) / m.q.M : ℝ) = m.hopfFreq ^ 2 := by
    rw [QVDroop.hopfA]; field_simp; ring
  have e0 : (m.q.ωq * (m.q.gain m.δ (m.q.emf m.Qf) *
      QVDroop.hopfA m.q.M m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf)) -
      QVDroop.hopfB m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))
        (m.q.Qtδ m.δ (m.q.emf m.Qf)) * m.q.Qtδ m.δ (m.q.emf m.Qf)) / m.q.M : ℝ) =
      m.q.routhTrace m.δ (m.q.emf m.Qf) / m.q.M * m.hopfFreq ^ 2 := by
    rw [QVDroop.hopfA, QVDroop.hopfB, routhTrace, gain]
    field_simp
    ring
  rw [e1, e0]
  simp only [eval_mul, eval_add, eval_pow, eval_X, eval_C, routhTrace]
  push_cast
  ring

/-- **The sign law of `ℓ₁`.** At a Hopf point with `M, D, ω_q > 0`, `E* ≠ 0`, the first Lyapunov
coefficient of every critical pair has the sign of `hopfNum` at the data of the point
(`QVDroop.hopfDen > 0`; `Dynamics.CenterManifold.sign_firstLyapunov_eq_of_charpoly`). Static
evidence on the model. -/
@[tmio M, powerlib_domain] theorem Model.sign_firstLyapunov_hopf (m : Model) (hM : 0 < m.q.M)
    (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (hE : m.q.emf m.Qf ≠ 0) (h : m.IsHopf) {q p : Fin 3 → ℂ}
    (hqp : IsCriticalPair m.field 0 m.hopfFreq q p) :
    SignType.sign (firstLyapunov m.field 0 m.hopfFreq q p) = SignType.sign m.hopfNumAt := by
  obtain ⟨hcp, hl, hchar⟩ := m.hopf_data hM hD hω hE h
  obtain ⟨hw, -, hc, -⟩ := m.hopf_relations hM hD hω h
  have hA := h.2.1
  rw [Dynamics.CenterManifold.sign_firstLyapunov_eq_of_charpoly hchar
    (re_neg_of_eval_X_add_C (div_pos hA hM)) hcp hqp, hl]
  have hL : 0 < QVDroop.hopfL m.q.M m.q.D m.q.ωq (m.q.gain m.δ (m.q.emf m.Qf)) := by
    have : QVDroop.hopfL m.q.M m.q.D m.q.ωq (m.q.gain m.δ (m.q.emf m.Qf)) =
        m.q.routhTrace m.δ (m.q.emf m.Qf) := by simp only [QVDroop.hopfL, routhTrace]; ring
    rw [this]; exact hA
  have hDen : 0 < QVDroop.hopfDen m.q.M m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))
      (m.q.Qtδ m.δ (m.q.emf m.Qf)) := by
    unfold QVDroop.hopfDen QVDroop.hopfQ1 QVDroop.hopfQ4
    have := pow_pos (abs_pos.mpr hc) 2
    rw [sq_abs] at this
    positivity
  rcases lt_trichotomy m.hopfNumAt 0 with h0 | h0 | h0
  · rw [sign_neg h0, sign_neg (div_neg_of_neg_of_pos h0 hDen)]
  · rw [h0, zero_div]
  · rw [sign_pos h0, sign_pos (div_pos h0 hDen)]

/-- **A subcritical Hopf point is unstable.** For `M, D, ω_q > 0`, `E* ≠ 0`, a Hopf point
(`A > 0`, `C > 0`, `G = 0`) with `hopfNum > 0` is unstable
(`Dynamics.CenterManifold.unstable_of_firstLyapunov_pos_of_charpoly`). -/
@[tmio TM, powerlib_domain] theorem mem_den_unstable_of_hopfNum_pos (m : Model)
    (hM : 0 < m.q.M) (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (hE : m.q.emf m.Qf ≠ 0)
    (h : m.IsHopf) (hN : 0 < m.hopfNumAt) :
    connection% (m ∈ family.den (.flow .unstable)) := by
  unfold powerlib.TMIO.Statement
  rw [(connection_proof% family_isAutonomous.mem_den_flow)]
  obtain ⟨hcp, hl, hchar⟩ := m.hopf_data hM hD hω hE h
  have hs := m.sign_firstLyapunov_hopf hM hD hω hE h hcp
  rw [sign_pos hN, sign_eq_one_iff] at hs
  exact Dynamics.CenterManifold.unstable_of_firstLyapunov_pos_of_charpoly
    (m.contDiff_field (k := 1)) m.analyticAt_field hcp hchar
    (re_neg_of_eval_X_add_C (div_pos h.2.1 hM)) hs

/-- **A supercritical Hopf point is locally asymptotically stable.** For `M, D, ω_q > 0`,
`E* ≠ 0`, a Hopf point with `hopfNum < 0` is locally asymptotically stable
(`Dynamics.CenterManifold.localAsymptoticStable_of_firstLyapunov_neg_of_charpoly`); it is not
locally exponentially stable (`G = 0`, `mem_den_locallyExponentiallyStable_iff`). -/
@[tmio TM, powerlib_domain] theorem mem_den_locallyAsymptoticallyStable_of_hopfNum_neg
    (m : Model) (hM : 0 < m.q.M) (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (hE : m.q.emf m.Qf ≠ 0)
    (h : m.IsHopf) (hN : m.hopfNumAt < 0) :
    connection% (m ∈ family.den (.flow .locallyAsymptoticallyStable)) := by
  unfold powerlib.TMIO.Statement
  rw [(connection_proof% family_isAutonomous.mem_den_flow)]
  obtain ⟨hcp, hl, hchar⟩ := m.hopf_data hM hD hω hE h
  have hs := m.sign_firstLyapunov_hopf hM hD hω hE h hcp
  rw [sign_neg hN, sign_eq_neg_one_iff] at hs
  exact Dynamics.CenterManifold.localAsymptoticStable_of_firstLyapunov_neg_of_charpoly
    (m.contDiff_field (k := 1)) m.analyticAt_field hcp hchar
    (re_neg_of_eval_X_add_C (div_pos h.2.1 hM)) hs

/-! ## The complete local asymptotic and Lyapunov denotations -/

/-- **Local asymptotic stability, complete off the degenerate set.** For `M, D, ω_q > 0` and
`E* ≠ 0`, off the cusp set (`C = 0 → K_t ≠ 0 ∧ 𝔉 ≠ 0`), the double-zero set (`C = 0 → G ≠ 0`)
and the Bautin set (`IsHopf → hopfNum ≠ 0`): the model is locally asymptotically stable iff the
point is an equilibrium with `A, C, G > 0`, or a Hopf point with `hopfNum < 0`. -/
@[tmio TM, powerlib_domain] theorem mem_den_locallyAsymptoticallyStable_iff_complete (m : Model)
    (hM : 0 < m.q.M) (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (hE : m.q.emf m.Qf ≠ 0)
    (hcusp : m.q.routhFold m.δ (m.q.emf m.Qf) = 0 → m.q.gain m.δ (m.q.emf m.Qf) ≠ 0 ∧
      foldQuad (m.q.Ptδ m.δ (m.q.emf m.Qf)) (m.q.Qtδ m.δ (m.q.emf m.Qf))
        (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.nq / m.q.emf m.Qf) (m.q.Ptδδ m.δ (m.q.emf m.Qf))
        (m.q.Qtδδ m.δ (m.q.emf m.Qf)) ≠ 0)
    (hbt : m.q.routhFold m.δ (m.q.emf m.Qf) = 0 → m.q.routhHopf m.δ (m.q.emf m.Qf) ≠ 0)
    (hbautin : m.IsHopf → m.hopfNumAt ≠ 0) :
    connection% (m ∈ family.den (.flow .locallyAsymptoticallyStable) ↔
      m ∈ {m : Model | (m.q.field m.point = 0 ∧ 0 < m.q.routhTrace m.δ (m.q.emf m.Qf) ∧
        0 < m.q.routhFold m.δ (m.q.emf m.Qf) ∧ 0 < m.q.routhHopf m.δ (m.q.emf m.Qf)) ∨
        (m.IsHopf ∧ m.hopfNumAt < 0)}) := by
  have hles := mem_den_locallyExponentiallyStable_iff m hM hω
  unfold powerlib.TMIO.Statement at hles ⊢
  constructor
  · intro hl
    have hly := Spectral.den_las_subset_lyapunovStable hl
    have heq : m.q.field m.point = 0 :=
      Dynamics.isEquilibrium_of_lyapunovStable m.q.contDiff_field
        ((Spectral.mem_den_flow_iff_shift (f := fun m : Model => m.q.field)
          (pt := Model.point) family_isAutonomous).mp hly)
    have nu : m ∉ family.den (.flow .unstable) := fun hu =>
      Spectral.not_mem_den_lyapunovStable_of_unstable hu hly
    by_cases hG : m.q.routhHopf m.δ (m.q.emf m.Qf) = 0
    · right
      have hC : 0 < m.q.routhFold m.δ (m.q.emf m.Qf) := by
        rcases lt_trichotomy (m.q.routhFold m.δ (m.q.emf m.Qf)) 0 with hC | hC | hC
        · exact absurd (mem_den_unstable_of_violation m hM hω heq (Or.inr (Or.inl hC))) nu
        · exact absurd hG (hbt hC)
        · exact hC
      have hA : 0 < m.q.routhTrace m.δ (m.q.emf m.Qf) := by
        have hGe := m.q.routhHopf_eq m.δ (m.q.emf m.Qf)
        rw [hG] at hGe
        rcases lt_trichotomy (m.q.routhTrace m.δ (m.q.emf m.Qf)) 0 with hA | hA | hA
        · exact absurd (mem_den_unstable_of_violation m hM hω heq (Or.inl hA)) nu
        · rw [hA, zero_mul, zero_sub] at hGe
          nlinarith [mul_pos (mul_pos hM hω) hC]
        · exact hA
      have hH : m.IsHopf := ⟨heq, hA, hC, hG⟩
      refine ⟨hH, ?_⟩
      rcases (hbautin hH).lt_or_gt with hN | hN
      · exact hN
      · exact absurd (mem_den_unstable_of_hopfNum_pos m hM hD hω hE hH hN) nu
    · left
      have hfold : m.q.routhFold m.δ (m.q.emf m.Qf) = 0 → m.q.gain m.δ (m.q.emf m.Qf) ≠ 0 ∧
          m.q.emf m.Qf ≠ 0 ∧ foldQuad (m.q.Ptδ m.δ (m.q.emf m.Qf)) (m.q.Qtδ m.δ (m.q.emf m.Qf))
            (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.nq / m.q.emf m.Qf)
            (m.q.Ptδδ m.δ (m.q.emf m.Qf)) (m.q.Qtδδ m.δ (m.q.emf m.Qf)) ≠ 0 := fun h0 =>
        ⟨(hcusp h0).1, hE, (hcusp h0).2⟩
      have h := mem_den_locallyAsymptoticallyStable_iff_of_hopf_ne m hM hω hG hfold
      unfold powerlib.TMIO.Statement at h
      exact h.mp hl
  · rintro (h | ⟨hH, hN⟩)
    · exact Spectral.den_locallyExponentiallyStable_subset_las (hles.mpr h)
    · have h := mem_den_locallyAsymptoticallyStable_of_hopfNum_neg m hM hD hω hE hH hN
      unfold powerlib.TMIO.Statement at h
      exact h

/-- **Lyapunov stability, complete off the degenerate set**: under the hypotheses of
`mem_den_locallyAsymptoticallyStable_iff_complete`, the same two alternatives. -/
@[tmio TM, powerlib_domain] theorem mem_den_lyapunovStable_iff_complete (m : Model)
    (hM : 0 < m.q.M) (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (hE : m.q.emf m.Qf ≠ 0)
    (hcusp : m.q.routhFold m.δ (m.q.emf m.Qf) = 0 → m.q.gain m.δ (m.q.emf m.Qf) ≠ 0 ∧
      foldQuad (m.q.Ptδ m.δ (m.q.emf m.Qf)) (m.q.Qtδ m.δ (m.q.emf m.Qf))
        (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.nq / m.q.emf m.Qf) (m.q.Ptδδ m.δ (m.q.emf m.Qf))
        (m.q.Qtδδ m.δ (m.q.emf m.Qf)) ≠ 0)
    (hbt : m.q.routhFold m.δ (m.q.emf m.Qf) = 0 → m.q.routhHopf m.δ (m.q.emf m.Qf) ≠ 0)
    (hbautin : m.IsHopf → m.hopfNumAt ≠ 0) :
    connection% (m ∈ family.den (.flow .lyapunovStable) ↔
      m ∈ {m : Model | (m.q.field m.point = 0 ∧ 0 < m.q.routhTrace m.δ (m.q.emf m.Qf) ∧
        0 < m.q.routhFold m.δ (m.q.emf m.Qf) ∧ 0 < m.q.routhHopf m.δ (m.q.emf m.Qf)) ∨
        (m.IsHopf ∧ m.hopfNumAt < 0)}) := by
  have hlas := mem_den_locallyAsymptoticallyStable_iff_complete m hM hD hω hE hcusp hbt hbautin
  unfold powerlib.TMIO.Statement at hlas ⊢
  constructor
  · intro hly
    have heq : m.q.field m.point = 0 :=
      Dynamics.isEquilibrium_of_lyapunovStable m.q.contDiff_field
        ((Spectral.mem_den_flow_iff_shift (f := fun m : Model => m.q.field)
          (pt := Model.point) family_isAutonomous).mp hly)
    have nu : m ∉ family.den (.flow .unstable) := fun hu =>
      Spectral.not_mem_den_lyapunovStable_of_unstable hu hly
    by_cases hG : m.q.routhHopf m.δ (m.q.emf m.Qf) = 0
    · right
      have hC : 0 < m.q.routhFold m.δ (m.q.emf m.Qf) := by
        rcases lt_trichotomy (m.q.routhFold m.δ (m.q.emf m.Qf)) 0 with hC | hC | hC
        · exact absurd (mem_den_unstable_of_violation m hM hω heq (Or.inr (Or.inl hC))) nu
        · exact absurd hG (hbt hC)
        · exact hC
      have hA : 0 < m.q.routhTrace m.δ (m.q.emf m.Qf) := by
        have hGe := m.q.routhHopf_eq m.δ (m.q.emf m.Qf)
        rw [hG] at hGe
        rcases lt_trichotomy (m.q.routhTrace m.δ (m.q.emf m.Qf)) 0 with hA | hA | hA
        · exact absurd (mem_den_unstable_of_violation m hM hω heq (Or.inl hA)) nu
        · rw [hA, zero_mul, zero_sub] at hGe
          nlinarith [mul_pos (mul_pos hM hω) hC]
        · exact hA
      have hH : m.IsHopf := ⟨heq, hA, hC, hG⟩
      refine ⟨hH, ?_⟩
      rcases (hbautin hH).lt_or_gt with hN | hN
      · exact hN
      · exact absurd (mem_den_unstable_of_hopfNum_pos m hM hD hω hE hH hN) nu
    · left
      have hfold : m.q.routhFold m.δ (m.q.emf m.Qf) = 0 → m.q.gain m.δ (m.q.emf m.Qf) ≠ 0 ∧
          m.q.emf m.Qf ≠ 0 ∧ foldQuad (m.q.Ptδ m.δ (m.q.emf m.Qf)) (m.q.Qtδ m.δ (m.q.emf m.Qf))
            (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.nq / m.q.emf m.Qf)
            (m.q.Ptδδ m.δ (m.q.emf m.Qf)) (m.q.Qtδδ m.δ (m.q.emf m.Qf)) ≠ 0 := fun h0 =>
        ⟨(hcusp h0).1, hE, (hcusp h0).2⟩
      have h := mem_den_lyapunovStable_iff_of_hopf_ne m hM hω hG hfold
      unfold powerlib.TMIO.Statement at h
      exact h.mp hly
  · intro h
    exact Spectral.den_las_subset_lyapunovStable (hlas.mpr h)

/-! ## Witnesses: a supercritical and a subcritical Hopf point with a virtual impedance -/

/-- A supercritical Hopf point at no load with a virtual impedance: `R_g = X_g = R_v = 1`,
`X_v = 1/2`, `V = n_q = E₀ = 1`, `Q_ref = P_ref = 0`, `ω_q = 1/10`, `D = 320/793`,
`M = 23000/793`, at `δ* = 0`, `Q_f* = 0` (`E* = 1`, `ω = 1/10`). -/
def hopfSuper : Model := ⟨⟨23000 / 793, 320 / 793, 1 / 10, 1, 1, 0, 0, 1, 1, 1, 1, 1 / 2⟩, 0, 0⟩

/-- A subcritical Hopf point at no load with a virtual impedance: `R_g = X_g = R_v = 1`,
`X_v = 2`, `V = n_q = E₀ = 1`, `Q_ref = P_ref = 0`, `ω_q = 1/10`, `D = 8/85`, `M = 412/17`, at
`δ* = 0`, `Q_f* = 0` (`E* = 1`, `ω = 1/10`). -/
def hopfSub : Model := ⟨⟨412 / 17, 8 / 85, 1 / 10, 1, 1, 0, 0, 1, 1, 1, 1, 2⟩, 0, 0⟩

@[tmio M, powerlib_domain] private theorem hopfSuper_isHopf : hopfSuper.IsHopf := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · apply Dynamics.state3_ext <;>
      simp [hopfSuper, Model.point, field, Pt_eq, Qt_eq, emf, ztsq]
  all_goals norm_num [hopfSuper, routhTrace, routhFold, routhHopf, gain, coupling, Ptδ, PtE,
    Qtδ, QtE, emf, ztsq]

@[tmio M, powerlib_domain] private theorem hopfSub_isHopf : hopfSub.IsHopf := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · apply Dynamics.state3_ext <;>
      simp [hopfSub, Model.point, field, Pt_eq, Qt_eq, emf, ztsq]
  all_goals norm_num [hopfSub, routhTrace, routhFold, routhHopf, gain, coupling, Ptδ, PtE,
    Qtδ, QtE, emf, ztsq]

@[tmio M, powerlib_domain] private theorem hopfSuper_freq : hopfSuper.hopfFreq = 1 / 10 := by
  rw [Model.hopfFreq, show (hopfSuper.q.Ptδ hopfSuper.δ (hopfSuper.q.emf hopfSuper.Qf) +
    hopfSuper.q.D * hopfSuper.q.ωq * hopfSuper.q.gain hopfSuper.δ
      (hopfSuper.q.emf hopfSuper.Qf)) / hopfSuper.q.M = (1 / 10) ^ 2 by
    norm_num [hopfSuper, gain, Ptδ, QtE, emf, ztsq]]
  exact Real.sqrt_sq (by norm_num)

@[tmio M, powerlib_domain] private theorem hopfSub_freq : hopfSub.hopfFreq = 1 / 10 := by
  rw [Model.hopfFreq, show (hopfSub.q.Ptδ hopfSub.δ (hopfSub.q.emf hopfSub.Qf) +
    hopfSub.q.D * hopfSub.q.ωq * hopfSub.q.gain hopfSub.δ
      (hopfSub.q.emf hopfSub.Qf)) / hopfSub.q.M = (1 / 10) ^ 2 by
    norm_num [hopfSub, gain, Ptδ, QtE, emf, ztsq]]
  exact Real.sqrt_sq (by norm_num)

/-- The supercritical witness has `hopfNum < 0`. Static evidence on the model. -/
@[tmio M, powerlib_domain] theorem hopfSuper_hopfNumAt : hopfSuper.hopfNumAt < 0 := by
  rw [Model.hopfNumAt, hopfSuper_freq]
  have e1 : hopfSuper.q.gain hopfSuper.δ (hopfSuper.q.emf hopfSuper.Qf) = 31 / 25 := by
    norm_num [hopfSuper, gain, QtE, emf, ztsq]
  have e2 : hopfSuper.q.Qtδ hopfSuper.δ (hopfSuper.q.emf hopfSuper.Qf) = -8 / 25 := by
    norm_num [hopfSuper, Qtδ, emf, ztsq]
  have e3 : hopfSuper.q.nq / hopfSuper.q.emf hopfSuper.Qf = 1 := by norm_num [hopfSuper, emf]
  have e4 : hopfSuper.q.Ptδδ hopfSuper.δ (hopfSuper.q.emf hopfSuper.Qf) = 0 := by
    norm_num [hopfSuper, Ptδδ, emf, ztsq]
  have e5 : hopfSuper.q.Qtδδ hopfSuper.δ (hopfSuper.q.emf hopfSuper.Qf) = 2 / 25 := by
    norm_num [hopfSuper, Qtδδ, emf, ztsq]
  rw [e1, e2, e3, e4, e5]
  norm_num [hopfSuper, hopfNum, hopfNum1, hopfNum2, hopfNum3]

/-- The subcritical witness has `hopfNum > 0`. Static evidence on the model. -/
@[tmio M, powerlib_domain] theorem hopfSub_hopfNumAt : 0 < hopfSub.hopfNumAt := by
  rw [Model.hopfNumAt, hopfSub_freq]
  have e1 : hopfSub.q.gain hopfSub.δ (hopfSub.q.emf hopfSub.Qf) = 16 / 13 := by
    norm_num [hopfSub, gain, QtE, emf, ztsq]
  have e2 : hopfSub.q.Qtδ hopfSub.δ (hopfSub.q.emf hopfSub.Qf) = -2 / 13 := by
    norm_num [hopfSub, Qtδ, emf, ztsq]
  have e3 : hopfSub.q.nq / hopfSub.q.emf hopfSub.Qf = 1 := by norm_num [hopfSub, emf]
  have e4 : hopfSub.q.Ptδδ hopfSub.δ (hopfSub.q.emf hopfSub.Qf) = 0 := by
    norm_num [hopfSub, Ptδδ, emf, ztsq]
  have e5 : hopfSub.q.Qtδδ hopfSub.δ (hopfSub.q.emf hopfSub.Qf) = -1 / 13 := by
    norm_num [hopfSub, Qtδδ, emf, ztsq]
  rw [e1, e2, e3, e4, e5]
  norm_num [hopfSub, hopfNum, hopfNum1, hopfNum2, hopfNum3]

/-- **The supercritical witness is locally asymptotically stable**, not exponentially. -/
@[tmio TM, powerlib_domain] theorem hopfSuper_mem_den_locallyAsymptoticallyStable :
    connection% (hopfSuper ∈ family.den (.flow .locallyAsymptoticallyStable)) :=
  mem_den_locallyAsymptoticallyStable_of_hopfNum_neg hopfSuper (by norm_num [hopfSuper])
    (by norm_num [hopfSuper]) (by norm_num [hopfSuper]) (by norm_num [hopfSuper, emf])
    hopfSuper_isHopf hopfSuper_hopfNumAt

/-- **The subcritical witness is unstable.** -/
@[tmio TM, powerlib_domain] theorem hopfSub_mem_den_unstable :
    connection% (hopfSub ∈ family.den (.flow .unstable)) :=
  mem_den_unstable_of_hopfNum_pos hopfSub (by norm_num [hopfSub]) (by norm_num [hopfSub])
    (by norm_num [hopfSub]) (by norm_num [hopfSub, emf]) hopfSub_isHopf hopfSub_hopfNumAt

/-- **The local asymptotic translation of `QVDroopVirtual.family` is not exact**: the
supercritical witness is locally asymptotically stable without a Hurwitz Jacobian (`G = 0`). -/
@[tmio TM, powerlib_domain] theorem not_exact_locallyAsymptoticallyStable :
    connection% (¬ family.Exact (.flow .locallyAsymptoticallyStable)) := by
  unfold powerlib.TMIO.Statement
  refine Spectral.not_exact_of_witness hopfSuper_mem_den_locallyAsymptoticallyStable
    (q := .stable) rfl ?_
  rintro ⟨-, hH⟩
  have h := (hopfSuper.q.isHurwitz_jacobian_iff (by norm_num [hopfSuper])
    (by norm_num [hopfSuper]) _ _).mp hH
  have hG := hopfSuper_isHopf.2.2.2
  exact lt_irrefl 0 (hG ▸ h.2.2)

/-- **The Lyapunov translation of `QVDroopVirtual.family` is not exact** (the supercritical
witness). -/
@[tmio TM, powerlib_domain] theorem not_exact_lyapunovStable :
    connection% (¬ family.Exact (.flow .lyapunovStable)) := by
  unfold powerlib.TMIO.Statement
  refine Spectral.not_exact_of_witness
    (Spectral.den_las_subset_lyapunovStable hopfSuper_mem_den_locallyAsymptoticallyStable)
    (q := .stable) rfl ?_
  rintro ⟨-, hH⟩
  have h := (hopfSuper.q.isHurwitz_jacobian_iff (by norm_num [hopfSuper])
    (by norm_num [hopfSuper]) _ _).mp hH
  have hG := hopfSuper_isHopf.2.2.2
  exact lt_irrefl 0 (hG ▸ h.2.2)

end QVDroopVirtual

end powerlib.GFM
