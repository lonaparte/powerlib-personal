    + 4 * c * d * σ ^ (2:ℕ) * O ^ (8:ℕ) - 6 * c * d * w ^ (2:ℕ) * O ^ (8:ℕ) +
    2 * c * σ * w ^ (2:ℕ) * O ^ (8:ℕ) + 2 * d * σ * w ^ (2:ℕ) * O ^ (8:ℕ)))) +
    (((σ ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (8:ℕ) - 3 * w ^ (4:ℕ) * O ^ (8:ℕ) + 2 * c * d * O ^ (10:ℕ) -
    2 * σ ^ (2:ℕ) * O ^ (10:ℕ)) + (3 * w ^ (2:ℕ) * O ^ (10:ℕ) - O ^ (12:ℕ) -
    4 * c ^ (2:ℕ) * d * N * σ ^ (6:ℕ) * w - 8 * c ^ (2:ℕ) * d * N * σ ^ (4:ℕ) * w ^ (3:ℕ) -
    4 * c ^ (2:ℕ) * d * N * σ ^ (2:ℕ) * w ^ (5:ℕ))) +
    ((-4 * c ^ (2:ℕ) * d * N * σ ^ (4:ℕ) * w * O ^ (2:ℕ) + 4 * c * N * σ ^ (6:ℕ) * w * O ^ (2:ℕ) -
    4 * c ^ (2:ℕ) * d * N * σ ^ (2:ℕ) * w ^ (3:ℕ) * O ^ (2:ℕ) +
    8 * c * N * σ ^ (4:ℕ) * w ^ (3:ℕ) * O ^ (2:ℕ)) + (4 * c * N * σ ^ (2:ℕ) * w ^ (5:ℕ) * O ^ (2:ℕ)
