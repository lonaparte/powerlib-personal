    ((4 * c ^ (2:ℕ) * d * σ * w ^ (4:ℕ) * O ^ (4:ℕ) + 4 * c * d ^ (2:ℕ) * σ * w ^ (4:ℕ) * O ^ (4:ℕ)
    + 4 * c * σ ^ (3:ℕ) * w ^ (4:ℕ) * O ^ (4:ℕ) + 4 * d * σ ^ (3:ℕ) * w ^ (4:ℕ) * O ^ (4:ℕ)) +
    (3 * σ ^ (4:ℕ) * w ^ (4:ℕ) * O ^ (4:ℕ) - 2 * c * d * w ^ (6:ℕ) * O ^ (4:ℕ) +
    2 * c * σ * w ^ (6:ℕ) * O ^ (4:ℕ) + 2 * d * σ * w ^ (6:ℕ) * O ^ (4:ℕ) +
    σ ^ (2:ℕ) * w ^ (6:ℕ) * O ^ (4:ℕ))))) + ((((-2 * c ^ (2:ℕ) * d ^ (2:ℕ) * σ ^ (2:ℕ) * O ^ (6:ℕ) +
    2 * σ ^ (6:ℕ) * O ^ (6:ℕ) + 3 * c ^ (2:ℕ) * d ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (6:ℕ) -
    2 * c ^ (2:ℕ) * d * σ * w ^ (2:ℕ) * O ^ (6:ℕ)) + (-2 * c * d ^ (2:ℕ) * σ * w ^ (2:ℕ) * O ^ (6:ℕ)
    - 2 * c * d * σ ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (6:ℕ) + 4 * c * σ ^ (3:ℕ) * w ^ (2:ℕ) * O ^ (6:ℕ) +
    4 * d * σ ^ (3:ℕ) * w ^ (2:ℕ) * O ^ (6:ℕ) + σ ^ (4:ℕ) * w ^ (2:ℕ) * O ^ (6:ℕ))) +
    ((6 * c * d * w ^ (4:ℕ) * O ^ (6:ℕ) - 4 * c * σ * w ^ (4:ℕ) * O ^ (6:ℕ) -
