    4 * c ^ (6:ℕ) * κ ^ (3:ℕ) * w ^ (4:ℕ) * ω ^ (6:ℕ) +
    30 * c ^ (6:ℕ) * κ * ν ^ (2:ℕ) * w ^ (4:ℕ) * ω ^ (6:ℕ) - 120 * c ^ (8:ℕ) * κ ^ (3:ℕ) * ω ^ (8:ℕ)
    + 52 * c ^ (6:ℕ) * κ ^ (3:ℕ) * w ^ (2:ℕ) * ω ^ (8:ℕ) -
    40 * c ^ (6:ℕ) * κ * ν ^ (2:ℕ) * w ^ (2:ℕ) * ω ^ (8:ℕ)) +
    (-120 * c ^ (6:ℕ) * κ ^ (3:ℕ) * ω ^ (10:ℕ) + c ^ (8:ℕ) * κ ^ (2:ℕ) * ν ^ (2:ℕ) * w ^ (6:ℕ) +
    5 * c ^ (8:ℕ) * κ ^ (2:ℕ) * ν ^ (2:ℕ) * w ^ (4:ℕ) * ω ^ (2:ℕ) +
    c ^ (8:ℕ) * κ ^ (4:ℕ) * w ^ (2:ℕ) * ω ^ (4:ℕ) -
    12 * c ^ (8:ℕ) * κ ^ (2:ℕ) * ν ^ (2:ℕ) * w ^ (2:ℕ) * ω ^ (4:ℕ) -
    25 * c ^ (8:ℕ) * κ ^ (4:ℕ) * ω ^ (6:ℕ)))))

/-- The real factor `4c²O² + 4O⁴ + 3c²K` of the reduced `⟨p̃, C(q, q, q̄)⟩` (lossless). -/
def AngleKey.lossTrilin {R : Type*} [CommRing R] (c K O : R) : R :=
  4 * c ^ 2 * O ^ 2 + 4 * O ^ 4 + 3 * c ^ 2 * K

/-- The reduced `a₀` (lossless): `c² w a₀ = w c O² A`. -/
def AngleKey.lossConstRed {R : Type*} [CommRing R] (c K w O : R) : R :=
  c ^ 2 * w ^ 2 - c ^ 2 * O ^ 2 + w ^ 2 * O ^ 2 - O ^ 4 - c ^ 2 * K

/-- `c ĉ(jO)` (lossless), real part. -/
def AngleKey.lossCubRe {R : Type*} [CommRing R] (c K w O : R) : R :=
  O ^ 2 * w ^ 2 + c ^ 2 * w ^ 2 - c ^ 2 * K - 2 * c ^ 2 * O ^ 2 - 2 * O ^ 4

/-- `c ĉ(jO)` (lossless), imaginary part. -/
def AngleKey.lossCubIm {R : Type*} [CommRing R] (c w O : R) : R := O * c * (w ^ 2 - O ^ 2)

/-- `c ĉ(2jO)` (lossless), real part. -/
def AngleKey.lossCub2Re {R : Type*} [CommRing R] (c K w O : R) : R :=
  c ^ 2 * w ^ 2 + O ^ 2 * w ^ 2 - c ^ 2 * K - 5 * c ^ 2 * O ^ 2 - 5 * O ^ 4

/-- `c ĉ(2jO)` (lossless), imaginary part. -/
def AngleKey.lossCub2Im {R : Type*} [CommRing R] (c w O : R) : R := 2 * O * c * (w ^ 2 - 4 * O ^ 2)

/-- The reduced `⟨p̃, B(q, r̄)⟩` without its factors `−c² (w² − O²)⁴` (lossless). -/
def AngleKey.lossBilinRed {R : Type*} [CommRing R] (c K N w O : R) : R :=
  c ^ (4:ℕ) * w ^ (4:ℕ) * O ^ (4:ℕ) - 2 * c ^ (4:ℕ) * w ^ (2:ℕ) * O ^ (6:ℕ) +
    2 * c ^ (2:ℕ) * w ^ (4:ℕ) * O ^ (6:ℕ) + c ^ (4:ℕ) * O ^ (8:ℕ) -
    4 * c ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (8:ℕ) + w ^ (4:ℕ) * O ^ (8:ℕ) + 2 * c ^ (2:ℕ) * O ^ (10:ℕ) -
    2 * w ^ (2:ℕ) * O ^ (10:ℕ) + O ^ (12:ℕ) + c ^ (4:ℕ) * K * w ^ (4:ℕ) * O ^ (2:ℕ) -
    3 * c ^ (4:ℕ) * K * w ^ (2:ℕ) * O ^ (4:ℕ) + c ^ (2:ℕ) * K * w ^ (4:ℕ) * O ^ (4:ℕ) +
    2 * c ^ (4:ℕ) * K * O ^ (6:ℕ) - 3 * c ^ (2:ℕ) * K * w ^ (2:ℕ) * O ^ (6:ℕ) +
    2 * c ^ (2:ℕ) * K * O ^ (8:ℕ) - c ^ (4:ℕ) * N ^ (2:ℕ) * w ^ (4:ℕ) -
    c ^ (4:ℕ) * K ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (2:ℕ) + c ^ (4:ℕ) * K ^ (2:ℕ) * O ^ (4:ℕ)

/-- The reduced `⟨p̃, B(q̄, s̄)⟩` without `(w² − O²)⁴` (lossless), real part. -/
def AngleKey.lossShiftRe {R : Type*} [CommRing R] (c K N w O : R) : R :=
  -3 * c ^ (7:ℕ) * w ^ (4:ℕ) * O ^ (4:ℕ) + 6 * c ^ (7:ℕ) * w ^ (2:ℕ) * O ^ (6:ℕ) -
    6 * c ^ (5:ℕ) * w ^ (4:ℕ) * O ^ (6:ℕ) + 9 * c ^ (7:ℕ) * O ^ (8:ℕ) +
    12 * c ^ (5:ℕ) * w ^ (2:ℕ) * O ^ (8:ℕ) - 3 * c ^ (3:ℕ) * w ^ (4:ℕ) * O ^ (8:ℕ) +
    18 * c ^ (5:ℕ) * O ^ (10:ℕ) + 6 * c ^ (3:ℕ) * w ^ (2:ℕ) * O ^ (10:ℕ) +
    9 * c ^ (3:ℕ) * O ^ (12:ℕ) - 3 * c ^ (7:ℕ) * K * w ^ (4:ℕ) * O ^ (2:ℕ) +
    9 * c ^ (7:ℕ) * K * w ^ (2:ℕ) * O ^ (4:ℕ) - 3 * c ^ (5:ℕ) * K * w ^ (4:ℕ) * O ^ (4:ℕ) +
    18 * c ^ (7:ℕ) * K * O ^ (6:ℕ) + 9 * c ^ (5:ℕ) * K * w ^ (2:ℕ) * O ^ (6:ℕ) +
    18 * c ^ (5:ℕ) * K * O ^ (8:ℕ) - c ^ (7:ℕ) * N ^ (2:ℕ) * w ^ (4:ℕ) +
    3 * c ^ (7:ℕ) * K ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (2:ℕ) +
    4 * c ^ (7:ℕ) * N ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (2:ℕ) + 9 * c ^ (7:ℕ) * K ^ (2:ℕ) * O ^ (4:ℕ)

/-- Its imaginary part. -/
def AngleKey.lossShiftIm {R : Type*} [CommRing R] (c K _N w O : R) : R :=
  -6 * c ^ (6:ℕ) * w ^ (4:ℕ) * O ^ (5:ℕ) + 6 * c ^ (6:ℕ) * w ^ (2:ℕ) * O ^ (7:ℕ) -
    6 * c ^ (4:ℕ) * w ^ (4:ℕ) * O ^ (7:ℕ) + 6 * c ^ (4:ℕ) * w ^ (2:ℕ) * O ^ (9:ℕ) -
    6 * c ^ (6:ℕ) * K * w ^ (4:ℕ) * O ^ (3:ℕ) + 6 * c ^ (6:ℕ) * K * w ^ (2:ℕ) * O ^ (5:ℕ)


/-- The reduced numerator `Û₀` (lossless), real part. -/
def AngleKey.lossNumRe (c K N w O : ℝ) : ℝ :=
  (((3 * c ^ (9:ℕ) * w ^ (6:ℕ) * O ^ (4:ℕ) - 21 * c ^ (9:ℕ) * w ^ (4:ℕ) * O ^ (6:ℕ) +
    9 * c ^ (7:ℕ) * w ^ (6:ℕ) * O ^ (6:ℕ) - 3 * c ^ (9:ℕ) * w ^ (2:ℕ) * O ^ (8:ℕ)) +
    (-63 * c ^ (7:ℕ) * w ^ (4:ℕ) * O ^ (8:ℕ) + 9 * c ^ (5:ℕ) * w ^ (6:ℕ) * O ^ (8:ℕ) +
    21 * c ^ (9:ℕ) * O ^ (10:ℕ) - 9 * c ^ (7:ℕ) * w ^ (2:ℕ) * O ^ (10:ℕ) -
    63 * c ^ (5:ℕ) * w ^ (4:ℕ) * O ^ (10:ℕ))) + ((3 * c ^ (3:ℕ) * w ^ (6:ℕ) * O ^ (10:ℕ) +
    63 * c ^ (7:ℕ) * O ^ (12:ℕ) - 9 * c ^ (5:ℕ) * w ^ (2:ℕ) * O ^ (12:ℕ) -
    21 * c ^ (3:ℕ) * w ^ (4:ℕ) * O ^ (12:ℕ) + 63 * c ^ (5:ℕ) * O ^ (14:ℕ)) +
    (-3 * c ^ (3:ℕ) * w ^ (2:ℕ) * O ^ (14:ℕ) + 21 * c ^ (3:ℕ) * O ^ (16:ℕ) -
    9 * c ^ (9:ℕ) * K * w ^ (4:ℕ) * O ^ (4:ℕ) + 6 * c ^ (9:ℕ) * K * w ^ (2:ℕ) * O ^ (6:ℕ) -
    18 * c ^ (7:ℕ) * K * w ^ (4:ℕ) * O ^ (6:ℕ)))) + (((39 * c ^ (9:ℕ) * K * O ^ (8:ℕ) +
    12 * c ^ (7:ℕ) * K * w ^ (2:ℕ) * O ^ (8:ℕ) - 9 * c ^ (5:ℕ) * K * w ^ (4:ℕ) * O ^ (8:ℕ) +
    78 * c ^ (7:ℕ) * K * O ^ (10:ℕ)) + (6 * c ^ (5:ℕ) * K * w ^ (2:ℕ) * O ^ (10:ℕ) +
    39 * c ^ (5:ℕ) * K * O ^ (12:ℕ) + 5 * c ^ (9:ℕ) * N ^ (2:ℕ) * w ^ (6:ℕ) -
    25 * c ^ (9:ℕ) * N ^ (2:ℕ) * w ^ (4:ℕ) * O ^ (2:ℕ) +
    5 * c ^ (7:ℕ) * N ^ (2:ℕ) * w ^ (6:ℕ) * O ^ (2:ℕ))) +
    ((9 * c ^ (9:ℕ) * K ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (4:ℕ) -
    4 * c ^ (9:ℕ) * N ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (4:ℕ) -
    25 * c ^ (7:ℕ) * N ^ (2:ℕ) * w ^ (4:ℕ) * O ^ (4:ℕ) + 15 * c ^ (9:ℕ) * K ^ (2:ℕ) * O ^ (6:ℕ) +
    9 * c ^ (7:ℕ) * K ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (6:ℕ)) +
    (-4 * c ^ (7:ℕ) * N ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (6:ℕ) + 15 * c ^ (7:ℕ) * K ^ (2:ℕ) * O ^ (8:ℕ) -
    5 * c ^ (9:ℕ) * K * N ^ (2:ℕ) * w ^ (4:ℕ) -
    4 * c ^ (9:ℕ) * K * N ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (2:ℕ) - 3 * c ^ (9:ℕ) * K ^ (3:ℕ) * O ^ (4:ℕ))))

/-- The reduced numerator `Û₀` (lossless), imaginary part. -/
def AngleKey.lossNumIm (c K N w O : ℝ) : ℝ :=
  6 * c ^ (8:ℕ) * w ^ (6:ℕ) * O ^ (5:ℕ) - 36 * c ^ (8:ℕ) * w ^ (4:ℕ) * O ^ (7:ℕ) +
    12 * c ^ (6:ℕ) * w ^ (6:ℕ) * O ^ (7:ℕ) - 18 * c ^ (8:ℕ) * w ^ (2:ℕ) * O ^ (9:ℕ) -
    72 * c ^ (6:ℕ) * w ^ (4:ℕ) * O ^ (9:ℕ) + 6 * c ^ (4:ℕ) * w ^ (6:ℕ) * O ^ (9:ℕ) +
    48 * c ^ (8:ℕ) * O ^ (11:ℕ) - 36 * c ^ (6:ℕ) * w ^ (2:ℕ) * O ^ (11:ℕ) -
    36 * c ^ (4:ℕ) * w ^ (4:ℕ) * O ^ (11:ℕ) + 96 * c ^ (6:ℕ) * O ^ (13:ℕ) -
    18 * c ^ (4:ℕ) * w ^ (2:ℕ) * O ^ (13:ℕ) + 48 * c ^ (4:ℕ) * O ^ (15:ℕ) -
    12 * c ^ (8:ℕ) * K * w ^ (4:ℕ) * O ^ (5:ℕ) - 12 * c ^ (8:ℕ) * K * w ^ (2:ℕ) * O ^ (7:ℕ) -
    12 * c ^ (6:ℕ) * K * w ^ (4:ℕ) * O ^ (7:ℕ) + 96 * c ^ (8:ℕ) * K * O ^ (9:ℕ) -
    12 * c ^ (6:ℕ) * K * w ^ (2:ℕ) * O ^ (9:ℕ) + 96 * c ^ (6:ℕ) * K * O ^ (11:ℕ) +
    12 * c ^ (8:ℕ) * N ^ (2:ℕ) * w ^ (6:ℕ) * O - 48 * c ^ (8:ℕ) * N ^ (2:ℕ) * w ^ (4:ℕ) * O ^ (3:ℕ)
    + 6 * c ^ (8:ℕ) * K ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (5:ℕ) + 48 * c ^ (8:ℕ) * K ^ (2:ℕ) * O ^ (7:ℕ)

/-- `W₀ = j ĉ(jO) ĉ(2jO)` (each cubic value times `c`, lossless), real part. -/
def AngleKey.lossDenRe (c K w O : ℝ) : ℝ :=
  -(AngleKey.lossCubRe c K w O * AngleKey.lossCub2Im c w O + AngleKey.lossCubIm c w O
      * AngleKey.lossCub2Re c K w O)

/-- `W₀`, imaginary part. -/
def AngleKey.lossDenIm (c K w O : ℝ) : ℝ :=
  AngleKey.lossCubRe c K w O * AngleKey.lossCub2Re c K w O - AngleKey.lossCubIm c w O
      * AngleKey.lossCub2Im c w O

/-- The lossless reduced numerator, real part, equals its factored form. Static algebra. -/
@[tmio M, powerlib_domain] theorem AngleKey.lossNumRe_eq (c K N w O : ℝ) :
    AngleKey.lossNumRe c K N w O = 3 * c ^ 3 * w ^ 2 * O ^ 2 * AngleKey.lossTrilin c K O
        * AngleKey.lossConstRed c K w O *
        AngleKey.lossCub2Re c K w O - 6 * c ^ 3 * AngleKey.lossBilinRed c K N w O
            * AngleKey.lossCub2Re c K w O +
      AngleKey.lossShiftRe c K N w O * AngleKey.lossConstRed c K w O := by
  simp only [AngleKey.lossNumRe, AngleKey.lossTrilin, AngleKey.lossConstRed, AngleKey.lossCub2Re,
      AngleKey.lossBilinRed, AngleKey.lossShiftRe]
  ring

/-- The lossless reduced numerator, imaginary part, equals its factored form. Static algebra. -/
@[tmio M, powerlib_domain] theorem AngleKey.lossNumIm_eq (c K N w O : ℝ) :
    AngleKey.lossNumIm c K N w O = 3 * c ^ 3 * w ^ 2 * O ^ 2 * AngleKey.lossTrilin c K O
        * AngleKey.lossConstRed c K w O * AngleKey.lossCub2Im c w O -
      6 * c ^ 3 * AngleKey.lossBilinRed c K N w O * AngleKey.lossCub2Im c w O
          + AngleKey.lossShiftIm c K N w O * AngleKey.lossConstRed c K w O := by
  simp only [AngleKey.lossNumIm, AngleKey.lossTrilin, AngleKey.lossConstRed, AngleKey.lossCub2Im,
      AngleKey.lossBilinRed, AngleKey.lossShiftIm]
  ring

/-- **The key identity of the lossless line**: `Re(Û₀ conj W₀) = −3 O c⁴ 𝔅_L`. -/
@[tmio M, powerlib_domain] theorem AngleKey.lossKey (c K N w O : ℝ) :
    AngleKey.lossNumRe c K N w O * AngleKey.lossDenRe c K w O + AngleKey.lossNumIm c K N w O
        * AngleKey.lossDenIm c K w O =
      -3 * O * c ^ 4 * lossBautin c K N w O := by
  simp only [AngleKey.lossNumRe, AngleKey.lossNumIm, AngleKey.lossDenRe, AngleKey.lossDenIm,
      AngleKey.lossCubRe, AngleKey.lossCubIm, AngleKey.lossCub2Re, AngleKey.lossCub2Im, lossBautin]
  ring

/-- The cast of `lossConstRed` from `ℝ` to `ℂ`. Static algebra. -/
@[tmio M, powerlib_domain] theorem AngleKey.lossConstRed_cast (c K w O : ℝ) :
    AngleKey.lossConstRed (c : ℂ) (K : ℂ) (w : ℂ) (O : ℂ)
        = ((AngleKey.lossConstRed c K w O : ℝ) : ℂ) := by
  simp only [AngleKey.lossConstRed]; push_cast; ring

/-- The cast of `lossTrilin` from `ℝ` to `ℂ`. Static algebra. -/
@[tmio M, powerlib_domain] theorem AngleKey.lossTrilin_cast (c K O : ℝ) :
    AngleKey.lossTrilin (c : ℂ) (K : ℂ) (O : ℂ) = ((AngleKey.lossTrilin c K O : ℝ) : ℂ) := by
  simp only [AngleKey.lossTrilin]; push_cast; ring

/-- The cast of `lossCubRe` from `ℝ` to `ℂ`. Static algebra. -/
@[tmio M, powerlib_domain] theorem AngleKey.lossCubRe_cast (c K w O : ℝ) :
    AngleKey.lossCubRe (c : ℂ) (K : ℂ) (w : ℂ) (O : ℂ)
        = ((AngleKey.lossCubRe c K w O : ℝ) : ℂ) := by
  simp only [AngleKey.lossCubRe]; push_cast; ring

/-- The cast of `lossCubIm` from `ℝ` to `ℂ`. Static algebra. -/
@[tmio M, powerlib_domain] theorem AngleKey.lossCubIm_cast (c w O : ℝ) :
    AngleKey.lossCubIm (c : ℂ) (w : ℂ) (O : ℂ) = ((AngleKey.lossCubIm c w O : ℝ) : ℂ) := by
  simp only [AngleKey.lossCubIm]; push_cast; ring

/-- The cast of `lossCub2Re` from `ℝ` to `ℂ`. Static algebra. -/
@[tmio M, powerlib_domain] theorem AngleKey.lossCub2Re_cast (c K w O : ℝ) :
    AngleKey.lossCub2Re (c : ℂ) (K : ℂ) (w : ℂ) (O : ℂ)
        = ((AngleKey.lossCub2Re c K w O : ℝ) : ℂ) := by
  simp only [AngleKey.lossCub2Re]; push_cast; ring

/-- The cast of `lossCub2Im` from `ℝ` to `ℂ`. Static algebra. -/
@[tmio M, powerlib_domain] theorem AngleKey.lossCub2Im_cast (c w O : ℝ) :
    AngleKey.lossCub2Im (c : ℂ) (w : ℂ) (O : ℂ) = ((AngleKey.lossCub2Im c w O : ℝ) : ℂ) := by
  simp only [AngleKey.lossCub2Im]; push_cast; ring

/-- The cast of `lossBilinRed` from `ℝ` to `ℂ`. Static algebra. -/
@[tmio M, powerlib_domain] theorem AngleKey.lossBilinRed_cast (c K N w O : ℝ) :
    AngleKey.lossBilinRed (c : ℂ) (K : ℂ) (N : ℂ) (w : ℂ) (O : ℂ)
        = ((AngleKey.lossBilinRed c K N w O : ℝ) : ℂ) := by
  simp only [AngleKey.lossBilinRed]; push_cast; ring

/-- The cast of `lossShiftRe` from `ℝ` to `ℂ`. Static algebra. -/
@[tmio M, powerlib_domain] theorem AngleKey.lossShiftRe_cast (c K N w O : ℝ) :
    AngleKey.lossShiftRe (c : ℂ) (K : ℂ) (N : ℂ) (w : ℂ) (O : ℂ)
        = ((AngleKey.lossShiftRe c K N w O : ℝ) : ℂ) := by
