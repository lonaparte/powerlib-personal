import theorem.Attributes
import Mathlib.Analysis.Complex.Basic
import Mathlib.Tactic.LinearCombination

/-! # The Bautin form of the VSM with a power filter on a dynamic line at every operating angle

Model boundary.
* Polynomial algebra only, no model and no behaviour: the reduced factors of Kuznetsov's
  projection formula for the first Lyapunov coefficient of the five-state VSM with a power
  filter on a dynamic R–L line (`Line.VSMLPF`), read in the frame rotated with the operating
  angle (`theorem/GridTiedConverter/GFM/HopfLineLPFAnglePattern.lean`), and the key identity of
  their projection. The atoms are `c = ω_c`, `d = D/M`, `N = ν = P_ref/M`, `σ = R/L`, `w = ω₀`
  and the Hopf frequency `O = ω`; the reactive power `K = Q/M` and the gain `g = E²/(M L)` are
  eliminated by the two Hopf relations (`2σcK = (dc − O²)(σ² + w² − O²) − 2σ(d + c)O²`,
  `2σcw g = (dc − O²)((σ² + w² − O²)² + 4σ²O²)`). The lossless line (`σ = 0`) has its own
  atoms `c`, `K = κ`, `N`, `w`, `O` (`d = O²/c` and `g` eliminated).

Source: the projection formula of Kuznetsov, *Elements of Applied Bifurcation Theory* (3rd ed.),
§3.5 and §5.4; the reductions, the factorizations and the Bautin forms were derived with exact
multivariate polynomial arithmetic (python-flint `fmpz_mpoly`: rational elimination of `K` and
`g`, Gaussian divisibility, factorization; untrusted discovery evidence) and every identity is
checked here by `ring`, the key identity split along the powers of `σ`
(`AngleKey.key` from nineteen coefficient identities).

Results.
* **The Bautin form at every operating angle** `Line.VSMLPF.angleBautin c d ν σ w ω =
  𝔅₀ + 4σ²wc 𝔉 ν (ν w c − (σ² + w² + ω²)(c d − ω²))` (degree 24, 1976 terms when expanded):
  `Line.VSMLPF.angleBautin0` (`𝔅₀`, 1208 terms, by its coefficients
  `Line.VSMLPF.angleBautin0Coeff` in the powers of `d`), `Line.VSMLPF.angleBautinF` (`𝔉`,
  260 terms); both even in `w` and `ω`.
* **The Bautin form of the lossless line** `Line.VSMLPF.lossBautin c κ ν w ω` (96 terms).
* The reduced factors: `AngleKey.cubRe`, `AngleKey.cubIm`, `AngleKey.cub2Re`, `AngleKey.cub2Im`
  (`2σ` times the cubic cofactor at `jω`, `2jω`), `AngleKey.constRed` (`a₀`), the reduced
  pairings `AngleKey.trilinRe`, `AngleKey.trilinIm`, `AngleKey.bilinRed`, `AngleKey.shiftRe`,
  `AngleKey.shiftIm`; the reduced numerator `Û` (`AngleKey.numRe`, `AngleKey.numIm`: 456 and 346
  terms; `AngleKey.numRe_eq`, `AngleKey.numIm_eq`, its factored form
  `Û = −3w²ω² A Z₁ ĉ₂ + 6 G₂ L ĉ₂ + A Z₃`) and `W = j ĉ(jω) ĉ(2jω)` (`AngleKey.denRe`,
  `AngleKey.denIm`).
* **`AngleKey.key`**: `Re(Û conj W) = 6σω 𝔅` for all values of the atoms.
* The lossless analogues `AngleKey.lossTrilin`, `AngleKey.lossConstRed`, `AngleKey.lossCubRe`,
  `AngleKey.lossCubIm`, `AngleKey.lossCub2Re`, `AngleKey.lossCub2Im`, `AngleKey.lossBilinRed`,
  `AngleKey.lossShiftRe`, `AngleKey.lossShiftIm`, `AngleKey.lossNumRe`, `AngleKey.lossNumIm`
  (`AngleKey.lossNumRe_eq`, `AngleKey.lossNumIm_eq`), `AngleKey.lossDenRe`,
  `AngleKey.lossDenIm` and **`AngleKey.lossKey`** (`Re(Û₀ conj W₀) = −3ωc⁴ 𝔅_L`); the casts
  `AngleKey.*_cast` of the polynomial definitions from `ℝ` to `ℂ`.
-/

noncomputable section
namespace powerlib.GFM.Line
namespace VSMLPF
open Complex

/-! ## The reduced factors (the frequency relations eliminate `K` and `g`) -/

/-- `2σ` times the cubic cofactor `ĉ(s) = s³ + a₄ s² + (a₃ − O²) s + (a₂ − a₄ O²)` at `jO`, real
part (`2σ a₂` with `K` eliminated by the first Hopf relation). -/
def AngleKey.cubRe {R : Type*} [CommRing R] (c d σ w O : R) : R :=
  2 * σ * ((d + c) * (σ ^ 2 + w ^ 2) + 2 * σ * d * c) -
    ((d * c - O ^ 2) * (σ ^ 2 + w ^ 2 - O ^ 2) - 2 * σ * (d + c) * O ^ 2) -
    4 * σ * (c + d + 2 * σ) * O ^ 2

/-- `2σ ĉ(jO)`, imaginary part. -/
def AngleKey.cubIm {R : Type*} [CommRing R] (c d σ w O : R) : R :=
  2 * σ * O * (σ ^ 2 + w ^ 2 + 2 * σ * (d + c) + d * c - 2 * O ^ 2)

/-- `2σ ĉ(2jO)`, real part. -/
def AngleKey.cub2Re {R : Type*} [CommRing R] (c d σ w O : R) : R :=
  2 * σ * ((d + c) * (σ ^ 2 + w ^ 2) + 2 * σ * d * c) -
    ((d * c - O ^ 2) * (σ ^ 2 + w ^ 2 - O ^ 2) - 2 * σ * (d + c) * O ^ 2) -
    10 * σ * (c + d + 2 * σ) * O ^ 2

/-- `2σ ĉ(2jO)`, imaginary part. -/
def AngleKey.cub2Im {R : Type*} [CommRing R] (c d σ w O : R) : R :=
  4 * σ * O * (σ ^ 2 + w ^ 2 + 2 * σ * (d + c) + d * c - 5 * O ^ 2)

/-- `a₀` reduced: `(2σc)(2σcw) a₀ = 2 w σ O² c² A`. -/
def AngleKey.constRed {R : Type*} [CommRing R] (c d σ w O : R) : R :=
  3 * c * d * σ ^ (2:ℕ) + 2 * c * σ ^ (3:ℕ) + 2 * d * σ ^ (3:ℕ) - c * d * w ^ (2:ℕ) +
    2 * c * σ * w ^ (2:ℕ) + 2 * d * σ * w ^ (2:ℕ) + c * d * O ^ (2:ℕ) - 3 * σ ^ (2:ℕ) * O ^ (2:ℕ) +
    w ^ (2:ℕ) * O ^ (2:ℕ) - O ^ (4:ℕ)

/-- The reduced `⟨p̃, C(q, q, q̄)⟩` without its factors `2wσc² Λ L`, real part. -/
def AngleKey.trilinRe {R : Type*} [CommRing R] (c d σ w O : R) : R :=
  -3 * c * d * σ ^ (4:ℕ) - 6 * c * d * σ ^ (2:ℕ) * w ^ (2:ℕ) - 3 * c * d * w ^ (4:ℕ) -
    2 * c * d * σ ^ (2:ℕ) * O ^ (2:ℕ) - 2 * c * σ ^ (3:ℕ) * O ^ (2:ℕ) -
    2 * d * σ ^ (3:ℕ) * O ^ (2:ℕ) + 3 * σ ^ (4:ℕ) * O ^ (2:ℕ) + 6 * c * d * w ^ (2:ℕ) * O ^ (2:ℕ) -
    2 * c * σ * w ^ (2:ℕ) * O ^ (2:ℕ) - 2 * d * σ * w ^ (2:ℕ) * O ^ (2:ℕ) +
    6 * σ ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (2:ℕ) + 3 * w ^ (4:ℕ) * O ^ (2:ℕ) - 3 * c * d * O ^ (4:ℕ) +
    2 * c * σ * O ^ (4:ℕ) + 2 * d * σ * O ^ (4:ℕ) + 2 * σ ^ (2:ℕ) * O ^ (4:ℕ) -
    6 * w ^ (2:ℕ) * O ^ (4:ℕ) + 3 * O ^ (6:ℕ)

/-- Its imaginary part. -/
def AngleKey.trilinIm {R : Type*} [CommRing R] (c d σ w O : R) : R :=
  -2 * c * d * σ ^ (3:ℕ) * O - 2 * c * d * σ * w ^ (2:ℕ) * O + 2 * c * d * σ * O ^ (3:ℕ) -
    4 * c * σ ^ (2:ℕ) * O ^ (3:ℕ) - 4 * d * σ ^ (2:ℕ) * O ^ (3:ℕ) + 2 * σ ^ (3:ℕ) * O ^ (3:ℕ) +
    2 * σ * w ^ (2:ℕ) * O ^ (3:ℕ) - 2 * σ * O ^ (5:ℕ)

/-- The reduced `⟨p̃, B(q, r̄)⟩` without its factors `2σc³ Λ L²` (real). -/
def AngleKey.bilinRed {R : Type*} [CommRing R] (c d N σ w O : R) : R :=
  ((((c ^ (2:ℕ) * d ^ (2:ℕ) * σ ^ (8:ℕ) + 3 * c ^ (2:ℕ) * d ^ (2:ℕ) * σ ^ (6:ℕ) * w ^ (2:ℕ) +
    3 * c ^ (2:ℕ) * d ^ (2:ℕ) * σ ^ (4:ℕ) * w ^ (4:ℕ) +
    c ^ (2:ℕ) * d ^ (2:ℕ) * σ ^ (2:ℕ) * w ^ (6:ℕ)) +
    (2 * c ^ (2:ℕ) * d ^ (2:ℕ) * σ ^ (6:ℕ) * O ^ (2:ℕ) - 2 * c * d * σ ^ (8:ℕ) * O ^ (2:ℕ) +
    c ^ (2:ℕ) * d ^ (2:ℕ) * σ ^ (4:ℕ) * w ^ (2:ℕ) * O ^ (2:ℕ) -
    2 * c ^ (2:ℕ) * d * σ ^ (5:ℕ) * w ^ (2:ℕ) * O ^ (2:ℕ) -
    2 * c * d ^ (2:ℕ) * σ ^ (5:ℕ) * w ^ (2:ℕ) * O ^ (2:ℕ))) +
    ((-6 * c * d * σ ^ (6:ℕ) * w ^ (2:ℕ) * O ^ (2:ℕ) -
    4 * c ^ (2:ℕ) * d * σ ^ (3:ℕ) * w ^ (4:ℕ) * O ^ (2:ℕ) -
    4 * c * d ^ (2:ℕ) * σ ^ (3:ℕ) * w ^ (4:ℕ) * O ^ (2:ℕ) -
    6 * c * d * σ ^ (4:ℕ) * w ^ (4:ℕ) * O ^ (2:ℕ)) + (c ^ (2:ℕ) * d ^ (2:ℕ) * w ^ (6:ℕ) * O ^ (2:ℕ)
    - 2 * c ^ (2:ℕ) * d * σ * w ^ (6:ℕ) * O ^ (2:ℕ) - 2 * c * d ^ (2:ℕ) * σ * w ^ (6:ℕ) * O ^ (2:ℕ)
    - 2 * c * d * σ ^ (2:ℕ) * w ^ (6:ℕ) * O ^ (2:ℕ) - 4 * c * d * σ ^ (6:ℕ) * O ^ (4:ℕ)))) +
    (((σ ^ (8:ℕ) * O ^ (4:ℕ) + c ^ (2:ℕ) * d ^ (2:ℕ) * σ ^ (2:ℕ) * w ^ (2:ℕ) * O ^ (4:ℕ) -
