/-- The cast of `lossShiftIm` from `ℝ` to `ℂ`. Static algebra. -/
@[tmio M, powerlib_domain] theorem AngleKey.lossShiftIm_cast (c K N w O : ℝ) :
    AngleKey.lossShiftIm (c : ℂ) (K : ℂ) (N : ℂ) (w : ℂ) (O : ℂ)
