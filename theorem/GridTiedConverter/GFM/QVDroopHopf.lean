    + D ^ (3:ℕ) * ω * w ^ (2:ℕ) * k * c ^ (4:ℕ)

/-- **The numerator of `ℓ₁` on the Hopf surface** (269 monomials in
`M, D, ω_q, ω, k, c, μ`, in 3 parts): `ℓ₁ = hopfNum/hopfDen` at the critical pair `hopfQ`,
`hopfP`. -/
def hopfNum (M D ω w k c μ : ℝ) : ℝ :=
  hopfNum1 M D ω w k c μ + hopfNum2 M D ω w k c μ + hopfNum3 M D ω w k c μ

/-- The denominator `4 c² ω³ L ((L² + M² ω²)(L² + 4 M² ω²))`, `L = D + M ω_q k`. -/
def hopfDen (M D ω w k c : ℝ) : ℝ :=
  4 * c ^ 2 * w ^ 3 * hopfL M D ω k * hopfQ1 M D ω w k * hopfQ4 M D ω w k

/-- The resolvent vector `r = A⁻¹ B(q, q̄)` (real). -/
def hopfR (M D ω w k c μ : ℝ) : Fin 3 → ℂ :=
  ![((hopfR0 M D ω w k c μ : ℝ) : ℂ), 0, ((hopfR2 M D ω w k c μ : ℝ) : ℂ)]

/-- The resolvent vector `s = (2iω − A)⁻¹ B(q, q)`. -/
def hopfS (M D ω w k c μ : ℝ) : Fin 3 → ℂ :=
  ![((hopfS0re M D ω w k c μ : ℝ) : ℂ) + ((hopfS0im M D ω w k c μ : ℝ) : ℂ) * I,
    ((hopfS1re M D ω w k c μ : ℝ) : ℂ) + ((hopfS1im M D ω w k c μ : ℝ) : ℂ) * I,
    ((hopfS2re M D ω w k c μ : ℝ) : ℂ) + ((hopfS2im M D ω w k c μ : ℝ) : ℂ) * I]

/-- The Jacobian on the Hopf surface. -/
abbrev hopfJ (M D ω w k c : ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  droopJacobian M D ω (hopfA M D ω w k) (hopfB D ω w k c) c k

variable {M D ω w k c μ : ℝ}

/-- The critical right eigenvector of the droop Jacobian on the Hopf surface:
`J hopfQ = iω hopfQ` (`M, ω_q, c ≠ 0`). -/
@[tmio M, powerlib_domain] theorem hopf_right (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0) :
    Linear.complexify (hopfJ M D ω w k c) *ᵥ hopfQ ω w k c = ((w : ℂ) * I) • hopfQ ω w k c := by
  ext i; fin_cases i
  all_goals simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three, droopJacobian, hopfQ, hopfA,
    hopfB, Complex.ext_iff, -Complex.ofReal_mul, -Complex.ofReal_div, -Complex.ofReal_pow,
    -Complex.ofReal_neg, -Complex.ofReal_sub, -Complex.ofReal_add, -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals (field_simp; try ring)

/-- The unnormalised conjugate left eigenvector of the droop Jacobian on the Hopf surface:
`Jᵀ hopfY = iω hopfY` (`M, ω_q, c ≠ 0`). -/
@[tmio M, powerlib_domain] theorem hopf_leftY (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0) :
    (Linear.complexify (hopfJ M D ω w k c))ᵀ *ᵥ hopfY M D ω w k c =
      ((w : ℂ) * I) • hopfY M D ω w k c := by
  ext i; fin_cases i
  all_goals simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three, droopJacobian, hopfY, hopfA,
    hopfB, Complex.ext_iff, -Complex.ofReal_mul, -Complex.ofReal_div, -Complex.ofReal_pow,
    -Complex.ofReal_neg, -Complex.ofReal_sub, -Complex.ofReal_add, -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals (field_simp; try ring)

/-- The pairing of the critical eigenvectors: `hopfY · hopfQ = hopfN0`. -/
@[tmio M, powerlib_domain] theorem hopf_dotYQ (hω : ω ≠ 0) (hc : c ≠ 0) :
    hopfY M D ω w k c ⬝ᵥ hopfQ ω w k c = hopfN0 M D ω w k := by
  simp [dotProduct, Fin.sum_univ_three, hopfY, hopfQ, hopfN0, hopfB, Complex.ext_iff,
    -Complex.ofReal_mul, -Complex.ofReal_div, -Complex.ofReal_pow, -Complex.ofReal_neg,
    -Complex.ofReal_sub, -Complex.ofReal_add, -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals (field_simp; try ring)

/-- The normalisation `hopfN0 = 2iω (ω_q k + iω)(D + M ω_q k + iMω)` is nonzero for `ω > 0`,
`L = D + M ω_q k > 0`. -/
@[tmio M, powerlib_domain] theorem hopfN0_ne (hw : 0 < w) (hL : 0 < hopfL M D ω k) :
    hopfN0 M D ω w k ≠ 0 := by
  have e : hopfN0 M D ω w k = (2 * (w : ℂ) * I) * (((ω * k : ℝ) : ℂ) + (w : ℂ) * I) *
      (((D + M * k * ω : ℝ) : ℂ) + ((M * w : ℝ) : ℂ) * I) := by
    apply Complex.ext <;>
      simp [hopfN0, -Complex.ofReal_mul, -Complex.ofReal_pow, -Complex.ofReal_add,
        -Complex.ofReal_neg, -Complex.ofReal_sub] <;> ring
  rw [e]
  refine mul_ne_zero (mul_ne_zero ?_ ?_) ?_
  · exact mul_ne_zero (mul_ne_zero two_ne_zero (by exact_mod_cast hw.ne')) I_ne_zero
  · intro h; have := congrArg Complex.im h; simp at this; exact hw.ne' this
  · intro h; have := congrArg Complex.re h; simp [hopfL] at this hL; linarith

/-- The determinant of the droop Jacobian on the Hopf surface: `det J = −ω² L/M`. -/
@[tmio M, powerlib_domain] theorem hopf_det (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0) :
    (Linear.complexify (hopfJ M D ω w k c)).det =
      ((-(w ^ 2 * hopfL M D ω k / M) : ℝ) : ℂ) := by
  rw [Matrix.det_fin_three]
  simp [droopJacobian, hopfA, hopfB, hopfL, Complex.ext_iff, -Complex.ofReal_mul,
    -Complex.ofReal_div, -Complex.ofReal_pow, -Complex.ofReal_neg, -Complex.ofReal_sub,
    -Complex.ofReal_add, -Complex.ofReal_inv]
  field_simp
  ring

/-- The determinant of `2iω − J` on the Hopf surface: `−3ω² L/M − 6ω³ i`. -/
@[tmio M, powerlib_domain] theorem hopf_det2 (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0) :
    (shift2 (Linear.complexify (hopfJ M D ω w k c)) w).det =
      ((-(3 * w ^ 2 * hopfL M D ω k / M)) : ℝ) + ((-6 * w ^ 3 : ℝ) : ℂ) * I := by
  rw [shift2, Matrix.det_fin_three]
  simp [droopJacobian, hopfA, hopfB, hopfL, Complex.ext_iff, -Complex.ofReal_mul,
    -Complex.ofReal_div, -Complex.ofReal_pow, -Complex.ofReal_neg, -Complex.ofReal_sub,
    -Complex.ofReal_add, -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals (field_simp; try ring)

@[tmio M, powerlib_domain] private theorem hopf_r (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0)
    (hw : w ≠ 0) (hL : hopfL M D ω k ≠ 0) :
    Linear.complexify (hopfJ M D ω w k c) *ᵥ hopfR M D ω w k c μ =
      bForm M ω (hopfA M D ω w k) (hopfB D ω w k c) c k μ (hopfQ ω w k c)
        (star (hopfQ ω w k c)) := by
  ext i; fin_cases i
  all_goals simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three, droopJacobian, hopfR, hopfR0,
    hopfR2, bForm, hopfQ, hopfA, hopfB, Complex.ext_iff, -Complex.ofReal_mul,
    -Complex.ofReal_div, -Complex.ofReal_pow, -Complex.ofReal_neg, -Complex.ofReal_sub,
    -Complex.ofReal_add, -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals (field_simp; (try simp only [hopfL]); ring)

@[tmio M, powerlib_domain] private theorem hopf_s (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0)
    (hw : w ≠ 0) (h4 : hopfQ4 M D ω w k ≠ 0) :
    shift2 (Linear.complexify (hopfJ M D ω w k c)) w *ᵥ hopfS M D ω w k c μ =
      bForm M ω (hopfA M D ω w k) (hopfB D ω w k c) c k μ (hopfQ ω w k c) (hopfQ ω w k c) := by
  ext i; fin_cases i
  all_goals simp [shift2, Matrix.mulVec, dotProduct, Fin.sum_univ_three, droopJacobian, hopfS,
    hopfS0re, hopfS0im, hopfS1re, hopfS1im, hopfS2re, hopfS2im, bForm, hopfQ, hopfA, hopfB,
    Complex.ext_iff, -Complex.ofReal_mul, -Complex.ofReal_div, -Complex.ofReal_pow,
    -Complex.ofReal_neg, -Complex.ofReal_sub, -Complex.ofReal_add, -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals (field_simp; (try simp only [hopfQ4, hopfL]); ring)

@[tmio M, powerlib_domain] private theorem hopf_Z1 (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0) :
    hopfY M D ω w k c ⬝ᵥ cForm M ω (hopfA M D ω w k) c μ (hopfQ ω w k c) (hopfQ ω w k c)
        (star (hopfQ ω w k c)) =
      ((hopfZ1re M D ω w k c μ : ℝ) : ℂ) + ((hopfZ1im M D ω w k c μ : ℝ) : ℂ) * I := by
  simp [dotProduct, Fin.sum_univ_three, cForm, hopfY, hopfQ, hopfA, hopfB, hopfZ1re, hopfZ1im,
    Complex.ext_iff, -Complex.ofReal_mul, -Complex.ofReal_div, -Complex.ofReal_pow,
    -Complex.ofReal_neg, -Complex.ofReal_sub, -Complex.ofReal_add, -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals (field_simp; ring)

@[tmio M, powerlib_domain] private theorem hopf_Z2 (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0)
    (hw : w ≠ 0) (hL : hopfL M D ω k ≠ 0) :
    hopfY M D ω w k c ⬝ᵥ bForm M ω (hopfA M D ω w k) (hopfB D ω w k c) c k μ (hopfQ ω w k c)
        (hopfR M D ω w k c μ) =
      ((hopfZ2re M D ω w k c μ : ℝ) : ℂ) + ((hopfZ2im M D ω w k c μ : ℝ) : ℂ) * I := by
  simp [dotProduct, Fin.sum_univ_three, bForm, hopfY, hopfQ, hopfR, hopfR0, hopfR2, hopfA,
    hopfB, hopfZ2re, hopfZ2im, hopfZ2reN, hopfZ2imN, Complex.ext_iff, -Complex.ofReal_mul,
    -Complex.ofReal_div,
    -Complex.ofReal_pow, -Complex.ofReal_neg, -Complex.ofReal_sub, -Complex.ofReal_add,
    -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals (field_simp; ring)

/-- `⟨ȳ, B(q̄, v)⟩` is linear in `v₀`, `v₂`. -/
@[tmio M, powerlib_domain] private theorem hopf_Z3_lin (v : Fin 3 → ℂ) :
    hopfY M D ω w k c ⬝ᵥ bForm M ω (hopfA M D ω w k) (hopfB D ω w k c) c k μ
        (star (hopfQ ω w k c)) v =
      v 0 * (hopfY M D ω w k c 1 * (((c / M : ℝ) : ℂ) * star (hopfQ ω w k c) 0 +
          ((μ * hopfA M D ω w k / M : ℝ) : ℂ) * star (hopfQ ω w k c) 2) +
        hopfY M D ω w k c 2 * (((ω * hopfA M D ω w k : ℝ) : ℂ) * star (hopfQ ω w k c) 0 -
          ((ω * μ * c : ℝ) : ℂ) * star (hopfQ ω w k c) 2)) +
      v 2 * (hopfY M D ω w k c 1 * (((μ * hopfA M D ω w k / M : ℝ) : ℂ) *
          star (hopfQ ω w k c) 0 - ((μ * (hopfB D ω w k c - μ * c) / M : ℝ) : ℂ) *
          star (hopfQ ω w k c) 2) +
        hopfY M D ω w k c 2 * (-((ω * μ * c : ℝ) : ℂ) * star (hopfQ ω w k c) 0 +
          ((ω * μ * (k - 1 + μ * hopfA M D ω w k) : ℝ) : ℂ) * star (hopfQ ω w k c) 2)) := by
  simp only [dotProduct, Fin.sum_univ_three, bForm, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
  ring

@[tmio M, powerlib_domain] private theorem hopf_Z3 (hM : M ≠ 0) (hω : ω ≠ 0) (hc : c ≠ 0)
    (hw : w ≠ 0) (h4 : hopfQ4 M D ω w k ≠ 0) :
    hopfY M D ω w k c ⬝ᵥ bForm M ω (hopfA M D ω w k) (hopfB D ω w k c) c k μ
        (star (hopfQ ω w k c)) (hopfS M D ω w k c μ) =
      ((hopfZ3re M D ω w k c μ : ℝ) : ℂ) + ((hopfZ3im M D ω w k c μ : ℝ) : ℂ) * I := by
  rw [hopf_Z3_lin]
  simp only [hopfS, Matrix.cons_val_zero, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons]
  simp [hopfY, hopfQ, hopfA, hopfB, Complex.ext_iff, -Complex.ofReal_mul, -Complex.ofReal_div,
    -Complex.ofReal_pow, -Complex.ofReal_neg, -Complex.ofReal_sub, -Complex.ofReal_add,
    -Complex.ofReal_inv]
  all_goals (try refine ⟨?_, ?_⟩)
  all_goals
    simp only [hopfS0re, hopfS0im, hopfS2re, hopfS2im, hopfZ3re, hopfZ3im, hopfZ3reN, hopfZ3imN]
    field_simp
    ring

/-- The numerator identity: `6 ω² (ω² + ω_q² k²) hopfNum = Re(Z) Re(n₀) + ω Im(Z) Im(n₀)` with the
cleared pairing numerators. -/
@[tmio M, powerlib_domain] private theorem hopfNum_eq :
    6 * w ^ 2 * (w ^ 2 + ω ^ 2 * k ^ 2) * hopfNum M D ω w k c μ =
      (3 * c ^ 2 * w ^ 2 * hopfL M D ω k * hopfQ4 M D ω w k * hopfZ1re M D ω w k c μ -
          6 * hopfQ4 M D ω w k * hopfZ2reN M D ω w k c μ +
          hopfL M D ω k * hopfZ3reN M D ω w k c μ) * (-2 * w ^ 2 * (D + 2 * M * k * ω)) +
        w * (3 * c ^ 2 * w * hopfL M D ω k * hopfQ4 M D ω w k * hopfZ1im M D ω w k c μ -
          6 * hopfQ4 M D ω w k * hopfZ2imN M D ω w k c μ +
          hopfL M D ω k * hopfZ3imN M D ω w k c μ) *
          (2 * w * (D * k * ω + M * k ^ 2 * ω ^ 2 - M * w ^ 2)) := by
  simp only [hopfNum, hopfNum1, hopfNum2, hopfNum3, hopfZ1re, hopfZ1im, hopfZ2reN, hopfZ2imN,
    hopfZ3reN, hopfZ3imN, hopfL, hopfQ4]
  ring

@[tmio M, powerlib_domain] private theorem hopf_final (hc : c ≠ 0) (hw : 0 < w)
    (hL : 0 < hopfL M D ω k) :
    1 / (2 * w) * ((((hopfZ1re M D ω w k c μ : ℝ) : ℂ) + ((hopfZ1im M D ω w k c μ : ℝ) : ℂ) * I -
        2 * (((hopfZ2re M D ω w k c μ : ℝ) : ℂ) + ((hopfZ2im M D ω w k c μ : ℝ) : ℂ) * I) +
        (((hopfZ3re M D ω w k c μ : ℝ) : ℂ) + ((hopfZ3im M D ω w k c μ : ℝ) : ℂ) * I)) /
        hopfN0 M D ω w k).re =
      hopfNum M D ω w k c μ / hopfDen M D ω w k c := by
  have hQ1 : 0 < hopfQ1 M D ω w k := by unfold hopfQ1; positivity
  have hQ4 : 0 < hopfQ4 M D ω w k := by unfold hopfQ4; positivity
  have hk2 : 0 < w ^ 2 + ω ^ 2 * k ^ 2 := by positivity
  have hn : Complex.normSq (hopfN0 M D ω w k) =
      4 * w ^ 2 * (w ^ 2 + ω ^ 2 * k ^ 2) * hopfQ1 M D ω w k := by
    simp [Complex.normSq_apply, hopfN0, hopfQ1, hopfL, -Complex.ofReal_mul, -Complex.ofReal_pow,
      -Complex.ofReal_add, -Complex.ofReal_neg, -Complex.ofReal_sub]
    ring
  rw [Complex.div_re, hn]
  simp only [Complex.add_re, Complex.sub_re, Complex.mul_re, Complex.add_im, Complex.sub_im,
    Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im,
    Complex.re_ofNat, Complex.im_ofNat, hopfN0]
  have key := hopfNum_eq (M := M) (D := D) (ω := ω) (w := w) (k := k) (c := c) (μ := μ)
  rw [hopfDen, hopfZ2re, hopfZ2im, hopfZ3re, hopfZ3im]
  generalize hopfNum M D ω w k c μ = N at key ⊢
  generalize hopfZ1re M D ω w k c μ = z1r at key ⊢
  generalize hopfZ1im M D ω w k c μ = z1i at key ⊢
  generalize hopfZ2reN M D ω w k c μ = z2r at key ⊢
  generalize hopfZ2imN M D ω w k c μ = z2i at key ⊢
  generalize hopfZ3reN M D ω w k c μ = z3r at key ⊢
  generalize hopfZ3imN M D ω w k c μ = z3i at key ⊢
  generalize hopfL M D ω k = L at key hL hQ1 hQ4 ⊢
  generalize hopfQ1 M D ω w k = Q1 at hQ1 ⊢
  generalize hopfQ4 M D ω w k = Q4 at key hQ4 ⊢
  field_simp
  linear_combination (-1 : ℝ) * key

/-- **The Hopf point algebra.** A field whose Jacobian, second and third derivatives at `x₀` are
the droop-loop data on the Hopf surface (`a = M ω² − D ω_q k`, `b = −D(ω² + ω_q² k²)/(ω_q c)`,
`M, ω_q, ω > 0`, `c ≠ 0`, `L = D + M ω_q k > 0`) and that vanishes at `x₀` has the critical pair
`(hopfQ, hopfP)` at the frequency `ω` and `ℓ₁ = hopfNum/hopfDen`. -/
@[tmio M, powerlib_domain] theorem hopf_isCriticalPair_firstLyapunov {F : State 3 → State 3}
    {x₀ : State 3} (hM : 0 < M) (hω : 0 < ω) (hw : 0 < w) (hc : c ≠ 0)
    (hL : 0 < hopfL M D ω k) (h0 : F x₀ = 0)
    (hJ : jacobianC F x₀ = Linear.complexify (hopfJ M D ω w k c))
    (hB : ∀ u v, bilinC F x₀ u v =
      bForm M ω (hopfA M D ω w k) (hopfB D ω w k c) c k μ u v)
    (hT : ∀ u v z, trilinC F x₀ u v z = cForm M ω (hopfA M D ω w k) c μ u v z) :
    IsCriticalPair F x₀ w (hopfQ ω w k c) (hopfP M D ω w k c) ∧
      firstLyapunov F x₀ w (hopfQ ω w k c) (hopfP M D ω w k c) =
        hopfNum M D ω w k c μ / hopfDen M D ω w k c := by
  have hN := hopfN0_ne hw hL
  have hQ4 : 0 < hopfQ4 M D ω w k := by unfold hopfQ4; positivity
  have hpstar : star (hopfP M D ω w k c) = fun j => hopfY M D ω w k c j / hopfN0 M D ω w k := by
    funext j; simp [hopfP]
  have hpair : ∀ v, pairing (hopfP M D ω w k c) v =
      (hopfY M D ω w k c ⬝ᵥ v) / hopfN0 M D ω w k := by
    intro v
    rw [pairing_eq_dotProduct, hpstar]
    simp only [dotProduct, Fin.sum_univ_three]
    ring
  refine ⟨⟨h0, hw, ?_, ?_, ?_⟩, ?_⟩
  · rw [hJ]; exact hopf_right hM.ne' hω.ne' hc
  · rw [hJ]
    have h := transpose_mulVec_conj_div (z := starRingEnd ℂ (hopfN0 M D ω w k))
      (hopf_leftY (D := D) (w := w) (k := k) hM.ne' hω.ne' hc)
    have e : starRingEnd ℂ ((w : ℂ) * I) = -((w : ℂ) * I) := by simp
    rw [e] at h
    exact h
  · rw [hpstar]
    simp only [dotProduct, Fin.sum_univ_three]
    have h := hopf_dotYQ (M := M) (D := D) (w := w) (k := k) hω.ne' hc
    simp only [dotProduct, Fin.sum_univ_three] at h
    rw [show hopfY M D ω w k c 0 / hopfN0 M D ω w k * hopfQ ω w k c 0 +
        hopfY M D ω w k c 1 / hopfN0 M D ω w k * hopfQ ω w k c 1 +
        hopfY M D ω w k c 2 / hopfN0 M D ω w k * hopfQ ω w k c 2 =
        (hopfY M D ω w k c 0 * hopfQ ω w k c 0 + hopfY M D ω w k c 1 * hopfQ ω w k c 1 +
          hopfY M D ω w k c 2 * hopfQ ω w k c 2) / hopfN0 M D ω w k by ring, h,
      div_self hN]
  · have hA : IsUnit (jacobianC F x₀).det := by
      rw [hJ, hopf_det hM.ne' hω.ne' hc]
      refine isUnit_iff_ne_zero.mpr (Complex.ofReal_ne_zero.mpr ?_)
      have : 0 < w ^ 2 * hopfL M D ω k / M := by positivity
      linarith
    have h2 : IsUnit (shift2 (jacobianC F x₀) w).det := by
      rw [hJ, hopf_det2 hM.ne' hω.ne' hc]
      refine isUnit_iff_ne_zero.mpr fun h => ?_
      have h' := congrArg Complex.re h
      simp only [Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.ofReal_im,
        Complex.I_re, Complex.I_im, Complex.zero_re, mul_zero, zero_mul, sub_zero,
        add_zero] at h'
      have : 0 < 3 * w ^ 2 * hopfL M D ω k / M := by positivity
      linarith
    have hr : jacobianC F x₀ *ᵥ hopfR M D ω w k c μ =
        bilinC F x₀ (hopfQ ω w k c) (star (hopfQ ω w k c)) := by
      rw [hJ, hB]; exact hopf_r hM.ne' hω.ne' hc hw.ne' hL.ne'
    have hs : shift2 (jacobianC F x₀) w *ᵥ hopfS M D ω w k c μ =
        bilinC F x₀ (hopfQ ω w k c) (hopfQ ω w k c) := by
      rw [hJ, hB]; exact hopf_s hM.ne' hω.ne' hc hw.ne' hQ4.ne'
    rw [firstLyapunov_eq_of_solve hA h2 hr hs, hpair, hpair, hpair, hT, hB, hB,
      hopf_Z1 hM.ne' hω.ne' hc, hopf_Z2 hM.ne' hω.ne' hc hw.ne' hL.ne',
      hopf_Z3 hM.ne' hω.ne' hc hw.ne' hQ4.ne', ← hopf_final (μ := μ) hc hw hL]
    congr 2
    ring

end Core

/-! ## The Hopf surface of the Q–V droop model -/

/-- The frequency `ω = √((P_δ + D ω_q K)/M)` at the selected point. -/
def Model.hopfFreq (m : Model) : ℝ :=
  √((m.q.Pδ m.δ (m.q.emf m.Qf) + m.q.D * m.q.ωq * m.q.gain m.δ (m.q.emf m.Qf)) / m.q.M)

/-- The numerator `hopfNum` at the data of the selected point. -/
def Model.hopfNumAt (m : Model) : ℝ :=
  hopfNum m.q.M m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))
    (m.q.Qδ m.δ (m.q.emf m.Qf)) (m.q.nq / m.q.emf m.Qf)

/-- A Hopf point of the Routh region: an equilibrium with `A > 0`, `C > 0`, `G = 0`. -/
def Model.IsHopf (m : Model) : Prop :=
  m.q.field m.point = 0 ∧ 0 < m.q.routhTrace m.δ (m.q.emf m.Qf) ∧
    0 < m.q.routhFold m.δ (m.q.emf m.Qf) ∧ m.q.routhHopf m.δ (m.q.emf m.Qf) = 0

/-- **The Hopf relations.** At a Hopf point with `M, D, ω_q > 0`: `ω = hopfFreq > 0`,
`P_δ = M ω² − D ω_q K`, `Q_δ ≠ 0` and `n_q P_E = −D (ω² + ω_q² K²)/(ω_q Q_δ)`. Static evidence on
the model. -/
@[tmio M, powerlib_domain] theorem Model.hopf_relations (m : Model) (hM : 0 < m.q.M)
    (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (h : m.IsHopf) :
    0 < m.hopfFreq ∧
      m.q.Pδ m.δ (m.q.emf m.Qf) = hopfA m.q.M m.q.D m.q.ωq m.hopfFreq
        (m.q.gain m.δ (m.q.emf m.Qf)) ∧
      m.q.Qδ m.δ (m.q.emf m.Qf) ≠ 0 ∧
      m.q.nq * m.q.PE m.δ (m.q.emf m.Qf) = hopfB m.q.D m.q.ωq m.hopfFreq
        (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.Qδ m.δ (m.q.emf m.Qf)) := by
  obtain ⟨-, hA, hC, hG⟩ := h
  have hGe := m.q.routhHopf_eq m.δ (m.q.emf m.Qf)
  have ha1 : 0 < m.q.Pδ m.δ (m.q.emf m.Qf) + m.q.D * m.q.ωq * m.q.gain m.δ (m.q.emf m.Qf) := by
    rw [hG] at hGe
    have : 0 < m.q.routhTrace m.δ (m.q.emf m.Qf) *
        (m.q.Pδ m.δ (m.q.emf m.Qf) + m.q.D * m.q.ωq * m.q.gain m.δ (m.q.emf m.Qf)) := by
      nlinarith [mul_pos (mul_pos hM hω) hC]
    exact pos_of_mul_pos_right this hA.le
  have hw : 0 < m.hopfFreq := Real.sqrt_pos.mpr (div_pos ha1 hM)
  have hw2 : m.hopfFreq ^ 2 = (m.q.Pδ m.δ (m.q.emf m.Qf) +
      m.q.D * m.q.ωq * m.q.gain m.δ (m.q.emf m.Qf)) / m.q.M :=
    Real.sq_sqrt (div_pos ha1 hM).le
  generalize m.hopfFreq = w at hw hw2 ⊢
  have ha : m.q.Pδ m.δ (m.q.emf m.Qf) = hopfA m.q.M m.q.D m.q.ωq w
      (m.q.gain m.δ (m.q.emf m.Qf)) := by
    rw [hopfA, hw2]; field_simp; ring
  have hbc : m.q.ωq * ((m.q.nq * m.q.PE m.δ (m.q.emf m.Qf)) * m.q.Qδ m.δ (m.q.emf m.Qf)) =
      -(m.q.D * (w ^ 2 + m.q.ωq ^ 2 * m.q.gain m.δ (m.q.emf m.Qf) ^ 2)) := by
    have hG' := hG
    simp only [routhHopf, coupling] at hG'
    rw [ha, hopfA] at hG'
    have : m.q.M * (m.q.D * (w ^ 2 + m.q.ωq ^ 2 * m.q.gain m.δ (m.q.emf m.Qf) ^ 2) +
        m.q.ωq * ((m.q.nq * m.q.PE m.δ (m.q.emf m.Qf)) * m.q.Qδ m.δ (m.q.emf m.Qf))) = 0 := by
      linear_combination hG'
    linear_combination (mul_eq_zero.mp this).resolve_left hM.ne'
  have hc : m.q.Qδ m.δ (m.q.emf m.Qf) ≠ 0 := by
    intro h0
    rw [h0, mul_zero, mul_zero] at hbc
    have : 0 < m.q.D * (w ^ 2 + m.q.ωq ^ 2 * m.q.gain m.δ (m.q.emf m.Qf) ^ 2) := by positivity
    linarith
  refine ⟨hw, ha, hc, ?_⟩
  rw [hopfB, eq_div_iff (mul_ne_zero hω.ne' hc)]
  linear_combination hbc

/-- **The Hopf data of the model.** At a Hopf point with `M, D, ω_q > 0` and `E* ≠ 0`, the pair
`(hopfQ, hopfP)` (at the data `ω = hopfFreq`, `k = K`, `c = Q_δ`) is critical,
`ℓ₁ = hopfNum/hopfDen` and `det(sI − J) = (s² + ω²)(s + A/M)`. Static evidence on the model. -/
@[tmio M, powerlib_domain] theorem Model.hopf_data (m : Model) (hM : 0 < m.q.M)
    (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (hE : m.q.emf m.Qf ≠ 0) (h : m.IsHopf) :
    IsCriticalPair m.field 0 m.hopfFreq
        (hopfQ m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.Qδ m.δ (m.q.emf m.Qf)))
        (hopfP m.q.M m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))
          (m.q.Qδ m.δ (m.q.emf m.Qf))) ∧
      firstLyapunov m.field 0 m.hopfFreq
          (hopfQ m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.Qδ m.δ (m.q.emf m.Qf)))
          (hopfP m.q.M m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))
            (m.q.Qδ m.δ (m.q.emf m.Qf))) =
        m.hopfNumAt / hopfDen m.q.M m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))
          (m.q.Qδ m.δ (m.q.emf m.Qf)) ∧
      (jacobianC m.field 0).charpoly =
        (Polynomial.X ^ 2 + Polynomial.C ((m.hopfFreq : ℂ) ^ 2)) *
          (Polynomial.X +
            Polynomial.C (((m.q.routhTrace m.δ (m.q.emf m.Qf)) / m.q.M : ℝ) : ℂ)) := by
  obtain ⟨hw, ha, hc, hb⟩ := m.hopf_relations hM hD hω h
  obtain ⟨heq, hA, -, -⟩ := h
  have hL : 0 < hopfL m.q.M m.q.D m.q.ωq (m.q.gain m.δ (m.q.emf m.Qf)) := by
    have : hopfL m.q.M m.q.D m.q.ωq (m.q.gain m.δ (m.q.emf m.Qf)) =
        m.q.routhTrace m.δ (m.q.emf m.Qf) := by simp only [hopfL, routhTrace]; ring
    rw [this]; exact hA
  have hJ : jacobianC m.field 0 = Linear.complexify (hopfJ m.q.M m.q.D m.q.ωq m.hopfFreq
      (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.Qδ m.δ (m.q.emf m.Qf))) := by
    rw [m.jacobianC_field, Model.jacobian, jacobian_eq_droopJacobian, ha, hb]
  have hB : ∀ u v, bilinC m.field 0 u v = bForm m.q.M m.q.ωq (hopfA m.q.M m.q.D m.q.ωq
      m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))) (hopfB m.q.D m.q.ωq m.hopfFreq
      (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.Qδ m.δ (m.q.emf m.Qf))) (m.q.Qδ m.δ (m.q.emf m.Qf))
      (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.nq / m.q.emf m.Qf) u v := by
    intro u v; rw [m.bilinC_field hE, ha, hb]
  have hT : ∀ u v z, trilinC m.field 0 u v z = cForm m.q.M m.q.ωq (hopfA m.q.M m.q.D m.q.ωq
      m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))) (m.q.Qδ m.δ (m.q.emf m.Qf))
      (m.q.nq / m.q.emf m.Qf) u v z := by
    intro u v z; rw [m.trilinC_field hE, ha]
  have h0 : m.field 0 = 0 := by simpa [Model.field] using heq
  obtain ⟨hcp, hl⟩ := hopf_isCriticalPair_firstLyapunov hM hω hw hc hL h0 hJ hB hT
  refine ⟨hcp, hl, ?_⟩
  refine Polynomial.funext fun s => ?_
  rw [hJ, ← Linear.det_characteristicMatrix_eq_eval,
    Criteria.det_characteristicMatrix_droopJacobian hM.ne']
  have e1 : ((hopfA m.q.M m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf)) +
      m.q.D * m.q.ωq * m.q.gain m.δ (m.q.emf m.Qf)) / m.q.M : ℝ) = m.hopfFreq ^ 2 := by
    rw [hopfA]; field_simp; ring
  have e0 : (m.q.ωq * (m.q.gain m.δ (m.q.emf m.Qf) *
      hopfA m.q.M m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf)) -
      hopfB m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))
        (m.q.Qδ m.δ (m.q.emf m.Qf)) * m.q.Qδ m.δ (m.q.emf m.Qf)) / m.q.M : ℝ) =
      m.q.routhTrace m.δ (m.q.emf m.Qf) / m.q.M * m.hopfFreq ^ 2 := by
    rw [hopfA, hopfB, routhTrace, gain]
    field_simp
    ring
  rw [e1, e0]
  simp only [eval_mul, eval_add, eval_pow, eval_X, eval_C, routhTrace]
  push_cast
  ring

/-- **The sign law of `ℓ₁`.** At a Hopf point with `M, D, ω_q > 0`, `E* ≠ 0`, the first Lyapunov
coefficient of every critical pair has the sign of `hopfNum` at the data of the point
(`hopfDen > 0`; `NormalForm.LyapunovCoefficient.sign_firstLyapunov_eq_of_charpoly`). Static
evidence on the model. -/
@[tmio M, powerlib_domain] theorem Model.sign_firstLyapunov_hopf (m : Model) (hM : 0 < m.q.M)
    (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (hE : m.q.emf m.Qf ≠ 0) (h : m.IsHopf) {q p : Fin 3 → ℂ}
    (hqp : IsCriticalPair m.field 0 m.hopfFreq q p) :
    SignType.sign (firstLyapunov m.field 0 m.hopfFreq q p) = SignType.sign m.hopfNumAt := by
  obtain ⟨hcp, hl, hchar⟩ := m.hopf_data hM hD hω hE h
  obtain ⟨hw, -, hc, -⟩ := m.hopf_relations hM hD hω h
  have hA := h.2.1
  rw [Dynamics.CenterManifold.sign_firstLyapunov_eq_of_charpoly hchar
    (re_neg_of_eval_X_add_C (div_pos hA hM)) hcp hqp, hl]
  have hL : 0 < hopfL m.q.M m.q.D m.q.ωq (m.q.gain m.δ (m.q.emf m.Qf)) := by
    have : hopfL m.q.M m.q.D m.q.ωq (m.q.gain m.δ (m.q.emf m.Qf)) =
        m.q.routhTrace m.δ (m.q.emf m.Qf) := by simp only [hopfL, routhTrace]; ring
    rw [this]; exact hA
  have hDen : 0 < hopfDen m.q.M m.q.D m.q.ωq m.hopfFreq (m.q.gain m.δ (m.q.emf m.Qf))
      (m.q.Qδ m.δ (m.q.emf m.Qf)) := by
    unfold hopfDen hopfQ1 hopfQ4
    have := pow_pos (abs_pos.mpr hc) 2
    rw [sq_abs] at this
    positivity
  rcases lt_trichotomy m.hopfNumAt 0 with h0 | h0 | h0
  · rw [sign_neg h0, sign_neg (div_neg_of_neg_of_pos h0 hDen)]
  · rw [h0, zero_div]
  · rw [sign_pos h0, sign_pos (div_pos h0 hDen)]

/-- **A subcritical Hopf point is unstable.** For `M, D, ω_q > 0`, `E* ≠ 0`, a Hopf point
(`A > 0`, `C > 0`, `G = 0`) with `hopfNum > 0` is unstable
(`Dynamics.CenterManifold.unstable_of_firstLyapunov_pos_of_charpoly`). -/
@[tmio TM, powerlib_domain] theorem mem_den_unstable_of_hopfNum_pos (m : Model)
    (hM : 0 < m.q.M) (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (hE : m.q.emf m.Qf ≠ 0)
    (h : m.IsHopf) (hN : 0 < m.hopfNumAt) :
    connection% (m ∈ family.den (.flow .unstable)) := by
  unfold powerlib.TMIO.Statement
  rw [(connection_proof% family_isAutonomous.mem_den_flow)]
  obtain ⟨hcp, hl, hchar⟩ := m.hopf_data hM hD hω hE h
  have hs := m.sign_firstLyapunov_hopf hM hD hω hE h hcp
  rw [sign_pos hN, sign_eq_one_iff] at hs
  exact Dynamics.CenterManifold.unstable_of_firstLyapunov_pos_of_charpoly
    (m.contDiff_field (k := 1)) m.analyticAt_field hcp hchar
    (re_neg_of_eval_X_add_C (div_pos h.2.1 hM)) hs

/-- **A supercritical Hopf point is locally asymptotically stable.** For `M, D, ω_q > 0`,
`E* ≠ 0`, a Hopf point with `hopfNum < 0` is locally asymptotically stable
(`Dynamics.CenterManifold.localAsymptoticStable_of_firstLyapunov_neg_of_charpoly`); it is not
locally exponentially stable (`G = 0`, `mem_den_locallyExponentiallyStable_iff`). -/
@[tmio TM, powerlib_domain] theorem mem_den_locallyAsymptoticallyStable_of_hopfNum_neg
    (m : Model) (hM : 0 < m.q.M) (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (hE : m.q.emf m.Qf ≠ 0)
    (h : m.IsHopf) (hN : m.hopfNumAt < 0) :
    connection% (m ∈ family.den (.flow .locallyAsymptoticallyStable)) := by
  unfold powerlib.TMIO.Statement
  rw [(connection_proof% family_isAutonomous.mem_den_flow)]
  obtain ⟨hcp, hl, hchar⟩ := m.hopf_data hM hD hω hE h
  have hs := m.sign_firstLyapunov_hopf hM hD hω hE h hcp
  rw [sign_neg hN, sign_eq_neg_one_iff] at hs
  exact Dynamics.CenterManifold.localAsymptoticStable_of_firstLyapunov_neg_of_charpoly
    (m.contDiff_field (k := 1)) m.analyticAt_field hcp hchar
    (re_neg_of_eval_X_add_C (div_pos h.2.1 hM)) hs

/-! ## The complete local asymptotic and Lyapunov denotations -/

/-- **Local asymptotic stability, complete off the degenerate set.** For `M, D, ω_q > 0` and
`E* ≠ 0`, off the cusp set (`C = 0 → K ≠ 0 ∧ 𝔉 ≠ 0`), the double-zero set (`C = 0 → G ≠ 0`) and
the Bautin set (`IsHopf → hopfNum ≠ 0`): the model is locally asymptotically stable iff the point
is an equilibrium with `A, C, G > 0`, or a Hopf point with `hopfNum < 0`. -/
@[tmio TM, powerlib_domain] theorem mem_den_locallyAsymptoticallyStable_iff_complete (m : Model)
    (hM : 0 < m.q.M) (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (hE : m.q.emf m.Qf ≠ 0)
    (hcusp : m.q.routhFold m.δ (m.q.emf m.Qf) = 0 → m.q.gain m.δ (m.q.emf m.Qf) ≠ 0 ∧
      foldQuad (m.q.Pδ m.δ (m.q.emf m.Qf)) (m.q.Qδ m.δ (m.q.emf m.Qf))
        (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.nq / m.q.emf m.Qf) ≠ 0)
    (hbt : m.q.routhFold m.δ (m.q.emf m.Qf) = 0 → m.q.routhHopf m.δ (m.q.emf m.Qf) ≠ 0)
    (hbautin : m.IsHopf → m.hopfNumAt ≠ 0) :
    connection% (m ∈ family.den (.flow .locallyAsymptoticallyStable) ↔
      m ∈ {m : Model | (m.q.field m.point = 0 ∧ 0 < m.q.routhTrace m.δ (m.q.emf m.Qf) ∧
        0 < m.q.routhFold m.δ (m.q.emf m.Qf) ∧ 0 < m.q.routhHopf m.δ (m.q.emf m.Qf)) ∨
        (m.IsHopf ∧ m.hopfNumAt < 0)}) := by
  have hles := mem_den_locallyExponentiallyStable_iff m hM hω
  unfold powerlib.TMIO.Statement at hles ⊢
  constructor
  · intro hl
    have hly := Spectral.den_las_subset_lyapunovStable hl
    have heq : m.q.field m.point = 0 :=
      Dynamics.isEquilibrium_of_lyapunovStable m.q.contDiff_field
        ((Spectral.mem_den_flow_iff_shift (f := fun m : Model => m.q.field)
          (pt := Model.point) family_isAutonomous).mp hly)
    have nu : m ∉ family.den (.flow .unstable) := fun hu =>
      Spectral.not_mem_den_lyapunovStable_of_unstable hu hly
    by_cases hG : m.q.routhHopf m.δ (m.q.emf m.Qf) = 0
    · right
      have hC : 0 < m.q.routhFold m.δ (m.q.emf m.Qf) := by
        rcases lt_trichotomy (m.q.routhFold m.δ (m.q.emf m.Qf)) 0 with hC | hC | hC
        · exact absurd (mem_den_unstable_of_violation m hM hω heq (Or.inr (Or.inl hC))) nu
        · exact absurd hG (hbt hC)
        · exact hC
      have hA : 0 < m.q.routhTrace m.δ (m.q.emf m.Qf) := by
        have hGe := m.q.routhHopf_eq m.δ (m.q.emf m.Qf)
        rw [hG] at hGe
        rcases lt_trichotomy (m.q.routhTrace m.δ (m.q.emf m.Qf)) 0 with hA | hA | hA
        · exact absurd (mem_den_unstable_of_violation m hM hω heq (Or.inl hA)) nu
        · rw [hA, zero_mul, zero_sub] at hGe
          nlinarith [mul_pos (mul_pos hM hω) hC]
        · exact hA
      have hH : m.IsHopf := ⟨heq, hA, hC, hG⟩
      refine ⟨hH, ?_⟩
      rcases (hbautin hH).lt_or_gt with hN | hN
      · exact hN
      · exact absurd (mem_den_unstable_of_hopfNum_pos m hM hD hω hE hH hN) nu
    · left
      have hfold : m.q.routhFold m.δ (m.q.emf m.Qf) = 0 → m.q.gain m.δ (m.q.emf m.Qf) ≠ 0 ∧
          m.q.emf m.Qf ≠ 0 ∧ foldQuad (m.q.Pδ m.δ (m.q.emf m.Qf)) (m.q.Qδ m.δ (m.q.emf m.Qf))
            (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.nq / m.q.emf m.Qf) ≠ 0 := fun h0 =>
        ⟨(hcusp h0).1, hE, (hcusp h0).2⟩
      have h := mem_den_locallyAsymptoticallyStable_iff_of_hopf_ne m hM hω hG hfold
      unfold powerlib.TMIO.Statement at h
      exact h.mp hl
  · rintro (h | ⟨hH, hN⟩)
    · exact Spectral.den_locallyExponentiallyStable_subset_las (hles.mpr h)
    · have h := mem_den_locallyAsymptoticallyStable_of_hopfNum_neg m hM hD hω hE hH hN
      unfold powerlib.TMIO.Statement at h
      exact h

/-! ## Witnesses: a supercritical and a subcritical Hopf point -/

/-- A supercritical Hopf point at no load: `R = X = V = n_q = E₀ = 1`, `Q_ref = P_ref = 0`,
`ω_q = 1/10`, `D = 10/13`, `M = 800/13`, at `δ* = 0`, `Q_f* = 0` (`E* = 1`, `ω = 1/10`). -/
def hopfSuper : Model := ⟨⟨800 / 13, 10 / 13, 1 / 10, 1, 1, 0, 0, 1, 1, 1⟩, 0, 0⟩

/-- A subcritical Hopf point at no load: `R = 2`, `X = V = n_q = E₀ = 1`, `Q_ref = P_ref = 0`,
`ω_q = 1/10`, `D = 40/661`, `M = 548/661`, at `δ* = 0`, `Q_f* = 0` (`E* = 1`, `ω = 1/2`). -/
def hopfSub : Model := ⟨⟨548 / 661, 40 / 661, 1 / 10, 1, 1, 0, 0, 1, 2, 1⟩, 0, 0⟩

@[tmio M, powerlib_domain] private theorem hopfSuper_isHopf : hopfSuper.IsHopf := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · apply Dynamics.state3_ext <;>
      simp [hopfSuper, Model.point, field, P_eq, Q_eq, emf, zsq]
  all_goals norm_num [hopfSuper, routhTrace, routhFold, routhHopf, gain, coupling, Pδ, PE, Qδ,
    QE, emf, zsq]

@[tmio M, powerlib_domain] private theorem hopfSub_isHopf : hopfSub.IsHopf := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · apply Dynamics.state3_ext <;>
      simp [hopfSub, Model.point, field, P_eq, Q_eq, emf, zsq]
  all_goals norm_num [hopfSub, routhTrace, routhFold, routhHopf, gain, coupling, Pδ, PE, Qδ,
    QE, emf, zsq]

@[tmio M, powerlib_domain] private theorem hopfSuper_freq : hopfSuper.hopfFreq = 1 / 10 := by
  rw [Model.hopfFreq, show (hopfSuper.q.Pδ hopfSuper.δ (hopfSuper.q.emf hopfSuper.Qf) +
    hopfSuper.q.D * hopfSuper.q.ωq * hopfSuper.q.gain hopfSuper.δ
      (hopfSuper.q.emf hopfSuper.Qf)) / hopfSuper.q.M = (1 / 10) ^ 2 by
    norm_num [hopfSuper, gain, Pδ, QE, emf, zsq]]
  exact Real.sqrt_sq (by norm_num)

@[tmio M, powerlib_domain] private theorem hopfSub_freq : hopfSub.hopfFreq = 1 / 2 := by
  rw [Model.hopfFreq, show (hopfSub.q.Pδ hopfSub.δ (hopfSub.q.emf hopfSub.Qf) +
    hopfSub.q.D * hopfSub.q.ωq * hopfSub.q.gain hopfSub.δ
      (hopfSub.q.emf hopfSub.Qf)) / hopfSub.q.M = (1 / 2) ^ 2 by
    norm_num [hopfSub, gain, Pδ, QE, emf, zsq]]
  exact Real.sqrt_sq (by norm_num)

/-- The supercritical witness has `hopfNum < 0`. Static evidence on the model. -/
@[tmio M, powerlib_domain] theorem hopfSuper_hopfNumAt : hopfSuper.hopfNumAt < 0 := by
  rw [Model.hopfNumAt, hopfSuper_freq]
  have e1 : hopfSuper.q.gain hopfSuper.δ (hopfSuper.q.emf hopfSuper.Qf) = 3 / 2 := by
    norm_num [hopfSuper, gain, QE, emf, zsq]
  have e2 : hopfSuper.q.Qδ hopfSuper.δ (hopfSuper.q.emf hopfSuper.Qf) = -1 / 2 := by
    norm_num [hopfSuper, Qδ, emf, zsq]
  have e3 : hopfSuper.q.nq / hopfSuper.q.emf hopfSuper.Qf = 1 := by norm_num [hopfSuper, emf]
  rw [e1, e2, e3]
  norm_num [hopfSuper, hopfNum, hopfNum1, hopfNum2, hopfNum3]

/-- The subcritical witness has `hopfNum > 0`. Static evidence on the model. -/
@[tmio M, powerlib_domain] theorem hopfSub_hopfNumAt : 0 < hopfSub.hopfNumAt := by
  rw [Model.hopfNumAt, hopfSub_freq]
  have e1 : hopfSub.q.gain hopfSub.δ (hopfSub.q.emf hopfSub.Qf) = 6 / 5 := by
    norm_num [hopfSub, gain, QE, emf, zsq]
  have e2 : hopfSub.q.Qδ hopfSub.δ (hopfSub.q.emf hopfSub.Qf) = -2 / 5 := by
    norm_num [hopfSub, Qδ, emf, zsq]
  have e3 : hopfSub.q.nq / hopfSub.q.emf hopfSub.Qf = 1 := by norm_num [hopfSub, emf]
  rw [e1, e2, e3]
  norm_num [hopfSub, hopfNum, hopfNum1, hopfNum2, hopfNum3]

/-- **The supercritical witness is locally asymptotically stable**, not exponentially. -/
@[tmio TM, powerlib_domain] theorem hopfSuper_mem_den_locallyAsymptoticallyStable :
    connection% (hopfSuper ∈ family.den (.flow .locallyAsymptoticallyStable)) :=
  mem_den_locallyAsymptoticallyStable_of_hopfNum_neg hopfSuper (by norm_num [hopfSuper])
    (by norm_num [hopfSuper]) (by norm_num [hopfSuper]) (by norm_num [hopfSuper, emf])
    hopfSuper_isHopf hopfSuper_hopfNumAt

/-- **The subcritical witness is unstable.** -/
@[tmio TM, powerlib_domain] theorem hopfSub_mem_den_unstable :
    connection% (hopfSub ∈ family.den (.flow .unstable)) :=
  mem_den_unstable_of_hopfNum_pos hopfSub (by norm_num [hopfSub]) (by norm_num [hopfSub])
    (by norm_num [hopfSub]) (by norm_num [hopfSub, emf]) hopfSub_isHopf hopfSub_hopfNumAt

/-- **The local asymptotic translation of `QVDroop.family` is not exact**: the supercritical
witness is locally asymptotically stable without a Hurwitz Jacobian (`G = 0`). -/
@[tmio TM, powerlib_domain] theorem not_exact_locallyAsymptoticallyStable :
    connection% (¬ family.Exact (.flow .locallyAsymptoticallyStable)) := by
  unfold powerlib.TMIO.Statement
  refine Spectral.not_exact_of_witness hopfSuper_mem_den_locallyAsymptoticallyStable
    (q := .stable) rfl ?_
  rintro ⟨-, hH⟩
  have h := (hopfSuper.q.isHurwitz_jacobian_iff (by norm_num [hopfSuper])
    (by norm_num [hopfSuper]) _ _).mp hH
  have hG := hopfSuper_isHopf.2.2.2
  exact lt_irrefl 0 (hG ▸ h.2.2)

/-- **Lyapunov stability, complete off the degenerate set**: under the hypotheses of
`mem_den_locallyAsymptoticallyStable_iff_complete`, the same two alternatives. -/
@[tmio TM, powerlib_domain] theorem mem_den_lyapunovStable_iff_complete (m : Model)
    (hM : 0 < m.q.M) (hD : 0 < m.q.D) (hω : 0 < m.q.ωq) (hE : m.q.emf m.Qf ≠ 0)
    (hcusp : m.q.routhFold m.δ (m.q.emf m.Qf) = 0 → m.q.gain m.δ (m.q.emf m.Qf) ≠ 0 ∧
      foldQuad (m.q.Pδ m.δ (m.q.emf m.Qf)) (m.q.Qδ m.δ (m.q.emf m.Qf))
        (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.nq / m.q.emf m.Qf) ≠ 0)
    (hbt : m.q.routhFold m.δ (m.q.emf m.Qf) = 0 → m.q.routhHopf m.δ (m.q.emf m.Qf) ≠ 0)
    (hbautin : m.IsHopf → m.hopfNumAt ≠ 0) :
    connection% (m ∈ family.den (.flow .lyapunovStable) ↔
      m ∈ {m : Model | (m.q.field m.point = 0 ∧ 0 < m.q.routhTrace m.δ (m.q.emf m.Qf) ∧
        0 < m.q.routhFold m.δ (m.q.emf m.Qf) ∧ 0 < m.q.routhHopf m.δ (m.q.emf m.Qf)) ∨
        (m.IsHopf ∧ m.hopfNumAt < 0)}) := by
  have hlas := mem_den_locallyAsymptoticallyStable_iff_complete m hM hD hω hE hcusp hbt hbautin
  unfold powerlib.TMIO.Statement at hlas ⊢
  constructor
  · intro hly
    have heq : m.q.field m.point = 0 :=
      Dynamics.isEquilibrium_of_lyapunovStable m.q.contDiff_field
        ((Spectral.mem_den_flow_iff_shift (f := fun m : Model => m.q.field)
          (pt := Model.point) family_isAutonomous).mp hly)
    have nu : m ∉ family.den (.flow .unstable) := fun hu =>
      Spectral.not_mem_den_lyapunovStable_of_unstable hu hly
    by_cases hG : m.q.routhHopf m.δ (m.q.emf m.Qf) = 0
    · right
      have hC : 0 < m.q.routhFold m.δ (m.q.emf m.Qf) := by
        rcases lt_trichotomy (m.q.routhFold m.δ (m.q.emf m.Qf)) 0 with hC | hC | hC
        · exact absurd (mem_den_unstable_of_violation m hM hω heq (Or.inr (Or.inl hC))) nu
        · exact absurd hG (hbt hC)
        · exact hC
      have hA : 0 < m.q.routhTrace m.δ (m.q.emf m.Qf) := by
        have hGe := m.q.routhHopf_eq m.δ (m.q.emf m.Qf)
        rw [hG] at hGe
        rcases lt_trichotomy (m.q.routhTrace m.δ (m.q.emf m.Qf)) 0 with hA | hA | hA
        · exact absurd (mem_den_unstable_of_violation m hM hω heq (Or.inl hA)) nu
        · rw [hA, zero_mul, zero_sub] at hGe
          nlinarith [mul_pos (mul_pos hM hω) hC]
        · exact hA
      have hH : m.IsHopf := ⟨heq, hA, hC, hG⟩
      refine ⟨hH, ?_⟩
      rcases (hbautin hH).lt_or_gt with hN | hN
      · exact hN
      · exact absurd (mem_den_unstable_of_hopfNum_pos m hM hD hω hE hH hN) nu
    · left
      have hfold : m.q.routhFold m.δ (m.q.emf m.Qf) = 0 → m.q.gain m.δ (m.q.emf m.Qf) ≠ 0 ∧
          m.q.emf m.Qf ≠ 0 ∧ foldQuad (m.q.Pδ m.δ (m.q.emf m.Qf)) (m.q.Qδ m.δ (m.q.emf m.Qf))
            (m.q.gain m.δ (m.q.emf m.Qf)) (m.q.nq / m.q.emf m.Qf) ≠ 0 := fun h0 =>
        ⟨(hcusp h0).1, hE, (hcusp h0).2⟩
      have h := mem_den_lyapunovStable_iff_of_hopf_ne m hM hω hG hfold
      unfold powerlib.TMIO.Statement at h
      exact h.mp hly
  · intro h
    exact Spectral.den_las_subset_lyapunovStable (hlas.mpr h)

/-- **The Lyapunov translation of `QVDroop.family` is not exact** (the supercritical witness). -/
@[tmio TM, powerlib_domain] theorem not_exact_lyapunovStable :
    connection% (¬ family.Exact (.flow .lyapunovStable)) := by
  unfold powerlib.TMIO.Statement
  refine Spectral.not_exact_of_witness
    (Spectral.den_las_subset_lyapunovStable hopfSuper_mem_den_locallyAsymptoticallyStable)
    (q := .stable) rfl ?_
  rintro ⟨-, hH⟩
  have h := (hopfSuper.q.isHurwitz_jacobian_iff (by norm_num [hopfSuper])
    (by norm_num [hopfSuper]) _ _).mp hH
  have hG := hopfSuper_isHopf.2.2.2
  exact lt_irrefl 0 (hG ▸ h.2.2)

end QVDroop

end powerlib.GFM
