import dependencies.Mathlib
import theorem.Attributes
import theorem.Estimation.Kalman
import Mathlib.Probability.Distributions.Gaussian.HasGaussianLaw.Independence
import Mathlib.Probability.Moments.Covariance
import Mathlib.Probability.ConditionalExpectation

/-! # Kalman update = conditional mean in the vector linear-Gaussian model

In the vector linear-Gaussian model the Kalman measurement update is the conditional mean and
`(I − K H) P⁻` is the conditional covariance.

Scope.
* Probability theory, not an engineering result. One measurement update with deterministic
  model matrices; the prediction step and the recursion over time (conditioning on the whole
  measurement history) are not formalized here.
* Random vectors are given by their coordinates, `X : Fin n → Ω → ℝ`, `Y : Fin p → Ω → ℝ`.
  "Jointly Gaussian" is Mathlib's `HasGaussianLaw` of the pair
  `ω ↦ ((X_i ω)_i, (Y_j ω)_j) ∈ ℝⁿ × ℝᵖ` (every continuous linear functional is real Gaussian;
  equivalently, the vector is a linear image of a standard Gaussian vector). `E[· | Y]` is the
  conditional expectation with respect to the σ-algebra generated by the vector `Y`
  (`MeasurableSpace.comap`). Covariances are Mathlib's `cov[·, ·; P]`. The gain is any `K` with
  `K Σ_YY = Σ_XY` (coordinatewise `Σ_l K_il cov[Y_l, Y_j] = cov[X_i, Y_j]`); for invertible
  `Σ_YY` this is `K = Σ_XY Σ_YY⁻¹`.
* The scalar case is `theorem/Estimation/KalmanGaussian.lean`; the matrix algebra of the update
  (Joseph form, optimal gain, information form) is `theorem/Estimation/Kalman.lean`.

Source: work-sync theory/T-kalman-filter.md §1.1 (measurement update `S = H P Hᵀ + R`,
`K = P Hᵀ S⁻¹`, `x̂⁺ = x̂ + K (y − H x̂)`, `P⁺ = (I − K H) P`; "for linear-Gaussian models the
Kalman update is the exact conditional mean and covariance").

Results.
* `gaussian_error_indep` — `X − K Y` is independent of `Y`.
* `gaussian_condExp_eq` — `E[X_i | Y] = E X_i + Σ_j K_ij (Y_j − E Y_j)` a.s.
* `gaussian_condCov_eq` — `E[(X_i − x̂_i)(X_i' − x̂_i') | Y] = Σ_XX,ii' − Σ_j K_ij Σ_XY,i'j` a.s.
* `kalman_update_condExp_condCov` — one-step measurement update: prior `X` Gaussian with mean
  `m`, covariance `P⁻`; noise `V` Gaussian, mean `0`, covariance `R`, independent of `X`;
  `Y = H X + V`. For `K (H P⁻ Hᵀ + R) = P⁻ Hᵀ` (`kalmanGain_mul_innov` for the Kalman gain),
  `E[X | Y] = m + K (Y − H m)` and the conditional covariance is `(I − K H) P⁻` a.s.

Proof (orthogonal decomposition). The error `e = X − K Y` and `Y` are jointly Gaussian (a
continuous linear image of `(X, Y)`) and uncorrelated (`K Σ_YY = Σ_XY`), hence independent
(Mathlib `HasGaussianLaw.indepFun_of_covariance_eval`). So `E[e | Y] = E e` and
`E[X | Y] = E e + K Y`, which is `E X + K (Y − E Y)`; the conditional second moment of
`X − E[X | Y] = e − E e` is the constant `cov(e) = Σ_XX − K Σ_YX`.
-/

noncomputable section
namespace powerlib.Estimation

open MeasureTheory ProbabilityTheory Matrix

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} {n p : ℕ}

section Conditioning

variable {X : Fin n → Ω → ℝ} {Y : Fin p → Ω → ℝ}

/-- `cov[X_i − Σ_l K_il Y_l, W] = cov[X_i, W] − Σ_l K_il cov[Y_l, W]`. -/
private lemma cov_sub_comb [IsFiniteMeasure P] (hX2 : ∀ i, MemLp (X i) 2 P)
    (hY2 : ∀ j, MemLp (Y j) 2 P) (K : Matrix (Fin n) (Fin p) ℝ) (i : Fin n) {W : Ω → ℝ}
    (hW : MemLp W 2 P) :
    cov[fun ω => X i ω - ∑ l, K i l * Y l ω, W; P] =
      cov[X i, W; P] - ∑ l, K i l * cov[Y l, W; P] := by
  have hs : MemLp (fun ω => ∑ l, K i l * Y l ω) 2 P :=
    memLp_finsetSum _ fun l _ => (hY2 l).const_mul _
  rw [covariance_fun_sub_left (hX2 i) hs hW,
    covariance_fun_sum_left (X := fun l ω => K i l * Y l ω) (fun l => (hY2 l).const_mul _) hW]
  simp_rw [covariance_const_mul_left]

/-- The error `X_i − Σ_l K_il Y_l` of a gain `K` with `K Σ_YY = Σ_XY`, jointly Gaussian with `Y`,
is independent of the measurement vector `Y`. -/
@[powerlib_foundation] theorem gaussian_error_indep
    (hXY : HasGaussianLaw (fun ω => (fun i => X i ω, fun j => Y j ω)) P)
    {K : Matrix (Fin n) (Fin p) ℝ}
    (hK : ∀ i j, ∑ l, K i l * cov[Y l, Y j; P] = cov[X i, Y j; P]) :
    IndepFun (fun ω i => X i ω - ∑ l, K i l * Y l ω) (fun ω j => Y j ω) P := by
  have hP : IsProbabilityMeasure P := hXY.isProbabilityMeasure
  have hX2 : ∀ i, MemLp (X i) 2 P := fun i => (hXY.fst.eval i).memLp_two
  have hY2 : ∀ j, MemLp (Y j) 2 P := fun j => (hXY.snd.eval j).memLp_two
  let L : (Fin n → ℝ) × (Fin p → ℝ) →L[ℝ] (Fin n → ℝ) × (Fin p → ℝ) :=
    ((ContinuousLinearMap.fst ℝ _ _) -
      (LinearMap.toContinuousLinearMap (Matrix.toLin' K)).comp
        (ContinuousLinearMap.snd ℝ _ _)).prod (ContinuousLinearMap.snd ℝ _ _)
  have e : (fun ω => (fun i => X i ω - ∑ l, K i l * Y l ω, fun j => Y j ω)) =
      fun ω => L (fun i => X i ω, fun j => Y j ω) := by
    funext ω
    ext i
    · simp [L, Matrix.toLin'_apply, Matrix.mulVec, dotProduct]
    · simp [L]
  have hZY : HasGaussianLaw (fun ω => (fun i => X i ω - ∑ l, K i l * Y l ω,
      fun j => Y j ω)) P := by
    rw [e]; exact hXY.map_fun L
  refine hZY.indepFun_of_covariance_eval (X := fun i ω => X i ω - ∑ l, K i l * Y l ω)
    fun i j => ?_
  rw [cov_sub_comb hX2 hY2 K i (hY2 j), hK, sub_self]

/-- **Gaussian conditioning (vector case): the conditional mean is affine.**  If `(X, Y)` is a
Gaussian vector in `ℝⁿ × ℝᵖ` and `K Σ_YY = Σ_XY` (e.g. `K = Σ_XY Σ_YY⁻¹`), then
`E[X_i | Y] = E X_i + Σ_j K_ij (Y_j − E Y_j)` almost surely. -/
@[powerlib_foundation] theorem gaussian_condExp_eq
    (hXY : HasGaussianLaw (fun ω => (fun i => X i ω, fun j => Y j ω)) P)
    (hXm : ∀ i, Measurable (X i)) (hYm : ∀ j, Measurable (Y j))
    {K : Matrix (Fin n) (Fin p) ℝ}
    (hK : ∀ i j, ∑ l, K i l * cov[Y l, Y j; P] = cov[X i, Y j; P]) (i : Fin n) :
    P[X i | MeasurableSpace.comap (fun ω j => Y j ω) inferInstance] =ᵐ[P]
      fun ω => (∫ ω', X i ω' ∂P) + ∑ j, K i j * (Y j ω - ∫ ω', Y j ω' ∂P) := by
  have hP : IsProbabilityMeasure P := hXY.isProbabilityMeasure
  have hX2 : ∀ i, MemLp (X i) 2 P := fun i => (hXY.fst.eval i).memLp_two
  have hY2 : ∀ j, MemLp (Y j) 2 P := fun j => (hXY.snd.eval j).memLp_two
  have hind := gaussian_error_indep hXY hK
  have hYvm : Measurable (fun ω j => Y j ω) := measurable_pi_iff.mpr hYm
  have hle : MeasurableSpace.comap (fun ω j => Y j ω) inferInstance ≤ mΩ := hYvm.comap_le
  set Z : Ω → ℝ := fun ω => X i ω - ∑ l, K i l * Y l ω with hZ
  have hZm : Measurable Z :=
    (hXm i).sub (Finset.measurable_sum _ fun l _ => (hYm l).const_mul _)
  have hindi : IndepFun Z (fun ω j => Y j ω) P :=
    hind.comp (measurable_pi_apply i) measurable_id
  have hZi : Integrable Z P :=
    ((hX2 i).sub (memLp_finsetSum _ fun l _ => (hY2 l).const_mul _)).integrable one_le_two
  have hcZ : P[Z | MeasurableSpace.comap (fun ω j => Y j ω) inferInstance] =ᵐ[P]
      fun _ => ∫ ω, Z ω ∂P :=
    condExp_indep_eq hZm.comap_le hle (comap_measurable Z).stronglyMeasurable
      ((IndepFun_iff_Indep _ _ _).mp hindi)
  set f : Ω → ℝ := fun ω => ∑ l, K i l * Y l ω with hf
  have hfm : StronglyMeasurable[MeasurableSpace.comap (fun ω j => Y j ω) inferInstance] f := by
    have : Measurable (fun y : Fin p → ℝ => ∑ l, K i l * y l) :=
      Finset.measurable_sum _ fun l _ => (measurable_pi_apply l).const_mul _
    exact (this.comp (comap_measurable _)).stronglyMeasurable
  have hfi : Integrable f P :=
    (memLp_finsetSum _ fun l _ => (hY2 l).const_mul _).integrable one_le_two
  have hdec : X i = f + Z := by funext ω; simp only [Pi.add_apply, hf, hZ]; ring
  have hadd := condExp_add hfi hZi (MeasurableSpace.comap (fun ω j => Y j ω) inferInstance) (μ := P)
  rw [condExp_of_stronglyMeasurable hle hfm hfi] at hadd
  have hXeq : P[X i | MeasurableSpace.comap (fun ω j => Y j ω) inferInstance] =
      P[f + Z | MeasurableSpace.comap (fun ω j => Y j ω) inferInstance] := by rw [hdec]
  rw [hXeq]
  have hEZ : ∫ ω, Z ω ∂P = (∫ ω, X i ω ∂P) - ∑ l, K i l * ∫ ω, Y l ω ∂P := by
    have hYi : ∀ l, Integrable (fun ω => K i l * Y l ω) P := fun l =>
      ((hY2 l).integrable one_le_two).const_mul _
    show ∫ ω, (X i ω - ∑ l, K i l * Y l ω) ∂P = _
    rw [integral_sub ((hX2 i).integrable one_le_two) hfi,
      integral_finsetSum _ fun l _ => hYi l]
    simp_rw [integral_const_mul]
  filter_upwards [hadd, hcZ] with ω h1 h2
  rw [h1, Pi.add_apply, h2, hEZ]
  simp only [hf, mul_sub, Finset.sum_sub_distrib]
  ring

/-- Orthogonality of the error: `cov[X_i − Σ_l K_il Y_l, Y_j] = 0` when `K Σ_YY = Σ_XY`. -/
private lemma cov_error_meas (hX2 : ∀ i, MemLp (X i) 2 P) (hY2 : ∀ j, MemLp (Y j) 2 P)
    [IsFiniteMeasure P] {K : Matrix (Fin n) (Fin p) ℝ}
    (hK : ∀ i j, ∑ l, K i l * cov[Y l, Y j; P] = cov[X i, Y j; P]) (i : Fin n) (j : Fin p) :
    cov[fun ω => X i ω - ∑ l, K i l * Y l ω, Y j; P] = 0 := by
  rw [cov_sub_comb hX2 hY2 K i (hY2 j), hK, sub_self]

/-- **Gaussian conditioning (vector case): the conditional covariance is deterministic.**  With the
conditional mean `x̂_i = E X_i + Σ_j K_ij (Y_j − E Y_j)` of `gaussian_condExp_eq`,
`E[(X_i − x̂_i)(X_i' − x̂_i') | Y] = Σ_XX,ii' − Σ_j K_ij Σ_XY,i'j` a.s., i.e. the conditional
covariance is the matrix `Σ_XX − K Σ_YX`. -/
@[powerlib_foundation] theorem gaussian_condCov_eq
    (hXY : HasGaussianLaw (fun ω => (fun i => X i ω, fun j => Y j ω)) P)
    (hXm : ∀ i, Measurable (X i)) (hYm : ∀ j, Measurable (Y j))
    {K : Matrix (Fin n) (Fin p) ℝ}
    (hK : ∀ i j, ∑ l, K i l * cov[Y l, Y j; P] = cov[X i, Y j; P]) (i i' : Fin n) :
    P[fun ω => (X i ω - ((∫ ω', X i ω' ∂P) + ∑ j, K i j * (Y j ω - ∫ ω', Y j ω' ∂P))) *
        (X i' ω - ((∫ ω', X i' ω' ∂P) + ∑ j, K i' j * (Y j ω - ∫ ω', Y j ω' ∂P))) |
        MeasurableSpace.comap (fun ω j => Y j ω) inferInstance] =ᵐ[P]
      fun _ => cov[X i, X i'; P] - ∑ j, K i j * cov[X i', Y j; P] := by
  have hP : IsProbabilityMeasure P := hXY.isProbabilityMeasure
  have hX2 : ∀ i, MemLp (X i) 2 P := fun i => (hXY.fst.eval i).memLp_two
  have hY2 : ∀ j, MemLp (Y j) 2 P := fun j => (hXY.snd.eval j).memLp_two
  have hind := gaussian_error_indep hXY hK
  have hYvm : Measurable (fun ω j => Y j ω) := measurable_pi_iff.mpr hYm
  have hle : MeasurableSpace.comap (fun ω j => Y j ω) inferInstance ≤ mΩ := hYvm.comap_le
  set Z : Fin n → Ω → ℝ := fun i ω => X i ω - ∑ l, K i l * Y l ω with hZ
  have hZm : Measurable (fun ω i => Z i ω) := measurable_pi_iff.mpr fun i =>
    (hXm i).sub (Finset.measurable_sum _ fun l _ => (hYm l).const_mul _)
  have hZ2 : ∀ i, MemLp (Z i) 2 P := fun i =>
    (hX2 i).sub (memLp_finsetSum _ fun l _ => (hY2 l).const_mul _)
  have hEZ : ∀ i, ∫ ω, Z i ω ∂P = (∫ ω, X i ω ∂P) - ∑ l, K i l * ∫ ω, Y l ω ∂P := by
    intro i
    have hYi : ∀ l, Integrable (fun ω => K i l * Y l ω) P := fun l =>
      ((hY2 l).integrable one_le_two).const_mul _
    show ∫ ω, (X i ω - ∑ l, K i l * Y l ω) ∂P = _
    rw [integral_sub ((hX2 i).integrable one_le_two)
      ((memLp_finsetSum _ fun l _ => (hY2 l).const_mul _).integrable one_le_two),
      integral_finsetSum _ fun l _ => hYi l]
    simp_rw [integral_const_mul]
  -- the integrand is a function of the error vector
  set g : (Fin n → ℝ) → ℝ := fun z => (z i - ∫ ω, Z i ω ∂P) * (z i' - ∫ ω, Z i' ω ∂P) with hg
  have hint : (fun ω => (X i ω - ((∫ ω', X i ω' ∂P) + ∑ j, K i j * (Y j ω - ∫ ω', Y j ω' ∂P))) *
      (X i' ω - ((∫ ω', X i' ω' ∂P) + ∑ j, K i' j * (Y j ω - ∫ ω', Y j ω' ∂P)))) =
      fun ω => g (fun i => Z i ω) := by
    funext ω
    simp only [hg]
    rw [hEZ i, hEZ i']
    simp only [hZ, mul_sub, Finset.sum_sub_distrib]
    ring
  rw [hint]
  have hgm : Measurable g := by
    simp only [hg]; fun_prop
  have hc := condExp_indep_eq hZm.comap_le hle
    ((hgm.comp (comap_measurable (fun ω i => Z i ω))).stronglyMeasurable)
    ((IndepFun_iff_Indep _ _ _).mp hind) (μ := P)
  refine hc.trans (Filter.EventuallyEq.of_eq ?_)
  funext _
  -- the constant is `cov[Z_i, Z_i']`
  have hcovZ : ∫ ω, g (fun i => Z i ω) ∂P = cov[Z i, Z i'; P] := rfl
  show ∫ ω, g (fun i => Z i ω) ∂P = _
  rw [hcovZ]
  have h1 : cov[Z i, Z i'; P] = cov[X i, Z i'; P] := by
    have := cov_sub_comb hX2 hY2 K i (hZ2 i')
    rw [this]
    have h0 : ∀ l, cov[Y l, Z i'; P] = 0 := fun l => by
      rw [covariance_comm]; exact cov_error_meas hX2 hY2 hK i' l
    simp [h0]
  have h2 : cov[X i, Z i'; P] = cov[X i, X i'; P] - ∑ l, K i' l * cov[X i, Y l; P] := by
    rw [covariance_comm, cov_sub_comb hX2 hY2 K i' (hX2 i), covariance_comm]
    simp_rw [covariance_comm (Y _) (X i)]
  rw [h1, h2]
  congr 1
  -- `Σ_l K_i'l Σ_XY,il = Σ_j K_ij Σ_XY,i'j` (both equal `(K Σ_YY Kᵀ)_ii'`)
  simp_rw [← hK]
  simp_rw [Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun m _ => ?_
  rw [covariance_comm]; ring

end Conditioning

/-! ## Linear-Gaussian measurement update -/

section Update

variable {X : Fin n → Ω → ℝ} {V : Fin p → Ω → ℝ}

/-- Covariance with a measurement coordinate:
`cov[W, Σ_l H_jl X_l + V_j] = Σ_l H_jl cov[W, X_l] + cov[W, V_j]`. -/
private lemma cov_meas_right [IsFiniteMeasure P] (hX2 : ∀ i, MemLp (X i) 2 P)
    (hV2 : ∀ j, MemLp (V j) 2 P) (H : Matrix (Fin p) (Fin n) ℝ) (j : Fin p) {W : Ω → ℝ}
    (hW : MemLp W 2 P) :
    cov[W, fun ω => ∑ l, H j l * X l ω + V j ω; P] =
      ∑ l, H j l * cov[W, X l; P] + cov[W, V j; P] := by
  have hs : MemLp (fun ω => ∑ l, H j l * X l ω) 2 P :=
    memLp_finsetSum _ fun l _ => (hX2 l).const_mul _
  rw [show (fun ω => ∑ l, H j l * X l ω + V j ω) = (fun ω => ∑ l, H j l * X l ω) + V j from rfl,
    covariance_add_right hW hs (hV2 j),
    covariance_fun_sum_right (X := fun l ω => H j l * X l ω) (fun l => (hX2 l).const_mul _) hW]
  simp_rw [covariance_const_mul_right]

/-- **Kalman measurement update = conditional mean and covariance (vector linear-Gaussian
model).**  Let the prior state `X ∈ ℝⁿ` be Gaussian with mean `m` and covariance `P⁻`, the noise
`V ∈ ℝᵖ` Gaussian with mean `0` and covariance `R`, `X` and `V` independent, and `Y = H X + V`.
For any gain `K` with `K (H P⁻ Hᵀ + R) = P⁻ Hᵀ` (the Kalman gain `P⁻ Hᵀ S⁻¹` when the innovation
covariance `S` is invertible, `kalmanGain_mul_innov`):
* `E[X_i | Y] = m_i + Σ_j K_ij (Y_j − (H m)_j)` a.s. — the Kalman update `x̂⁺ = m + K(y − H m)`;
* `E[(X_i − x̂⁺_i)(X_i' − x̂⁺_i') | Y] = ((I − K H) P⁻)_ii'` a.s. — the Kalman posterior
  covariance is the (deterministic) conditional covariance. -/
@[powerlib_foundation] theorem kalman_update_condExp_condCov
    (hX : HasGaussianLaw (fun ω i => X i ω) P) (hV : HasGaussianLaw (fun ω j => V j ω) P)
    (hXV : IndepFun (fun ω i => X i ω) (fun ω j => V j ω) P)
    (hXm : ∀ i, Measurable (X i)) (hVm : ∀ j, Measurable (V j))
    {m : Fin n → ℝ} {Pm : Matrix (Fin n) (Fin n) ℝ} {R : Matrix (Fin p) (Fin p) ℝ}
    (hmean : ∀ i, ∫ ω, X i ω ∂P = m i) (hcov : ∀ i i', cov[X i, X i'; P] = Pm i i')
    (hV0 : ∀ j, ∫ ω, V j ω ∂P = 0) (hR : ∀ j j', cov[V j, V j'; P] = R j j')
    (H : Matrix (Fin p) (Fin n) ℝ) {K : Matrix (Fin n) (Fin p) ℝ}
    (hK : K * innov Pm H R = Pm * Hᵀ) (i i' : Fin n) :
    P[X i | MeasurableSpace.comap (fun ω j => ∑ l, H j l * X l ω + V j ω) inferInstance] =ᵐ[P]
        (fun ω => m i + ∑ j, K i j * ((∑ l, H j l * X l ω + V j ω) - (H *ᵥ m) j)) ∧
      P[fun ω => (X i ω - (m i + ∑ j, K i j * ((∑ l, H j l * X l ω + V j ω) - (H *ᵥ m) j))) *
          (X i' ω - (m i' + ∑ j, K i' j * ((∑ l, H j l * X l ω + V j ω) - (H *ᵥ m) j))) |
          MeasurableSpace.comap (fun ω j => ∑ l, H j l * X l ω + V j ω) inferInstance] =ᵐ[P]
        (fun _ => ((1 - K * H) * Pm : Matrix (Fin n) (Fin n) ℝ) i i') := by
  have hP : IsProbabilityMeasure P := hX.isProbabilityMeasure
  have hX2 : ∀ i, MemLp (X i) 2 P := fun i => (hX.eval i).memLp_two
  have hV2 : ∀ j, MemLp (V j) 2 P := fun j => (hV.eval j).memLp_two
  set Y : Fin p → Ω → ℝ := fun j ω => ∑ l, H j l * X l ω + V j ω with hY
  have hY2 : ∀ j, MemLp (Y j) 2 P := fun j =>
    (memLp_finsetSum _ fun l _ => (hX2 l).const_mul _).add (hV2 j)
  have hYm : ∀ j, Measurable (Y j) := fun j =>
    (Finset.measurable_sum _ fun l _ => (hXm l).const_mul _).add (hVm j)
  -- joint Gaussian law of `(X, Y)`
  have hJ := IndepFun.hasGaussianLaw hX hV hXV
  let L : (Fin n → ℝ) × (Fin p → ℝ) →L[ℝ] (Fin n → ℝ) × (Fin p → ℝ) :=
    (ContinuousLinearMap.fst ℝ _ _).prod
      ((LinearMap.toContinuousLinearMap (Matrix.toLin' H)).comp (ContinuousLinearMap.fst ℝ _ _) +
        ContinuousLinearMap.snd ℝ _ _)
  have e : (fun ω => (fun i => X i ω, fun j => Y j ω)) =
      fun ω => L (fun i => X i ω, fun j => V j ω) := by
    funext ω
    ext j
    · simp [L]
    · simp [L, hY, Matrix.toLin'_apply, Matrix.mulVec, dotProduct]
  have hXY : HasGaussianLaw (fun ω => (fun i => X i ω, fun j => Y j ω)) P := by
    rw [e]; exact hJ.map_fun L
  -- second moments
  have hXVij : ∀ a j, cov[X a, V j; P] = 0 := fun a j =>
    (hXV.comp (measurable_pi_apply a) (measurable_pi_apply j)).covariance_eq_zero (hX2 a) (hV2 j)
  have hPs : ∀ a b, Pm a b = Pm b a := fun a b => by rw [← hcov, ← hcov, covariance_comm]
  have hXY_cov : ∀ a j, cov[X a, Y j; P] = (Pm * Hᵀ) a j := by
    intro a j
    rw [cov_meas_right hX2 hV2 H j (hX2 a), hXVij, add_zero, mul_apply]
    exact Finset.sum_congr rfl fun l _ => by rw [hcov, transpose_apply]; ring
  have hYY_cov : ∀ l j, cov[Y l, Y j; P] = innov Pm H R l j := by
    intro l j
    have h1 : ∀ b, cov[Y l, X b; P] = (Pm * Hᵀ) b l := fun b => by
      rw [covariance_comm]; exact hXY_cov b l
    have h2 : cov[Y l, V j; P] = R l j := by
      rw [covariance_comm, cov_meas_right hX2 hV2 H l (hV2 j)]
      have h0 : ∀ b, cov[V j, X b; P] = 0 := fun b => by
        rw [covariance_comm]; exact hXVij b j
      rw [Finset.sum_eq_zero fun b _ => by rw [h0, mul_zero], zero_add, covariance_comm, hR]
    rw [cov_meas_right hX2 hV2 H j (hY2 l), h2, innov, Matrix.add_apply, Matrix.mul_apply]
    congr 1
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [h1 b, Matrix.mul_apply, Matrix.mul_apply, transpose_apply, Finset.sum_mul,
      Finset.mul_sum]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [transpose_apply, hPs]; ring
  have hKg : ∀ a j, ∑ l, K a l * cov[Y l, Y j; P] = cov[X a, Y j; P] := by
    intro a j
    rw [hXY_cov, ← hK, mul_apply]
    exact Finset.sum_congr rfl fun l _ => by rw [hYY_cov]
  have hEY : ∀ j, ∫ ω, Y j ω ∂P = (H *ᵥ m) j := by
    intro j
    have hYi : ∀ l, Integrable (fun ω => H j l * X l ω) P := fun l =>
      ((hX2 l).integrable one_le_two).const_mul _
    show ∫ ω, (∑ l, H j l * X l ω + V j ω) ∂P = _
    rw [integral_add (integrable_finsetSum _ fun l _ => hYi l)
      ((hV2 j).integrable one_le_two), integral_finsetSum _ fun l _ => hYi l, hV0, add_zero]
    simp_rw [integral_const_mul, hmean]
    rfl
  have hmean' := gaussian_condExp_eq hXY hXm hYm hKg i
  have hcov' := gaussian_condCov_eq hXY hXm hYm hKg i i'
  simp only [hmean, hEY] at hmean' hcov'
  refine ⟨hmean', hcov'.trans (Filter.EventuallyEq.of_eq ?_)⟩
  funext _
  rw [hcov, Matrix.sub_mul, Matrix.one_mul, Matrix.sub_apply, Matrix.mul_apply]
  congr 1
  refine (Finset.sum_congr rfl fun j _ => by
    rw [hXY_cov, Matrix.mul_apply, Finset.mul_sum]).trans ?_
  simp_rw [Matrix.mul_apply, Finset.sum_mul]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun j _ => by
    rw [transpose_apply, hPs]; ring

end Update

end powerlib.Estimation
