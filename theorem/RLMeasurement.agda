{-# OPTIONS --cubical --safe --guardedness #-}
module theorem.RLMeasurement where

-- Scaffold of the RL model-side compatibility construction, not an I–O production interface.
-- `Circuits.RL.family` of `theorem/Circuits/RL.lean` is constrained in
-- `theorem/Circuits/RLMeasurement.lean` through `seed ε := family.seed (reading ε)`.
-- The relation is a formal compatibility assumption between a model and a symbolic resistance
-- value. It constrains candidate models within M and supplies T–M property criteria. No
-- implementation or proof of physical production of readings or records is supplied here.
-- The family's seed generates certification (`certify`: the values all of whose compatible
-- models lie in a set, the forward map generated by `possibly`, `generated`), prediction
-- (`predict`: the compatible values) and a model compatibility closure (`closure`). The composite
-- certifies values against the legal space of a sentence set's translation (`whole`), and with
-- an exact translation against the denotation (`certified`). The compatibility condition for
-- a symbolic value `r` with tolerance `ε` is that the model's resistance `R` lies in its interval
-- (`near ε r R`: `|r − R| ≤ ε`, i.e. `R ∈ [r − ε, r + ε]`); this supplies no inductance constraint.
-- A value certifies a set when its interval lies in the set's resistance kernel
-- (`certify-reading`), the possible readings meet the set's resistance image (`predict-reading`),
-- the candidates of a reading are the semantic map itself (`candidates`), the certified readings
-- of a sentence are those whose interval lies in its window (`certified-readings`; an empty
-- window, such as that of a positive decay rate, certifies no reading lying in its own interval,
-- `never-certified`), and the closure cannot separate models of equal resistance
-- (`closure-resistance`: the constraint does not identify inductance or decay rate). The
-- parameterized record interface is read through deterministic analysis (`estimate`): the
-- composite certifies a record exactly when it certifies its estimate (`certified-records`).
-- Satisfaction and value compatibility form one satisfaction structure, so the state-space
-- model representation (the conversion of `theorem/Conversion.agda`) is a path along which
-- the whole chain is constant (`stateSpace-whole`, by `theorem/TMIO/Representation.agda`). Lean:
-- `possibly`, `certify`, `predict` are `TMIO.possibly`, `TMIO.certify`, `TMIO.predict` (the image
-- by `TMIO.predict_eq_image`), `generated` is `TMIO.gc_certify` with `TMIO.generate_possibly`,
-- `closure` is `TMIO.closure`, `whole` is `TMIO.relationalSeed_whole` for `Family.seed`,
-- `certified` is `Family.certified`; in `Circuits.RL`: `certify-reading` is `certify_reading`
-- (with `abs_sub_le_iff` for the interval), `predict-reading` is `predict_reading`, `candidates`
-- is `candidates`, `certified-readings` is `certified_readings` (from `chain_eq_semantics` and
-- `kernImage_den`), `closure-resistance` is `closure_resistance`, `certified-records` is
-- `certified_records` (the composite by `TMIO.generate_comp`), `stateSpace-whole` is
-- `stateSpace_whole` (by `TMIO.Seed.transport_whole`); `never-certified` is the remark in `certified_readings`
-- (`kernImage_decayRate`), not a separate statement. Nothing here is exported.

open import Cubical.Foundations.Prelude
open import Cubical.Data.Sigma
open import Cubical.Data.Sum using (_⊎_; inl; inr)
open import Cubical.Relation.Nullary using (¬_)

open import theorem.Conversion
open import theorem.TMIO.Representation
open import theorem.FamilyReading

open SatContext

-- The singleton set.
single : {A : Type} → A → A → Type
single a b = b ≡ a

-- A generic compatibility relation between models `X` and symbolic values `V`.
module Observation {X V : Type} (obs : X → V → Type) where

  -- The models compatible with some value of `B`, between reverse-inclusion orders.
  possibly : (V → Type) → X → Type
  possibly B x = Σ[ v ∈ V ] B v × obs x v

  -- The values all of whose compatible models lie in `P`.
  certify : (X → Type) → V → Type
  certify P v = (x : X) → obs x v → P x

  -- Certification is the generated forward map: it is adjoint to `possibly`.
  generated : (P : X → Type) (B : V → Type) →
    ((v : V) → B v → certify P v) ↔ ((x : X) → possibly B x → P x)
  generated P B =
    (λ h x vbo → h (fst vbo) (fst (snd vbo)) x (snd (snd vbo)))
    , (λ h v b x o → h x (v , b , o))

  -- The possible readings of `P`. Lean derives them from certification by complement; one
  -- direction holds constructively.
  predict : (X → Type) → V → Type
  predict P v = Σ[ x ∈ X ] P x × obs x v

  predict-complement : (P : X → Type) (v : V) → predict P v → ¬ certify (λ x → ¬ P x) v
  predict-complement P v (x , p , o) c = c x o p

  -- The compatibility closure: the models compatible with a value certified for `P`.
  closure : (X → Type) → X → Type
  closure P = possibly (certify P)

  certify-↔ : {P P' : X → Type} → ((x : X) → P x ↔ P' x) → (v : V) →
    certify P v ↔ certify P' v
  certify-↔ e v = (λ h x o → fst (e x) (h x o)) , (λ h x o → snd (e x) (h x o))

-- The family's seed for a model compatibility relation.
module Seeds (S : Semantics) where
  open Semantics S
  open Readings S

  -- The requirements of a set of sentences: the image of the translation table.
  translated : (F : Family) → (Sentence → Type) → Family.Req F → Type
  translated F Φ q = Σ[ s ∈ Sentence ] Φ s × Family.translate F s q

  -- The whole generated chain: translate, take the legal space, certify.
  whole : (F : Family) {V : Type} → (Family.Model F → V → Type) → (Sentence → Type) → V → Type
  whole F obs Φ = Observation.certify obs (realize F (translated F Φ))

  realize-single : (F : Family) (s : Sentence) (x : Family.Model F) →
    realize F (translated F (single s)) x ↔ realize F (Family.translate F s) x
  realize-single F s x =
    (λ h q t → h q (s , refl , t))
    , (λ h q spt → h q (subst (λ z → Family.translate F z q) (fst (snd spt)) (snd (snd spt))))

  -- With an exact translation the chain certifies the values all of whose compatible models
  -- satisfy the sentence.
  certified : (F : Family) {V : Type} (obs : Family.Model F → V → Type) (s : Sentence) →
    Exact F s → (v : V) → whole F obs (single s) v ↔ Observation.certify obs (den F s) v
  certified F obs s h = Observation.certify-↔ obs (λ x → ↔-trans (realize-single F s x) (h x))

-- The RL family, in impedance parameters with the state-space representation of
-- `theorem/Conversion.agda`, over an abstract semantic layer.
module _ (ops : Operations) (S : Semantics) where
  open Operations ops using (Scalar)
  open Checked ops using (SS; Z; toImpedance; modelEquiv)
  open Semantics S
  open Readings S
  open Seeds S

  resistance : Z → Scalar
  resistance = Impedance.resistance

  -- The family's requirement language, taken abstractly, and the accuracy interval.
  module _ (RLReq : Type) (rlSystem : Z → System) (rlMeets : Z → RLReq → Type)
    (rlTranslate : Sentence → RLReq → Type) (near : Scalar → Scalar → Scalar → Type)
    where

    rlFamily : Family
    rlFamily = record
      { Model = Z ; Req = RLReq ; system = rlSystem ; meets = rlMeets ; translate = rlTranslate }

    -- The formal compatibility condition for a symbolic resistance value with tolerance `ε`.
    reading : Scalar → Z → Scalar → Type
    reading ε m r = near ε r (resistance m)

    -- The resistances all of whose models lie in `D` (Lean `Set.kernImage`).
    kern : (Z → Type) → Scalar → Type
    kern D R = (m : Z) → resistance m ≡ R → D m

    -- A reading certifies a set exactly when its interval lies in the set's resistance kernel.
    certify-reading : (ε : Scalar) (D : Z → Type) (r : Scalar) →
      Observation.certify (reading ε) D r ↔ ((R : Scalar) → near ε r R → kern D R)
    certify-reading ε D r =
      (λ h R n m p → h m (subst (near ε r) (sym p) n)) , (λ k m o → k (resistance m) o m refl)

    -- The possible readings: those whose interval meets the set's resistance image.
    predict-reading : (ε : Scalar) (D : Z → Type) (r : Scalar) →
      Observation.predict (reading ε) D r ↔
        (Σ[ R ∈ Scalar ] near ε r R × (Σ[ m ∈ Z ] D m × (resistance m ≡ R)))
    predict-reading ε D r =
      (λ mdo → resistance (fst mdo) , snd (snd mdo) , fst mdo , fst (snd mdo) , refl)
      , (λ x → let m = fst (snd (snd x)) in
           m , fst (snd (snd (snd x))) , subst (near ε r) (sym (snd (snd (snd (snd x)))))
             (fst (snd x)))

    -- The candidates of a reading are the semantic map itself.
    candidates : (ε r : Scalar) (m : Z) →
      Observation.possibly (reading ε) (single r) m ↔ near ε r (resistance m)
    candidates ε r m =
      (λ vpo → subst (λ w → near ε w (resistance m)) (fst (snd vpo)) (snd (snd vpo)))
      , (λ o → r , refl , o)

    -- The closure cannot separate models of equal resistance.
    closure-resistance : (ε : Scalar) (P : Z → Type) {m m' : Z} → resistance m ≡ resistance m' →
      Observation.closure (reading ε) P m ↔ Observation.closure (reading ε) P m'
    closure-resistance ε P p =
      (λ x → fst x , fst (snd x) , subst (near ε (fst x)) p (snd (snd x)))
      , (λ x → fst x , fst (snd x) , subst (near ε (fst x)) (sym p) (snd (snd x)))

    -- The parameterized record interface read through deterministic analysis (Lean `recordEdge`).
    module Records (Record : Type) (estimate : Record → Scalar) where

      analysis : Scalar → Record → Type
      analysis r d = estimate d ≡ r

      -- The chain extended by the analysis edge, generated as a composite.
      wholeRecords : Scalar → (Sentence → Type) → Record → Type
      wholeRecords ε Φ = Observation.certify analysis (whole rlFamily (reading ε) Φ)

      -- It certifies a record exactly when the chain certifies the record's estimate.
      certified-records : (ε : Scalar) (Φ : Sentence → Type) (d : Record) →
        wholeRecords ε Φ d ↔ whole rlFamily (reading ε) Φ (estimate d)
      certified-records ε Φ d =
        (λ h → h (estimate d) refl) , (λ w r p → subst (whole rlFamily (reading ε) Φ) p w)

    -- What Lean proves about the family: it is faithful, and the window of every sentence (the
    -- resistances all of whose models satisfy it) is the resistance kernel of its denotation.
    module Windows (window : Sentence → Scalar → Type)
      (exact : (s : Sentence) → Exact rlFamily s)
      (kern-den : (s : Sentence) (R : Scalar) → kern (den rlFamily s) R ↔ window s R)
      where

      -- The certified readings of a sentence: those whose interval lies in its window.
      certified-readings : (ε : Scalar) (s : Sentence) (r : Scalar) →
        whole rlFamily (reading ε) (single s) r ↔ ((R : Scalar) → near ε r R → window s R)
      certified-readings ε s r =
        ↔-trans (certified rlFamily (reading ε) s (exact s) r)
          (↔-trans (certify-reading ε (den rlFamily s) r)
            ((λ h R n → fst (kern-den s R) (h R n)) , (λ h R n → snd (kern-den s R) (h R n))))

      -- An empty window certifies no reading lying in its own interval (`ε ≥ 0`).
      never-certified : (ε : Scalar) (s : Sentence) → ((R : Scalar) → ¬ window s R) →
        (r : Scalar) → near ε r r → ¬ whole rlFamily (reading ε) (single s) r
      never-certified ε s empty r n w = empty r (fst (certified-readings ε s r) w r n)

    -- Requirement satisfaction and value compatibility as one model satisfaction structure.
    observed : {X : Type} → (X → RLReq → Type) → (X → Scalar → Type) → X → RLReq ⊎ Scalar → Type
    observed sat' obs x (inl q) = sat' x q
    observed sat' obs x (inr v) = obs x v

    impedanceContext stateSpaceContext : Scalar → SatContext (RLReq ⊎ Scalar)
    impedanceContext ε = satContext Z (observed rlMeets (reading ε))
    stateSpaceContext ε = satContext SS (λ x → observed rlMeets (reading ε) (toImpedance x))

    -- The state-space representation: satisfaction and readings are preserved by definition.
    stateSpaceEquiv : (ε : Scalar) → SatEquiv (stateSpaceContext ε) (impedanceContext ε)
    stateSpaceEquiv ε = satEquiv modelEquiv (λ _ _ → refl)

    -- The whole chain read off a satisfaction structure.
    wholeOf : SatContext (RLReq ⊎ Scalar) → (Sentence → Type) → Scalar → Type
    wholeOf K Φ v =
      (x : Carrier K) → sat K x (inr v) → (q : RLReq) → translated rlFamily Φ q → sat K x (inl q)

    -- Certified readings do not depend on the representation of the models.
    stateSpace-whole : (ε : Scalar) → wholeOf (stateSpaceContext ε) ≡ whole rlFamily (reading ε)
    stateSpace-whole ε = cong wholeOf (satPath (stateSpaceEquiv ε))
