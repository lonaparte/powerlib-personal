    =   -4*Cf^2*Lg^4*idr^2*wn^6 - 8*Cf^2*Lg^2*Rg^2*idr^2*wn^4
        + 4*Cf^2*Lg^2*Vg^2*wn^4 - 4*Cf^2*Rg^4*idr^2*wn^2 + 4*Cf^2*Rg^2*Vg^2*wn^2
        + 8*Cf*Lg^3*idr^2*wn^4 + 8*Cf*Lg*Rg^2*idr^2*wn^2 - 8*Cf*Lg*Vg^2*wn^2
        - 4*Lg^2*idr^2*wn^2 + 4*Vg^2 )
End.
