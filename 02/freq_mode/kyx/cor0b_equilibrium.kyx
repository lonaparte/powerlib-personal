ArchiveEntry "Corollary 0b: reactive-power lock fixes i_q = -Q_ref/(1.5 Vg)"

/* The reactive-power loop, at equilibrium, holds its setpoint: e_Q = 0, i.e.
 * Q_meas = Q_ref with Q_meas = -1.5*Vg*i_q.  Hence i_q is pinned (division-free:
 * the equilibrium relation -3/2*Vg*iq = Qref determines iq uniquely for Vg>0,
 * i.e. two equilibria share iq). */
Problem
  \forall Vg \forall Qref \forall iq1 \forall iq2
  ( Vg > 0 & -3/2*Vg*iq1 = Qref & -3/2*Vg*iq2 = Qref
    -> iq1 = iq2 )
End.
Tactic "reactive lock by QE"
  QE
End.
End.

ArchiveEntry "Corollary 0b: PLL integrator equilibrium  Ki_pll*eta = -dw"

/* The PLL phase equation is F6 = -Kp_pll*v_cqc - Ki_pll*eta - dw.  At equilibrium
 * F6 = 0, and on the locked manifold v_cqc = 0 (capacitor-voltage q-component
 * regulated to 0), so -Ki_pll*eta - dw = 0, i.e. Ki_pll*eta = -dw  (eta = -dw/Ki_pll).
 * Division-free equational form. */
Problem
  \forall Kppll \forall Kipll \forall eta \forall dw \forall vcqc
  ( vcqc = 0 & -Kppll*vcqc - Kipll*eta - dw = 0
    -> Kipll*eta = -dw )
End.
Tactic "PLL integrator eq by QE"
  QE
End.
End.

ArchiveEntry "Corollary 0b: Variant S forces dw* = 0 at equilibrium"

/* Variant S (swing-anchored) frequency law: F9_S = kappa*e_P - b*dw, with
 * e_P = Pref - Pmeas.  At equilibrium F9_S = 0; and by the Power Lock e_P = 0.
 * Hence b*dw = 0, and with b > 0 this forces dw* = 0: the swing-anchored GFL
 * returns the grid-frequency offset to zero at the operating point. */
Problem
  \forall kappa \forall b \forall dw \forall eP
  ( b > 0 & eP = 0 & kappa*eP - b*dw = 0
    -> dw = 0 )
End.
Tactic "dw*=0 by QE"
  QE
End.
End.
