ArchiveEntry "Exact Necessary: H>4K means kinetic energy at saddle"

Definitions
  Real K = 1;
End.

ProgramVariables
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

/* If H > 4K and the system reaches c = -1 (delta = pi),
   then w1^2 + w2^2 = H - 4K > 0 (still has kinetic energy).
   For D=0, H is conserved, so this is guaranteed. */

Problem
  s^2 + c^2 = 1 & c = -1 &
  w1^2 + w2^2 + 2*K*(1-c) > 4*K
  ->
  w1^2 + w2^2 > 0
End.

Tactic "Proof"
  QE
End.

End.
