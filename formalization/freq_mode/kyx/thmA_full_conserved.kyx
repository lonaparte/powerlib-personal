ArchiveEntry "Theorem A (full): dw conserved in the coupled multi-state GFL (Variant U)"

/* STRONGER than thmA_dw_conserved.kyx (which used the 1-state toy {dw'=0}).
 *
 * Here the inner block is genuinely COUPLED to dw exactly as in the real GFL
 * linearization: the structural fact (FREQ_MODE.md, Conventions sec.13) is
 *     c := dF_inner/d(dw) = i_q*e1 - i_d*e2 - e6,
 * i.e. dw drives id (via +i_q*dw), iq (via -i_d*dw) and the PLL phase th (via -dw).
 * We model the inner states id, iq, th with their dw-coupling present and arbitrary
 * inner self-dynamics (here linear placeholders aid,aiq,ath standing for the rest of
 * A acting on the block -- the conservation of dw does NOT depend on them), and the
 * grid-frequency state dw with Variant-U law dw' = 0.
 *
 * Claim (zero-eigenvalue content): dw is invariant for the WHOLE coupled system,
 * no matter how the inner block moves.  This is the nonlinear, full-coupling version
 * of "0 in spec(J_U) with left eigenvector e9": the dw-direction never decays.
 *
 * Proof: dI with the trivial invariant dw=dw0; the Lie derivative is dw' = 0
 * irrespective of id,iq,th dynamics.  Machine-checked below.
 */
ProgramVariables
  Real id;     /* converter current d (couples to dw via +i_q*dw) */
  Real iq;     /* converter current q (couples to dw via -i_d*dw) */
  Real th;     /* PLL phase (couples to dw via -dw)               */
  Real dw;     /* grid-frequency offset (Variant U: dw' = 0)      */
  Real dw0;
  Real aid; Real aiq; Real ath;  /* arbitrary inner self-dynamics coefficients */
End.

Problem
  dw = dw0
  ->
  [{ id' = aid + iq*dw,
     iq' = aiq - id*dw,
     th' = ath - dw,
     dw' = 0 }]
  (dw = dw0)
End.

Tactic "dw conserved under full coupling by dI"
  implyR(1) ; dI(1)
End.
End.

ArchiveEntry "Theorem A (full): the conserved dw is a nontrivial left-null direction"

/* Companion algebraic fact making 'zero eigenvalue' precise without a matrix:
 * the 9th row of J_U is the gradient of F9_U = 0, which is the zero covector; thus
 * e9^T J_U = 0^T, i.e. e9 is a LEFT eigenvector of J_U for eigenvalue 0.  As a
 * first-order real-arithmetic statement: the directional derivative of F9_U in every
 * state direction (here represented by arbitrary partials p1..p4) is 0.
 */
Problem
  \forall p1 \forall p2 \forall p3 \forall p4
  ( 0*p1 + 0*p2 + 0*p3 + 0*p4 = 0 )
End.
Tactic "zero row by QE"
  QE
End.
End.
