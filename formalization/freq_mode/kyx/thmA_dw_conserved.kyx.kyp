/* @evidence: generated by KeYmaeraX 5.1.2 -launch -prove thmA_dw_conserved.kyx -tool z3 */

/* @evidence: parse of print of result of a proof */

Lemma "user/Theorem A: Variant U has a zero eigenvalue (dw conserved)".
"  ==>  ((dw) = (dw0))->([{dw'=(0)}]((dw) = (dw0)))
\qed::1823e4551d618894d5d87606246e57f0"
End.
Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "Theorem A: Variant U has a zero eigenvalue (dw conserved)"

/* Variant U (unanchored): the grid-frequency equation is F9_U = 0, i.e. dw' = 0.
 * Hence dw is a conserved quantity, the 9th row of the Jacobian J_U is identically
 * zero, and 0 is an eigenvalue of J_U (with left eigenvector e9).
 *
 * The dynamical content of the zero eigenvalue is exactly the invariance of dw,
 * which is what this dL box-modality property states: dw=dw0 -> [dw'=0] dw=dw0.
 *
 * MACHINE-CHECKED: KeYmaera X 5.1.2 reports `proved` (dI, Z3 backend). See
 * ../results/keymaerax_proof_log.txt.
 */

ProgramVariables
  Real dw;
  Real dw0;
End.

Problem
  dw = dw0 -> [{ dw' = 0 }] (dw = dw0)
End.

Tactic "dw conserved by dI"
  implyR(1) ; dI(1)
End.

End. """"
  tactic """" (implyR(1);dI(1)) """"
  proof """"  """"
End.
