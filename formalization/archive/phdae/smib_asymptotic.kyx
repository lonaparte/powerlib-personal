ArchiveEntry "SMIB asymptotic stability via modified Hamiltonian (D=K=1)"

/*
 * Single machine, D=K=1. H=w^2+2(1-c), Hdot=-2w^2 is only negative
 * SEMIdefinite (zero on w=0), so H alone gives Lyapunov but not asymptotic
 * stability. Modified Hamiltonian V = H + (1/2)*w*sin(delta) is strictly
 * decreasing: on {c>=0}, V' <= -V/3, so V reaches any target in finite time
 * (asymptotic stability). a=1/2 chosen; valid since a<8DK/(4K+D^2)=8/5.
 *
 * V>0: quadratic part [[1,1/4],[1/4,1]] (det 15/16>0) plus (1-c)^2 >= 0.
 */
Definitions Real D=1; Real K=1; Real a=1/2; End.
ProgramVariables Real delta; Real w; Real s; Real c; Real t; Real v0; End.
Problem
  \forall target (target > 0 & target < 1/2 ->
    (s^2+c^2=1 & c>0 & v0 = w^2+2*(1-c)+a*w*s & v0>0 & v0<1 & t=0
     ->
     [{delta'=w, w'=-D*w-K*s, s'=c*w, c'=-s*w, t'=1, v0'=0
       & s^2+c^2=1 & c>=0 & w^2+2*(1-c)+a*w*s >= target}]
     t < 3*v0/target))
End.
Tactic "Proof"
  allR(1); implyR(1); implyR(1);
  dC("w^2+2*(1-c)+a*w*s <= v0 - t*target/3", 1);
  <( dW(1); QE, dI(1) )
End.
End.
