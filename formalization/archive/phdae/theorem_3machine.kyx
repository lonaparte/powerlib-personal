ArchiveEntry "Theorem: 3-Machine pH Lyapunov (line, D1=D3=K=1)"

/*
 * 3-machine line topology: 1--2--3, D1=D3=K=1, D2=-d.
 *
 * V = H + h*(s1^2+s2^2) + a*(w1*s1-w3*s2) + b*w2*(s1-s2)
 *   a = 7/8+5d/7, b = 1/4+2d/3, h = 1/9+3d/10
 *
 * Anti-symmetric correction coupling to the inter-area mode w2*(s1-s2).
 *
 * PROOF STRUCTURE:
 * (A) 5x5 matrix -M(c1,c2) block-diagonalizes into 3x3 (symmetric) + 2x2 (anti-symmetric)
 *     under the network symmetry (machine 1 <-> 3, s1 <-> -s2).
 * (B) The 2x2 block is always positive definite.
 * (C) The 3x3 block determinant is a degree-5 polynomial in d:
 *     P(d) = 112896000d^5 - 297642240d^4 - 88688416d^3 + 669313092d^2 - 418462450d + 72535925
 *     P(d) > 0 for d < d_* where d_* ~ 0.3769.
 * (D) Boundary d_* is the smallest positive root of P(d) = 0 (irreducible over Q).
 *
 * INSTANCE: d = 3/10, c0 = 4/5.
 */

Definitions
  Real d = 3/10;
  Real a_val = 7/8 + 5*d/7;
  Real b_val = 1/4 + 2*d/3;
  Real h_val = 1/9 + 3*d/10;
End.

ProgramVariables
  Real da; Real db; Real w1; Real w2; Real w3;
  Real s1; Real c1; Real s2; Real c2;
End.

Problem
  s1^2+c1^2=1 & s2^2+c2^2=1 & c1>=4/5 & c2>=4/5 &
  w1^2+w2^2+w3^2+2*(1-c1)+2*(1-c2)
    +h_val*(s1^2+s2^2)+a_val*(w1*s1-w3*s2)+b_val*w2*(s1-s2) < 1/25
  ->
  [{da'=w1, db'=w2,
    w1'=-w1-s1,
    w2'=d*w2+s1-s2,
    w3'=-w3+s2,
    s1'=c1*(w1-w2), c1'=-s1*(w1-w2),
    s2'=c2*(w2-w3), c2'=-s2*(w2-w3)
    & s1^2+c1^2=1 & s2^2+c2^2=1 & c1>=4/5 & c2>=4/5}]
  w1^2+w2^2+w3^2+2*(1-c1)+2*(1-c2)
    +h_val*(s1^2+s2^2)+a_val*(w1*s1-w3*s2)+b_val*w2*(s1-s2) < 1/25
End.

Tactic "Proof"
  implyR(1);
  dI(1)
End.

End.
