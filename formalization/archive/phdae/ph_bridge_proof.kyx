ArchiveEntry "pH-Structured Lyapunov for D2<0: Analytic Proof"

/*
 * PROVED (analytically, awaiting KeYmaera X machine verification)
 *
 * For D1=1, D2=-3/10, K=1:
 * V = w1^2 + w2^2 + 2*(1-c) + (1/3)*s^2 + (7/5)*w1*s + (9/10)*w2*s
 * satisfies V' < 0 in {c >= 4/5, s^2+c^2=1, (w1,w2,s) != 0}.
 *
 * PROOF:
 * V' = x'*M(c)*x where x=(w1,w2,s) and M(c) is affine in c:
 *   M(c) = M0 + c*M1
 *
 * M(c) entries:
 *   [0,0] = -2 + (7/5)*c
 *   [0,1] = c*(9/10-7/5)/2 = -c/4
 *   [0,2] = (-7/5 + (2/3)*c)/2 = -7/10 + c/3
 *   [1,1] = 3/5 - (9/10)*c
 *   [1,2] = ((9/10)*(3/10) - (2/3)*c)/2 = 27/200 - c/3
 *   [2,2] = 9/10 - 7/5 = -1/2
 *
 * Step 1: M(1) negative definite (Sylvester criterion, exact rational)
 *   minor 1: 3/5 > 0
 *   minor 2: 47/400 > 0
 *   minor 3: 56117/1800000 > 0
 *
 * Step 2: M(4/5) negative definite (Sylvester criterion, exact rational)
 *   minor 1: 22/25 > 0
 *   minor 2: 41/625 > 0
 *   minor 3: 80249/4500000 > 0
 *
 * Step 3: M(c) affine in c, so M(c) < 0 for all c in [4/5, 1].
 *   V' = x'*M(c)*x < 0 for x != 0 and c in [4/5, 1].
 *
 * Domain: {s^2+c^2=1, c>=4/5} corresponds to |delta| < 36.9 degrees.
 *
 * This proves: pH structure (H + sin-based corrections) provides a
 * Lyapunov function for D2 < 0, establishing local asymptotic stability.
 */

Definitions
  Real D1 = 1;
  Real D2 = -(3/10);
  Real K  = 1;
End.

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

Problem
  s^2 + c^2 = 1 & c >= 4/5 &
  w1^2 + w2^2 + 2*(1-c) + (1/3)*s^2 + (7/5)*w1*s + (9/10)*w2*s < 1
  ->
  [{d1' = w1,
    d2' = w2,
    w1' = -D1*w1 - K*s,
    w2' = -D2*w2 + K*s,
    s'  = c*(w1 - w2),
    c'  = -s*(w1 - w2)
    & s^2 + c^2 = 1 & c >= 4/5}]
  w1^2 + w2^2 + 2*(1-c) + (1/3)*s^2 + (7/5)*w1*s + (9/10)*w2*s < 1
End.

Tactic "Proof"
  implyR(1);
  dI(1)
End.

End.
