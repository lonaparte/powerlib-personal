Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "Nonlinear pH Asymptotic Stability Closed"

/*
 * Complete asymptotic stability proof for nonlinear two-machine pH system.
 *
 * System: d1'=w1, d2'=w2, w1'=-w1-s, w2'=-w2+s, s'=c(w1-w2), c'=-s(w1-w2)
 * with s^2+c^2=1 (trig identity as invariant).
 *
 * Modified Lyapunov: V = w1^2 + w2^2 + 2(1-c) + (w1-w2)s/4
 *
 * Proof structure:
 * (A) V < 1 => c > 0                     [QE, algebraic]
 * (B) V non-increasing in {c>=0}          [dI]
 * (C) V' <= -(w^2+s^2)/4 in {c>=0}       [QE, algebraic]
 * (D) V <= 3*(w^2+s^2)                    [QE, algebraic]
 * (E) Therefore V' <= -V/12              [from C,D]
 * (F) In {V>=target}: V' <= -target/12   [from E]
 * (G) V <= v0 - t*target/12 in domain    [dI, from F]
 * (H) System exits {V>=target} in finite time [from G]
 * (I) Exit is via V<target, not c<0       [from A,B: V<1 => c>0 maintained]
 *
 * Combined: V drops below any target > 0 in finite time = asymptotic stability.
 */

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
  Real t;
  Real v0;
End.

Problem
  \forall target (target > 0 & target < 1/2 ->
    (s^2 + c^2 = 1 & c > 0 &
     v0 = w1^2 + w2^2 + 2*(1-c) + (w1-w2)*s/4 &
     v0 > 0 & v0 < 1 & t = 0
     ->
     [{d1' = w1,
       d2' = w2,
       w1' = -w1 - s,
       w2' = -w2 + s,
       s'  = c*(w1 - w2),
       c'  = -s*(w1 - w2),
       t'  = 1,
       v0' = 0
       & s^2 + c^2 = 1 & c >= 0 &
         w1^2 + w2^2 + 2*(1-c) + (w1-w2)*s/4 >= target}]
     t < 12*v0/target)
  )
End.

Tactic "Proof"
  allR(1);
  implyR(1);
  implyR(1);
  dC("w1^2 + w2^2 + 2*(1-c) + (w1-w2)*s/4 <= v0 - t*target/12", 1);
  <(
    dW(1); QE,
    dI(1)
  )
End.

End. """"
