Lemma "user/Necessity: D<0 implies energy growth (general)".
"  ==>  \forall D (\forall K ((((D) < ((0)))&((K) > ((0))))->((((((s)^((2)))+((c)^((2)))) = ((1)))&(((h0) = ((((w1)^((2)))+((w2)^((2))))+((((2))*(K))*(((1))-(c)))))&((((w1)^((2)))+((w2)^((2)))) > ((0)))))->([{d1'=w1,d2'=w2,w1'=(-((D)*(w1)))-((K)*(s)),w2'=(-((D)*(w2)))+((K)*(s)),s'=(c)*((w1)-(w2)),c'=-((s)*((w1)-(w2))),h0'=(0)&((((s)^((2)))+((c)^((2)))) = ((1)))&((((w1)^((2)))+((w2)^((2)))) > ((0)))}](((((w1)^((2)))+((w2)^((2))))+((((2))*(K))*(((1))-(c)))) >= (h0))))))
\qed::894bb6b98eb7aac09892cf863860dcc0"
End.
Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "Necessity: D<0 implies energy growth (general)"

/*
 * If D < 0 (both machines have negative damping), energy grows.
 *
 * H = w1^2 + w2^2 + 2*K*(1-c)
 * Hdot = -2*D*(w1^2 + w2^2)
 *
 * With D < 0: -2*D > 0, so Hdot > 0 whenever w1^2+w2^2 > 0.
 * Energy grows strictly, so asymptotic stability is impossible.
 *
 * This proof is for symbolic D < 0 and K > 0 (not just D = -1).
 */

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
  Real h0;
End.

Problem
  \forall D \forall K (D < 0 & K > 0 ->
    (s^2 + c^2 = 1 &
     h0 = w1^2 + w2^2 + 2*K*(1-c) &
     w1^2 + w2^2 > 0
     ->
     [{d1' = w1,
       d2' = w2,
       w1' = -D*w1 - K*s,
       w2' = -D*w2 + K*s,
       s'  = c*(w1 - w2),
       c'  = -s*(w1 - w2),
       h0' = 0
       & s^2 + c^2 = 1 & w1^2 + w2^2 > 0}]
     w1^2 + w2^2 + 2*K*(1-c) >= h0))
End.

Tactic "Proof"
  allR(1); allR(1);
  implyR(1); implyR(1);
  dI(1)
End.

End. """"
  tactic """" (allR(1);allR(1);implyR(1);implyR(1);dI(1)) """"
  proof """"  """"
End.
