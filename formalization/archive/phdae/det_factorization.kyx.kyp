   - ((((D1+3*d)/2)-(D1+d))/2) * ( (((D1+3*d)/2)-(D1+d))/2*(K*((D1+3*d)/2-(D1+d)))
       - (((D1+3*d)/2*d - 2*((6*D1^2+11*D1*d+15*d^2)/32))/2)*((-(D1+d)*D1+2*((6*D1^2+11*D1*d+15*d^2)/32))/2) )
   + ((-(D1+d)*D1+2*((6*D1^2+11*D1*d+15*d^2)/32))/2) * ( (((D1+3*d)/2)-(D1+d))/2*(((D1+3*d)/2*d - 2*((6*D1^2+11*D1*d+15*d^2)/32))/2)
       - (2*d-(D1+3*d)/2)*((-(D1+d)*D1+2*((6*D1^2+11*D1*d+15*d^2)/32))/2) ) )
  = -7*(D1-d)^3*(16*K-(2*D1+3*d)^2)/512
