"  ==>  \forall D1 (\forall D2 (\forall K (\forall eps (\forall target ((((D1) > ((0)))&(((D2) > ((0)))&(((K) > ((0)))&(((eps) > ((0)))&(((target) > ((0)))&(((target) <= (eps))&(((((s)^((2)))+((c)^((2)))) = ((1)))&(((((w1)^((2)))+((w2)^((2))))+((((2))*(K))*(((1))-(c)))) < (target)))))))))->([{d1'=w1,d2'=w2,w1'=(-((D1)*(w1)))-((K)*(s)),w2'=(-((D2)*(w2)))+((K)*(s)),s'=(c)*((w1)-(w2)),c'=-((s)*((w1)-(w2)))}](((((w1)^((2)))+((w2)^((2))))+((((2))*(K))*(((1))-(c)))) < (target))))))))
