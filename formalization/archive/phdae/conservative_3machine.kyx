ArchiveEntry "3-Machine conservative: H exactly conserved (parametric in K)"

/*
 * 3-machine analog of exact_boundary_conservative_parametric. Conservative line
 * (D1=D2=D3=0): the Hamiltonian H = w1^2+w2^2+w3^2+2K(1-c1)+2K(1-c2) is EXACTLY
 * conserved for ALL K>0 (sin couplings cancel, no damping). dH/dt = 0.
 */

ProgramVariables
  Real da; Real db; Real dc;
  Real w1; Real w2; Real w3;
  Real s1; Real c1; Real s2; Real c2;
  Real h0;
End.

Problem
  \forall K (
    K > 0 &
    s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1 &
    h0 = w1^2 + w2^2 + w3^2 + 2*K*(1-c1) + 2*K*(1-c2)
    ->
    [{da' = w1, db' = w2, dc' = w3,
      w1' = -K*s1,
      w2' = K*s1 - K*s2,
      w3' = K*s2,
      s1' = c1*(w1 - w2), c1' = -s1*(w1 - w2),
      s2' = c2*(w2 - w3), c2' = -s2*(w2 - w3),
      h0' = 0
      & s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1}]
    w1^2 + w2^2 + w3^2 + 2*K*(1-c1) + 2*K*(1-c2) = h0
  )
End.

Tactic "Proof"
  allR(1);
  implyR(1);
  dI(1)
End.

End.
