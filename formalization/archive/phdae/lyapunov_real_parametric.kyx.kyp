Tool.
  tool """" KeYmaera X """"
  model """" ArchiveEntry "Lyapunov Stability Single Machine (parametric in D)"

/*
 * Parametric companion to lyapunov_real.kyx (which fixed D=1).
 * Full epsilon-delta Lyapunov stability of the single damped oscillator
 *   d' = w,  w' = -d - D*w
 * for ALL D > 0, using V = d^2 + w^2 as the metric.
 * Witness delta = eps (parameter-independent): V' = -2*D*w^2 <= 0, so V is
 * non-increasing and V(0) < eps implies V(t) < eps for all t.
 * Cross-validated (sympy): V' + 2*D*w^2 = 0 exactly.
 */

ProgramVariables
  Real d;
  Real w;
End.

Problem
  \forall D (
    D > 0 ->
    \forall eps (eps > 0 ->
      \exists delta (delta > 0 &
        \forall d \forall w (
          d^2 + w^2 < delta
          ->
          [{d' = w, w' = -d - D*w}]
          d^2 + w^2 < eps
        )
      )
    )
  )
End.

Tactic "Proof"
  allR(1);
  implyR(1);
  allR(1);
  implyR(1);
  existsR("eps", 1);
  andR(1);
  <(
    id,
    allR(1); allR(1);
    implyR(1);
    dI(1)
  )
End.

End. """"
  tactic """" (allR(1);implyR(1);allR(1);implyR(1);existsR("eps", 1);andR(1);<( id, (allR(1);allR(1);implyR(1);dI(1)) )) """"
  proof """"  """"
End.
