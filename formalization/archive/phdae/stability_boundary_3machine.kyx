ArchiveEntry "3-Machine region of attraction {H<4K} invariant (parametric in D1,D2,D3,K)"

/*
 * 3-machine analog of stability_boundary(_parametric). Passive line 1-2-3.
 * The energy sublevel {H < 4K}, H = w1^2+w2^2+w3^2+2K(1-c1)+2K(1-c2), is
 * positively invariant for ALL D1,D2,D3,K > 0. 4K is the lowest saddle energy
 * of the line (one coupling at delta=pi, the other at 0), so {H<4K} is the
 * region of attraction. Mechanism: dH/dt = -2(D1 w1^2+D2 w2^2+D3 w3^2) <= 0.
 */

ProgramVariables
  Real da; Real db; Real dc;
  Real w1; Real w2; Real w3;
  Real s1; Real c1; Real s2; Real c2;
End.

Problem
  \forall D1 \forall D2 \forall D3 \forall K (
    D1 > 0 & D2 > 0 & D3 > 0 & K > 0 &
    s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1 &
    w1^2 + w2^2 + w3^2 + 2*K*(1-c1) + 2*K*(1-c2) < 4*K
    ->
    [{da' = w1, db' = w2, dc' = w3,
      w1' = -D1*w1 - K*s1,
      w2' = -D2*w2 + K*s1 - K*s2,
      w3' = -D3*w3 + K*s2,
      s1' = c1*(w1 - w2), c1' = -s1*(w1 - w2),
      s2' = c2*(w2 - w3), c2' = -s2*(w2 - w3)
      & s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1}]
    w1^2 + w2^2 + w3^2 + 2*K*(1-c1) + 2*K*(1-c2) < 4*K
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1); allR(1);
  implyR(1);
  dI(1)
End.

End.
