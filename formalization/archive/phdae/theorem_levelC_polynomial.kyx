ArchiveEntry "Level C reached by a degree-4 polynomial Lyapunov certificate"

/*
 * CORRECTION of an earlier (wrong) claim that reaching the true stability
 * boundary requires a "messy" certificate. It does NOT.
 *
 * System (x=(delta,w1,w2)): A=[[0,1,-1],[-K,-D1,0],[K,0,b]], D2=-b.
 * True stability (Level C) = Routh: D1>b AND K>D1*b.
 *
 * Clear the denominator of the Lyapunov-equation solution lyap(A,I):
 * P_poly := 2K(b-D1)(D1 b-K) * lyap(A,I) has POLYNOMIAL entries (deg<=4,
 * <=8 terms each):
 *   P00 = D1^2K^2+D1^2K+D1^2b^2-D1Kb+2K^3+K^2b^2+2K^2+Kb^2
 *   P01 = D1K^2+D1K+D1b^2+K^2b
 *   P02 = D1^2b+D1K^2+K^2b+Kb
 *   P11 = -D1Kb+2K^2+Kb^2+K+b^2
 *   P12 = D1b-K
 *   P22 = D1^2K+D1^2-D1Kb+2K^2+K
 *
 * By construction A'P_poly + P_poly A = -2K(b-D1)(D1 b-K) * I = -LCD*I,
 * and LCD = 2K(D1-b)(K-D1 b) > 0 on the Routh region. So V=x'P_poly x has
 * V' = -LCD*||x||^2 < 0 on ALL of Level C, and P_poly>0 there (its leading
 * minors M1,M2,M3 are positive on Routh).
 *
 * THEOREM (proved here): for ALL D1,b,K with D1>b AND K>D1 b, the three
 * leading principal minors of P_poly are positive (=> V>0), establishing a
 * clean polynomial Lyapunov function valid up to the TRUE boundary.
 * (V'<0 is the algebraic identity A'P+PA=-LCD*I with LCD>0, immediate.)
 *
 * LESSON: "clean closed form vs reaching the boundary" is NOT a dichotomy.
 * The real cap is on pH-STRUCTURED certificates (V=H+sin-corrections), which
 * stop at Level B (~0.89 for D1=K=1). A general clean polynomial certificate
 * reaches Level C. The earlier "must be messy" conclusion was wrong: the
 * boundary degeneration is in V'-margin (the scalar LCD->0), not in P.
 *
 * SCOPE: linearized (local) stability. Nonlinear domain is separate.
 */

ProgramVariables
  Real D1;
  Real b;
  Real K;
End.

Problem
  \forall D1 \forall b \forall K (
    ( D1 > 0 & b > 0 & K > 0 & D1 > b & K > D1*b )
    ->
    (   /* M1 > 0 */
        D1^2*K^2+D1^2*K+D1^2*b^2-D1*K*b+2*K^3+K^2*b^2+2*K^2+K*b^2 > 0
      & /* M2 = det top-left 2x2 of P_poly > 0 */
        (D1^2*K^2+D1^2*K+D1^2*b^2-D1*K*b+2*K^3+K^2*b^2+2*K^2+K*b^2)
          *(-D1*K*b+2*K^2+K*b^2+K+b^2)
        - (D1*K^2+D1*K+D1*b^2+K^2*b)^2 > 0
      & /* M3 = det P_poly > 0 */
        (D1^2*K^2+D1^2*K+D1^2*b^2-D1*K*b+2*K^3+K^2*b^2+2*K^2+K*b^2)
          *((-D1*K*b+2*K^2+K*b^2+K+b^2)*(D1^2*K+D1^2-D1*K*b+2*K^2+K)-(D1*b-K)^2)
        - (D1*K^2+D1*K+D1*b^2+K^2*b)
          *((D1*K^2+D1*K+D1*b^2+K^2*b)*(D1^2*K+D1^2-D1*K*b+2*K^2+K)-(D1*b-K)*(D1^2*b+D1*K^2+K^2*b+K*b))
        + (D1^2*b+D1*K^2+K^2*b+K*b)
          *((D1*K^2+D1*K+D1*b^2+K^2*b)*(D1*b-K)-(-D1*K*b+2*K^2+K*b^2+K+b^2)*(D1^2*b+D1*K^2+K^2*b+K*b)) > 0 ) )
End.

Tactic "Proof"
  QE
End.

End.
