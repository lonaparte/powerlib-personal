ArchiveEntry "3-Machine component-wise eps-delta Lyapunov stability (parametric in D1,D2,D3,K)"

/*
 * KeYmaera X STATUS: PROVED (qed=1). 3-machine analog of
 * lyapunov_complete_parametric. Component-wise eps-delta stability of the
 * passive line, ALL D1,D2,D3,K>0. Witness delta = eps/(4K+3):
 * from the box {w_i^2<delta (i=1,2,3), 1-c_j<delta (j=1,2)} the energy is
 *   H = w1^2+w2^2+w3^2+2K(1-c1)+2K(1-c2) < 3*delta + 4K*delta = (4K+3)*delta = eps,
 * H is invariant (dH/dt<=0), so each nonnegative energy component stays < eps.
 * Conclusion uses the parameter-correct energy components 2K(1-c_j)<eps (the
 * "1-c_j<eps" form is only valid for K>=1/2; cf. component_stability_parametric).
 *
 * Proof technique (two ingredients, both essential under the Z3-only backend):
 *  1. DIVISION-FREE witness. Instead of existsR("eps/(4K+3)") -- which injects a
 *     quotient into every downstream QE, and Z3's division axioms are crippled
 *     here (19 derived-axiom failures) -- we cut an existential
 *       \exists xd (xd>0 & (4K+3)*xd = eps)
 *     and instantiate delta:=xd. Every heavy QE then sees only the LINEAR
 *     relation (4K+3)*xd=eps, no "/".
 *  2. SPLIT post-condition. The monolithic 5-conjunction dW;QE times out (>240s);
 *     andR-splitting into five single-inequality QEs closes instantly (each is
 *     w_i^2 <= H < eps or 2K(1-c_j) <= H < eps, near-linear given H<eps).
 * The dC invariant H<eps is discharged by dI (Lie derivative of eps-H equals
 * 2(D1 w1^2+D2 w2^2+D3 w3^2) >= 0, i.e. H non-increasing). Negative control:
 * replacing the witness with the too-small (2K+1)*xd=eps makes the proof FAIL
 * (energy<eps no longer holds on the box), confirming non-vacuity. Prove ~0.3s.
 */

ProgramVariables
  Real da; Real db; Real dc;
  Real w1; Real w2; Real w3;
  Real s1; Real c1; Real s2; Real c2;
End.

Problem
  \forall D1 \forall D2 \forall D3 \forall K (
    D1 > 0 & D2 > 0 & D3 > 0 & K > 0 ->
    \forall eps (eps > 0 ->
      \exists delta (delta > 0 &
        \forall da \forall db \forall dc \forall w1 \forall w2 \forall w3 \forall s1 \forall c1 \forall s2 \forall c2 (
          s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1 &
          w1^2 < delta & w2^2 < delta & w3^2 < delta & 1 - c1 < delta & 1 - c2 < delta
          ->
          [{da' = w1, db' = w2, dc' = w3,
            w1' = -D1*w1 - K*s1,
            w2' = -D2*w2 + K*s1 - K*s2,
            w3' = -D3*w3 + K*s2,
            s1' = c1*(w1 - w2), c1' = -s1*(w1 - w2),
            s2' = c2*(w2 - w3), c2' = -s2*(w2 - w3)
            & s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1}]
          (w1^2 < eps & w2^2 < eps & w3^2 < eps & 2*K*(1-c1) < eps & 2*K*(1-c2) < eps)
        )
      )
    )
  )
End.

Tactic "Proof"
  allR(1); allR(1); allR(1); allR(1);
  implyR(1);
  allR(1);
  implyR(1);
  cut("\exists xd (xd > 0 & (4*K+3)*xd = eps)");
  <(
    existsL('Llast);
    andL('Llast);
    existsR("xd", 1);
    andR(1);
    <(
      id,
      allR(1); allR(1); allR(1); allR(1); allR(1); allR(1); allR(1); allR(1); allR(1); allR(1);
      implyR(1);
      dC("w1^2 + w2^2 + w3^2 + 2*K*(1-c1) + 2*K*(1-c2) < eps", 1);
      <(
        dW(1);
        andR(1); <(
          QE,
          andR(1); <(
            QE,
            andR(1); <(
              QE,
              andR(1); <(
                QE,
                QE
              )
            )
          )
        ),
        dI(1)
      )
    ),
    hideR(1); QE
  )
End.

End.
