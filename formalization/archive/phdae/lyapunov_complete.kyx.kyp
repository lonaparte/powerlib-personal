/*
 * Full Lyapunov stability for nonlinear two-machine pH system
 * with sin/cos coupling.
 *
 * Statement: for all eps > 0, there exists delta > 0, such that
 * if each state component is initially small (w1^2 < delta, w2^2 < delta,
 * 1-cos(delta_angle) < delta), then each state component remains small
 * (w1^2 < eps, w2^2 < eps, 1-cos < eps) for all time.
 *
 * This is component-wise Lyapunov stability, which is equivalent to
 * norm-based stability since all norms are equivalent in finite dim.
 */

Definitions
  Real K  = 1;
  Real D1 = 1;
  Real D2 = 1;
End.

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
End.

Problem
  \forall eps (eps > 0 ->
    \exists delta (delta > 0 &
      \forall d1 \forall d2 \forall w1 \forall w2 \forall s \forall c (
        s^2 + c^2 = 1 &
        w1^2 < delta & w2^2 < delta & 1 - c < delta
        ->
        [{d1' = w1,
          d2' = w2,
          w1' = -D1*w1 - K*s,
          w2' = -D2*w2 + K*s,
          s'  = c*(w1 - w2),
          c'  = -s*(w1 - w2)
          & s^2 + c^2 = 1}]
        (w1^2 < eps & w2^2 < eps & 1 - c < eps)
      )
    )
  )
End.

Tactic "Proof"
  allR(1);
  implyR(1);
  /* delta = eps/(2*K+1) ensures H(x0) < eps */
  /* H = w1^2 + w2^2 + 2*K*(1-c) < delta + delta + 2*K*delta = (2+2K)*delta */
  /* Need (2+2K)*delta <= eps, so delta = eps/(2+2K) = eps/4 for K=1 */
  existsR("eps/4", 1);
  andR(1);
  <(
    QE,
    allR(1); allR(1); allR(1); allR(1); allR(1); allR(1);
    implyR(1);
    dC("w1^2 + w2^2 + 2*K*(1 - c) < eps", 1);
    <(
      dW(1); QE,
      dI(1)
    )
  )
End.

End. """"
  tactic """" (allR(1);implyR(1);existsR("eps/4", 1);andR(1);<( QE, (allR(1);allR(1);allR(1);allR(1);allR(1);allR(1);implyR(1);dC("w1^2+w2^2+2*K()*(1-c) < eps", 1);<( (dW(1);QE), dI(1) )) )) """"
  proof """"  """"
End.
