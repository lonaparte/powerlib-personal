ArchiveEntry "Theorem: pH Lyapunov for D2<0 (D1=K=1, general d)"

/*
 * THEOREM (analytic, awaiting KeYmaera X verification):
 *
 * System: w1'=-w1-s, w2'=d*w2+s, s'=c*(w1-w2), c'=-s*(w1-w2)
 * where d = |D2| in (0, d_*) and d_* is the unique real root in (0,1) of
 *
 *   162*d^4 - 198*d^3 - 35*d^2 + 134*d - 47 = 0    (d_* ≈ 0.6594)
 *
 * Lyapunov function:
 *   V = H + h*s^2 + a1*w1*s + a2*w2*s
 *   where a1 = 1+d, a2 = 1/2+3d/2, h = 1/6+2d/3
 *
 * PROOF (structure):
 *   V' = x'*M(c)*x where M(c) is AFFINE in c.
 *   M(1) < 0 by Sylvester criterion:
 *     minor 1 = 1-d > 0
 *     minor 2 = 7(1-d)^2/16 > 0
 *     minor 3 = (1-d)*(-162d^4+198d^3+35d^2-134d+47)/288 > 0  (for d < d_*)
 *
 * The polynomial 162d^4-198d^3-35d^2+134d-47 arises from the
 * Sylvester determinant of the quadratic form M(1), with all
 * coefficients determined by the parametric choice (a1,a2,h).
 *
 * SCOPE: D1=K=1. General D1,K requires different parametric formulas.
 * The proof METHOD (affine M(c) + Sylvester) is general; the specific
 * polynomial changes with (D1,K).
 *
 * NOTE: This proves V'_lin < 0 (linearized). The nonlinear extension
 * (V' < 0 in {c >= c0}) requires additionally checking M(c0) < 0
 * and V > 0 in the domain.
 */

Definitions
  Real D2neg = 3/10;
End.

ProgramVariables
  Real d1; Real d2; Real w1; Real w2; Real s; Real c;
End.

Problem
  /* Instance: d=3/10 (within the boundary d_* ≈ 0.6594) */
  s^2 + c^2 = 1 & c >= 4/5 &
  w1^2 + w2^2 + 2*(1-c) + (1/3+2*D2neg/3)*s^2 + (1+D2neg)*w1*s + (1/2+3*D2neg/2)*w2*s < 1
  ->
  [{d1' = w1,
    d2' = w2,
    w1' = -w1 - s,
    w2' = D2neg*w2 + s,
    s'  = c*(w1 - w2),
    c'  = -s*(w1 - w2)
    & s^2 + c^2 = 1 & c >= 4/5}]
  w1^2 + w2^2 + 2*(1-c) + (1/3+2*D2neg/3)*s^2 + (1+D2neg)*w1*s + (1/2+3*D2neg/2)*w2*s < 1
End.

Tactic "Proof"
  implyR(1);
  dI(1)
End.

End.
