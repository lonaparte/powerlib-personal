ArchiveEntry "Theorem: pH Lyapunov for D2<0 (D1=K=1, closed proof)"

/*
 * THEOREM (D1=K=1), SUFFICIENT CONDITION (not tight):
 * For 0 < d=|D2| < d_*, where d_* is the unique real root in (0,1) of
 *   162*d^4 - 198*d^3 - 35*d^2 + 134*d - 47 = 0  (d_* ~ 0.6594),
 *
 * the function
 *   V = H + (1+4d)/6 * sin^2(delta) + (1+d)*w1*sin(delta) + (1+3d)/2*w2*sin(delta)
 * is a Lyapunov function for the equilibrium.
 *
 * IMPORTANT — this is a SUFFICIENT condition, NOT the tight pH boundary.
 * The parametrization a1=1+d, a2=(1+3d)/2 was chosen for clean algebra
 * (diagonals proportional to (1-d)). Optimizing a1,a2,h JOINTLY extends
 * the pH capability to d ~ 0.89 (89% of the Routh boundary, which is d<1).
 * The general formula (2*D1+3d)^2 < 16*K is likewise a sufficient condition,
 * NOT tight. The tight pH boundary (supremum over all corrections) has no
 * known clean closed form; it is determined by feasibility of the LMI
 * M(1) < 0 over the 3-parameter family.
 *
 * PROOF:
 *
 * (A) V > 0:  V = x'Px + (1-c)^2 where P = [[1,0,(1+d)/2],[0,1,(1+3d)/4],[(1+d)/2,(1+3d)/4,(7+4d)/6]].
 *     det(P) = (-39d^2-10d+41)/48 > 0 for d < (-5+2*sqrt(406))/39.
 *     V = 0 only at equilibrium.
 *
 * (B) V' = x'*M(c)*x where M(c) is AFFINE in c = cos(delta).
 *
 * (C) M(1) negative definite by Sylvester criterion:
 *     s1 = 1-d                                          > 0
 *     s2 = 7(1-d)^2/16                                  > 0
 *     s3 = (1-d)*(-162d^4+198d^3+35d^2-134d+47)/288     > 0 for d < d_*
 *
 * (D) M(c) < 0 for c in [c0, 1]: by affine interpolation, since M(1)<0 and
 *     there exists c0<1 with M(c0)<0 (by continuity of M in c).
 *
 * (E) Sublevel containment: {V < (1-c0)^2} => {c > c0},
 *     since V >= (1-c)^2 implies c > c0 when V < (1-c0)^2.
 *
 * All quantities are exact rational functions of d. No numerical fitting.
 * The polynomial 162d^4-198d^3-35d^2+134d-47 is irreducible over Q.
 *
 * INSTANCE BELOW: d = 3/10, c0 = 4/5 (V sublevel set invariance).
 */

Definitions
  Real D2neg = 3/10;
  Real h  = (1 + 4*D2neg) / 6;       /* = 11/30 */
  Real a1 = 1 + D2neg;               /* = 13/10 */
  Real a2 = (1 + 3*D2neg) / 2;       /* = 19/20 */
End.

ProgramVariables
  Real d1; Real d2; Real w1; Real w2; Real s; Real c;
End.

Problem
  s^2 + c^2 = 1 & c >= 4/5 &
  w1^2 + w2^2 + 2*(1-c) + h*s^2 + a1*w1*s + a2*w2*s < 1/25
  ->
  [{d1' = w1,
    d2' = w2,
    w1' = -w1 - s,
    w2' = D2neg*w2 + s,
    s'  = c*(w1 - w2),
    c'  = -s*(w1 - w2)
    & s^2 + c^2 = 1 & c >= 4/5}]
  w1^2 + w2^2 + 2*(1-c) + h*s^2 + a1*w1*s + a2*w2*s < 1/25
End.

Tactic "Proof"
  implyR(1);
  dI(1)
End.

End.
