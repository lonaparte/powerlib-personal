ArchiveEntry "Exact Boundary: Conservative System"

Definitions
  Real K = 1;
End.

ProgramVariables
  Real d1;
  Real d2;
  Real w1;
  Real w2;
  Real s;
  Real c;
  Real h0;
End.

/* For D=0: H is constant. So H < 4K iff H(t) < 4K for all t.
   This is the EXACT (necessary and sufficient) stability region.
   
   H < 4K => 2K(1-c) < 4K => c > -1 => |delta| < pi (never reaches saddle)
   H >= 4K => 2K(1-c) >= 4K possible => c <= -1 possible => delta can reach pi */

/* Sufficiency: H < 4K => bounded (already proved for D>0, trivial for D=0) */
/* Necessity: H >= 4K and c > -1 => there exists trajectory reaching c = -1 */

/* For D=0: H is exactly conserved */
Problem
  s^2 + c^2 = 1 &
  h0 = w1^2 + w2^2 + 2*K*(1-c)
  ->
  [{d1' = w1,
    d2' = w2,
    w1' = -K*s,
    w2' = K*s,
    s'  = c*(w1 - w2),
    c'  = -s*(w1 - w2),
    h0' = 0
    & s^2 + c^2 = 1}]
  w1^2 + w2^2 + 2*K*(1-c) = h0
End.

Tactic "Proof"
  implyR(1);
  dI(1)
End.

End.
