ArchiveEntry "3-Machine saddle instability (D=0): above-barrier set {H>4K} is invariant"

/*
 * Necessity / instability side, 3-machine analog of saddle_instability_parametric.
 * With zero damping (D1=D2=D3=0) the Hamiltonian H = sum wi^2 + 2K(1-c1) + 2K(1-c2)
 * is conserved (conservative_3machine). Hence the COMPLEMENT of the stability
 * region, {H > 4K}, is positively invariant: a trajectory that starts above the
 * lowest escape barrier (one bond pushed toward pi, energy 4K) can never return
 * into the synchronized well {H < 4K}. This certifies that points above the
 * barrier do not get attracted to the in-phase equilibrium -- the large-signal
 * instability statement dual to stability_boundary_3machine.
 *
 * Proof: H is conserved (H'=0 under D=0), so (H-4K)'=0>=0, dI closes {H>4K}.
 * Cross-check: same energy as stability_boundary_3machine; 4K = saddle barrier
 * (one bond at pi), numerically verified earlier.
 */

ProgramVariables
  Real da; Real db; Real dc;
  Real w1; Real w2; Real w3;
  Real s1; Real c1; Real s2; Real c2;
End.

Problem
  \forall K (
    K > 0 &
    s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1 &
    w1^2 + w2^2 + w3^2 + 2*K*(1-c1) + 2*K*(1-c2) > 4*K
    ->
    [{da' = w1, db' = w2, dc' = w3,
      w1' = 0*w1 - K*s1,
      w2' = 0*w2 + K*s1 - K*s2,
      w3' = 0*w3 + K*s2,
      s1' = c1*(w1 - w2), c1' = -s1*(w1 - w2),
      s2' = c2*(w2 - w3), c2' = -s2*(w2 - w3)
      & s1^2 + c1^2 = 1 & s2^2 + c2^2 = 1}]
    w1^2 + w2^2 + w3^2 + 2*K*(1-c1) + 2*K*(1-c2) > 4*K
  )
End.

Tactic "Proof"
  allR(1); implyR(1); dI(1)
End.

End.
